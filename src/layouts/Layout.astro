---
import '../styles/global.css';
import '../styles/pages.css';
import { ClientRouter } from 'astro:transitions';
interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = "Reference — Supersonic Creative Studio",
  description = "Reference is a supersonic creative studio. We make bold, entertainment-led work for brands who want to win.",
  image = "/images/og.webp",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();

const pathname = Astro.url.pathname;
// Determine current page slug for body data-page and active nav
function getPageSlug(path: string): string {
  if (path === '/' || path === '') return 'home';
  const slug = path.replace(/^\//, '').replace(/\/$/, '');
  return slug || 'home';
}
const currentPage = getPageSlug(pathname);

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Reference" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Reference",
      "url": "https://reference.studio",
      "logo": "https://reference.studio/brand/reference-logo.svg",
      "description": "Reference is a supersonic creative studio. We make bold, entertainment-led work for brands who want to win.",
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "areaServed": "Worldwide"
      }
    })} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Press+Start+2P&display=swap" rel="stylesheet" />

    <style is:global>
      *, *::before, *::after { cursor: none !important; }

      /* Disable Astro's default view-transition crossfade — our overlay handles it */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
        mix-blend-mode: normal;
      }
    </style>

    <style>
      @font-face {
        font-family: "TrashHand";
        src: url("/fonts/TrashHand.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "ObviouslyWide";
        src: url("/fonts/ObviouslyWide-Regular.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "ObviouslyWide";
        src: url("/fonts/ObviouslyWide-Medium.woff2") format("woff2");
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "ObviouslyWide";
        src: url("/fonts/ObviouslyWide-Bold.woff2") format("woff2");
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      :root {
        color-scheme: dark;
      }

      html {
        scroll-behavior: auto;
        overflow-x: hidden;
      }

      body {
        margin: 0;
        background: #0a0a0a;
        color: #e8e4de;
        font-family: "ObviouslyWide", system-ui, -apple-system, sans-serif;
        overflow-x: hidden;
        cursor: none;
      }

      h1, h2, h3, p {
        margin: 0;
      }

      /* Grain overlay — fixed, covers entire viewport */
      .grain {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 9000;
        pointer-events: none;
        opacity: 0.08;
      }


      /* Brand mark */
      .brand-mark {
        position: fixed;
        bottom: 24px;
        left: 24px;
        z-index: 8000;
        display: block;
        height: 32px;
        width: 32px;
        opacity: 1;
        pointer-events: none; /* always none — hover/click handled in JS */
        transition: width 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .brand-mark__symbol,
      .brand-mark__logo {
        position: absolute;
        top: 0;
        left: 0;
        background-size: contain;
        background-repeat: no-repeat;
        background-position: left center;
        pointer-events: none;
        transition: opacity 0.25s ease, filter 0.3s ease;
        /* Convert to white for dark-background sections */
        filter: brightness(0) invert(1);
      }

      .brand-mark__symbol {
        width: 32px;
        height: 32px;
        background-image: url('/brand/reference-symbol.svg');
      }

      .brand-mark__logo {
        width: 160px;
        height: 36px;
        background-image: url('/brand/reference-logo.svg');
        opacity: 0;
        clip-path: inset(0 100% 8% 0);
        transition: opacity 0s, filter 0.3s ease;
      }


      /* Inherit currentColor per section */
      .brand-mark { color: #e8e4de; }
      .brand-mark--on-light { color: #1a1a1a; }

      /* Dark mode — off-white section */
      .brand-mark--on-light .brand-mark__symbol,
      .brand-mark--on-light .brand-mark__logo {
        filter: brightness(0);
      }

      /* ── Top nav bar ── */
      .nav-bar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 8000;
        display: flex;
        justify-content: space-between;
        padding: 20px 24px;
      }

      .nav-tab {
        font-family: "ObviouslyWide", system-ui, sans-serif;
        font-size: 9px;
        font-weight: 400;
        letter-spacing: 0.22em;
        color: rgba(232, 228, 222, 0.55);
        background: none;
        border: none;
        padding: 6px 0 4px;
        cursor: none;
        transition: color 0.2s ease;
        text-transform: uppercase;
        line-height: 1;
        text-decoration: none;
        display: inline-block;
      }

      .nav-tab:hover,
      .nav-tab.is-active {
        color: rgba(232, 228, 222, 0.9);
      }

      .nav-tab--on-light {
        color: rgba(26, 26, 26, 0.5);
      }

      .nav-tab--on-light:hover,
      .nav-tab--on-light.is-active {
        color: rgba(26, 26, 26, 0.9);
      }

      /* ── Burger button — mobile only ── */
      .burger-btn {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        background: none;
        border: none;
        padding: 4px;
        cursor: pointer;
        z-index: 9100;
      }

      .burger-bar {
        display: block;
        width: 22px;
        height: 2.5px;
        background: rgba(232, 228, 222, 0.85);
        border-radius: 1px;
        transition: background 0.2s ease,
                    transform  0.3s cubic-bezier(0.16, 1, 0.3, 1),
                    opacity    0.3s ease;
        transform-origin: center;
      }

      .burger-btn--on-light .burger-bar {
        background: rgba(26, 26, 26, 0.85);
      }

      /* ── Mobile full-screen overlay ── */
      .mobile-menu {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9000;
        background: #0d0d0d;
        flex-direction: column;
        justify-content: center;
        padding: 0 40px;
        opacity: 0;
        transition: opacity 0.38s cubic-bezier(0.16, 1, 0.3, 1);
        pointer-events: none;
        overflow: hidden;
      }

      .mobile-menu.is-open {
        opacity: 1;
        pointer-events: all;
      }

      /* Keep brand mark visible above the menu overlay */
      body.burger-open #brand-mark {
        z-index: 9500;
        color: #e8e4de !important;
      }

      /* X close button inside overlay */
      .mobile-menu__close {
        position: absolute;
        top: 20px;
        right: 24px;
        background: none;
        border: none;
        padding: 6px;
        cursor: pointer;
        color: rgba(232, 228, 222, 0.5);
        transition: color 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .mobile-menu__close:hover { color: #e8e4de; }

      .mobile-menu__nav {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0;
        width: 100%;
      }

      .mobile-menu__link {
        font-family: "ObviouslyWide", system-ui, sans-serif;
        font-size: 24px;
        font-weight: 400;
        letter-spacing: 0.06em;
        color: #e8e4de;
        text-decoration: none;
        text-transform: uppercase;
        opacity: 0;
        transform: translateX(-32px);
        transition: color 0.2s ease;
        width: 100%;
        padding: 20px 0;
        border-bottom: 1px solid rgba(232, 228, 222, 0.12);
      }

      .mobile-menu__nav .mobile-menu__link:first-child {
        border-top: 1px solid rgba(232, 228, 222, 0.12);
      }

      .mobile-menu__link.is-active {
        color: #986edf;
      }

      /* Staggered slide-in when menu opens */
      .mobile-menu.is-open .mobile-menu__link {
        animation: menuLinkIn 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
      .mobile-menu.is-open .mobile-menu__link:nth-child(1) { animation-delay: 0.06s; }
      .mobile-menu.is-open .mobile-menu__link:nth-child(2) { animation-delay: 0.12s; }
      .mobile-menu.is-open .mobile-menu__link:nth-child(3) { animation-delay: 0.18s; }
      .mobile-menu.is-open .mobile-menu__link:nth-child(4) { animation-delay: 0.24s; }
      .mobile-menu.is-open .mobile-menu__link:nth-child(5) { animation-delay: 0.30s; }

      /* Staggered slide-out when closing */
      .mobile-menu.is-closing .mobile-menu__link {
        animation: menuLinkOut 0.3s cubic-bezier(0.4, 0, 1, 1) forwards;
        opacity: 1;
        transform: translateX(0);
      }
      .mobile-menu.is-closing .mobile-menu__link:nth-child(5) { animation-delay: 0.00s; }
      .mobile-menu.is-closing .mobile-menu__link:nth-child(4) { animation-delay: 0.05s; }
      .mobile-menu.is-closing .mobile-menu__link:nth-child(3) { animation-delay: 0.10s; }
      .mobile-menu.is-closing .mobile-menu__link:nth-child(2) { animation-delay: 0.15s; }
      .mobile-menu.is-closing .mobile-menu__link:nth-child(1) { animation-delay: 0.20s; }

      @keyframes menuLinkIn {
        from { opacity: 0; transform: translateX(-32px); }
        to   { opacity: 1; transform: translateX(0); }
      }

      @keyframes menuLinkOut {
        from { opacity: 1; transform: translateX(0); }
        to   { opacity: 0; transform: translateX(-24px); }
      }

      @media (max-width: 640px) {
        .nav-tab {
          display: none;
        }
        .burger-btn {
          display: flex;
        }
        .mobile-menu {
          display: flex;
        }
        .music-toggle {
          font-size: 7px;
          letter-spacing: 0.15em;
        }
      }

      /* Custom cursor dot */
      .cursor-dot {
        position: fixed;
        top: 0;
        left: 0;
        width: 8px;
        height: 8px;
        background: #7040c0;
        border-radius: 50%;
        pointer-events: none;
        z-index: 9999;
        will-change: transform;
        opacity: 0;
        transition: opacity 0.2s ease;
      }

      /* Music toggle */
      .music-toggle {
        position: fixed;
        right: 20px;
        bottom: 24px;
        z-index: 8000;
        background: none;
        border: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        font-family: "ObviouslyWide", system-ui, sans-serif;
        font-size: 9px;
        font-weight: 400;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(232, 228, 222, 0.35);
        transition: color 0.25s ease;
        cursor: pointer;
      }

      .music-toggle__icon {
        width: 16px;
        height: 16px;
        color: inherit;
        flex-shrink: 0;
      }

      .music-toggle:hover {
        color: rgba(232, 228, 222, 0.8);
      }

      .music-toggle__dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: currentColor;
        flex-shrink: 0;
        transition: background 0.25s ease;
      }

      .music-toggle.is-playing {
        color: rgba(232, 228, 222, 0.6);
      }

      .music-toggle.is-playing .music-toggle__dot {
        background: #986edf;
        animation: dot-pulse 2s ease-in-out infinite;
      }

      @keyframes dot-pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%       { opacity: 0.4; transform: scale(0.65); }
      }

      .music-toggle--on-light {
        color: rgba(26, 26, 26, 0.45);
      }

      .music-toggle--on-light:hover {
        color: rgba(26, 26, 26, 0.8);
      }

      .music-toggle--on-light.is-playing {
        color: rgba(26, 26, 26, 0.6);
      }

      /* Hide music toggle on work page */
      body[data-page="work"] #music-toggle {
        display: none;
      }

      /* ── Page transition overlay ── */
      .pt-overlay {
        position: fixed;
        inset: 0;
        z-index: 99999;
        background: #986edf;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        will-change: transform;
        /* hidden off-screen left by default */
        transform: translateX(-100%);
      }

      .pt-overlay__icon {
        width: clamp(28px, 3.5vw, 52px);
        height: auto;
        filter: brightness(0) invert(1) brightness(0.92) sepia(0.12);
        opacity: 0;
        transition: opacity 0.25s ease;
      }
    </style>
  </head>
  <body data-page={currentPage}>
    <!-- Page transition overlay — persists across navigations so WAAPI state is retained -->
    <div class="pt-overlay" id="pt-overlay" aria-hidden="true" transition:persist>
      <img class="pt-overlay__icon" src="/brand/reference-symbol.svg" alt="" />
    </div>

    <!-- Brand mark — top left, hidden until past hero -->
    <div class="brand-mark" id="brand-mark" role="button" aria-label="Back to top" transition:persist>
      <div class="brand-mark__symbol"></div>
      <div class="brand-mark__logo"></div>
    </div>

    <!-- Top nav tabs -->
    <nav class="nav-bar" id="nav-bar" transition:persist>
      <a href="/" class={`nav-tab${isActive('/') ? ' is-active' : ''}`}>HOME</a>
      <a href="/industry" class={`nav-tab${isActive('/industry') ? ' is-active' : ''}`}>INDUSTRY</a>
      <a href="/about" class={`nav-tab${isActive('/about') ? ' is-active' : ''}`}>ABOUT</a>
      <a href="/work" class={`nav-tab${isActive('/work') ? ' is-active' : ''}`}>WORK</a>
      <a href="/contact" class={`nav-tab${isActive('/contact') ? ' is-active' : ''}`}>CONTACT</a>
      <button class="burger-btn" id="burger-btn" aria-label="Open menu" aria-expanded="false">
        <span class="burger-bar"></span>
        <span class="burger-bar"></span>
        <span class="burger-bar"></span>
      </button>
    </nav>

    <!-- Mobile full-screen menu -->
    <div class="mobile-menu" id="mobile-menu" aria-hidden="true" transition:persist>
      <button class="mobile-menu__close" id="mobile-menu-close" aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <line x1="2" y1="2" x2="18" y2="18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="18" y1="2" x2="2" y2="18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
      <nav class="mobile-menu__nav">
        <a class="mobile-menu__link" href="/">HOME</a>
        <a class="mobile-menu__link" href="/industry">INDUSTRY</a>
        <a class="mobile-menu__link" href="/about">ABOUT</a>
        <a class="mobile-menu__link" href="/work">WORK</a>
        <a class="mobile-menu__link" href="/contact">CONTACT</a>
      </nav>
    </div>

    <!-- Grain texture — feTurbulence fractalNoise -->
    <svg class="grain" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <filter id="grain-filter" x="0%" y="0%" width="100%" height="100%">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.68"
          numOctaves="3"
          stitchTiles="stitch"
        />
        <feColorMatrix type="saturate" values="0" />
      </filter>
      <rect width="100%" height="100%" filter="url(#grain-filter)" />
    </svg>

    <slot />

    <div class="cursor-dot" id="cursor-dot" transition:persist></div>

    <!-- Background music -->
    <audio id="bg-music" loop preload="none" transition:persist>
      <source src="/audio/website-audio.ogg" type="audio/ogg" />
    </audio>

    <button class="music-toggle" id="music-toggle" aria-label="Toggle music" transition:persist>
      <svg class="music-toggle__icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M9 18V6l12-2v12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="1.5"/>
        <circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.5"/>
      </svg>
      <span class="music-toggle__text">OFF</span>
    </button>

    <script>
      // ── Smooth scroll (non-Safari fine pointer devices only) ──
      const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);
      if (!isSafari && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
        let currentY = window.scrollY;
        let velocity = 0;

        window.addEventListener("wheel", (e) => {
          e.preventDefault();
          if ((window as any).__scrollLocked) { velocity = 0; return; }
          currentY = window.scrollY; // re-sync in case position changed externally
          let delta = e.deltaY;
          if (e.deltaMode === 1) delta *= 28;
          if (e.deltaMode === 2) delta *= window.innerHeight;
          velocity += delta * 0.14;              // dampen input heavily
        }, { passive: false });

        (function tick() {
          if ((window as any).__scrollLocked) {
            velocity = 0;                             // drain any queued velocity
            currentY = window.scrollY;                // stay in sync
          } else {
            velocity *= 0.80;                         // decay — eases out quickly
            if (Math.abs(velocity) > 0.1) {
              const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
              currentY = Math.max(0, Math.min(currentY + velocity, maxScroll));
              window.scrollTo(0, currentY);
            } else {
              velocity = 0;
            }
          }
          requestAnimationFrame(tick);
        })();

        // Reset scroll state on navigation
        document.addEventListener('astro:after-swap', () => {
          currentY = 0;
          velocity = 0;
        });
      }

      const dot = document.getElementById("cursor-dot") as HTMLElement;
      const R = 4; // half of 8px dot
      let mx = 0, my = 0;
      let cx = 0, cy = 0;
      let visible = false;

      document.addEventListener("mousemove", (e) => {
        mx = e.clientX;
        my = e.clientY;
        if (!visible) {
          // Snap to position on first move so it doesn't slide in from (0,0)
          cx = mx; cy = my;
          visible = true;
        }
        dot.style.opacity = "1";
      });

      (function animate() {
        cx += (mx - cx) * 0.18;
        cy += (my - cy) * 0.18;
        dot.style.transform = `translate(${cx - R}px, ${cy - R}px)`;
        requestAnimationFrame(animate);
      })();

      // ── Brand mark: hover + click via coordinate tracking (pointer-events stays none) ──
      const brandMark     = document.getElementById("brand-mark") as HTMLElement;
      const navTabEls     = Array.from(document.querySelectorAll<HTMLElement>(".nav-tab"));
      let updateBrandMark     = () => {};
      let updateMusicToggleColor = () => {};

      if (brandMark) {

        // IDs of fixed UI overlays that should not influence background detection
        const BG_SKIP_IDS = new Set([
          'brand-mark', 'cursor-dot', 'music-toggle', 'nav-bar',
          'pt-overlay', 'bigger-aim-cursor', 'bigger-shoot-cursor', 'bigger-gun', 'mobile-menu',
        ]);

        function getBgLuminanceAt(x: number, y: number): number {
          // Use elementsFromPoint (all elements top→bottom) so we never miss the
          // page background even when fixed overlays haven't been hidden yet.
          const stack = document.elementsFromPoint(x, y) as HTMLElement[];

          for (const candidate of stack) {
            // Skip any element that is (or lives inside) a UI overlay
            let inOverlay = false;
            let cur: HTMLElement | null = candidate;
            while (cur && cur !== document.body) {
              if (cur.id && BG_SKIP_IDS.has(cur.id)) { inOverlay = true; break; }
              cur = cur.parentElement;
            }
            if (inOverlay) continue;

            // Walk up this candidate's ancestors looking for a solid background
            let probe: HTMLElement | null = candidate;
            while (probe && probe !== document.body) {
              const bg = getComputedStyle(probe).backgroundColor;
              const m  = bg.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
              if (m) {
                const [r, g, b] = [+m[1], +m[2], +m[3]];
                if (r + g + b > 0) {
                  return (0.299 * r + 0.587 * g + 0.114 * b) / 255;
                }
              }
              probe = probe.parentElement;
            }
          }
          return 0; // default dark
        }

        updateBrandMark = function() {
          const bmR = brandMark.getBoundingClientRect();
          const onLightBm = getBgLuminanceAt(bmR.left + 16, bmR.top + 16) > 0.5;
          brandMark.classList.toggle("brand-mark--on-light", onLightBm);
          navTabEls.forEach((t) => {
            const r = t.getBoundingClientRect();
            const onLight = getBgLuminanceAt(r.left + r.width / 2, r.top + r.height / 2) > 0.5;
            t.classList.toggle("nav-tab--on-light", onLight);
          });
          // Burger button colour follows the right edge of the nav bar
          const burgerEl = document.getElementById('burger-btn');
          if (burgerEl) {
            const br = burgerEl.getBoundingClientRect();
            const onLight = getBgLuminanceAt(br.left + br.width / 2, br.top + br.height / 2) > 0.5;
            burgerEl.classList.toggle('burger-btn--on-light', onLight);
          }
        };
        window.addEventListener("scroll", updateBrandMark, { passive: true });
        updateBrandMark();

        // Click: scroll to top if click lands within brand mark bounds
        document.addEventListener("click", (e) => {
          const r = brandMark.getBoundingClientRect();
          if (e.clientX >= r.left && e.clientX <= r.right &&
              e.clientY >= r.top  && e.clientY <= r.bottom) {
            window.scrollTo({ top: 0, behavior: "smooth" });
          }
        });
      }

      // ── Music toggle ──
      const music       = document.getElementById("bg-music") as HTMLAudioElement;
      const musicToggle = document.getElementById("music-toggle") as HTMLButtonElement;

      if (music && musicToggle) {
        const musicToggleText = musicToggle.querySelector(".music-toggle__text") as HTMLElement;

        updateMusicToggleColor = function() {
          const tr = musicToggle.getBoundingClientRect();
          const cx = tr.left + tr.width / 2;
          const cy = tr.top  + tr.height / 2;
          musicToggle.style.visibility = "hidden";
          let el = document.elementFromPoint(cx, cy) as HTMLElement | null;
          musicToggle.style.visibility = "";
          let lum = 0;
          while (el && el !== document.body) {
            const bg = getComputedStyle(el).backgroundColor;
            const m  = bg.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
            if (m) {
              const [r, g, b] = [+m[1], +m[2], +m[3]];
              if (r + g + b > 0) { lum = (0.299 * r + 0.587 * g + 0.114 * b) / 255; break; }
            }
            el = el.parentElement;
          }
          musicToggle.classList.toggle("music-toggle--on-light", lum > 0.5);
        };
        window.addEventListener("scroll", updateMusicToggleColor, { passive: true });
        updateMusicToggleColor();

        function startMusic() {
          music.play().then(() => {
            musicToggle.classList.add("is-playing");
            if (musicToggleText) musicToggleText.textContent = "ON";
          }).catch(() => {});
        }

        musicToggle.addEventListener("click", (e) => {
          e.stopPropagation();
          if (music.paused) {
            startMusic();
          } else {
            music.pause();
            musicToggle.classList.remove("is-playing");
            if (musicToggleText) musicToggleText.textContent = "OFF";
          }
        });
      }

      // ── Page transitions (Astro ClientRouter — no navigation boundary, no flicker) ──
      const ptOverlay = document.getElementById('pt-overlay') as HTMLElement;
      const ptIcon    = ptOverlay?.querySelector<HTMLElement>('.pt-overlay__icon');
      const SLIDE_DUR = 600;
      const EASE      = 'cubic-bezier(0.65, 0, 0.35, 1)';

      if (ptOverlay) {
        // Before page fetch: slide overlay in from left, parallel with the fetch
        document.addEventListener('astro:before-preparation', (e: any) => {
          const originalLoader = e.loader;
          e.loader = async () => {
            if (ptIcon) ptIcon.style.opacity = '0';
            ptOverlay.style.transform = '';
            ptOverlay.getAnimations().forEach(a => a.cancel());
            ptOverlay.style.transform = 'translateX(-100%)'; // pin start position
            const anim = ptOverlay.animate(
              [{ transform: 'translateX(-100%)' }, { transform: 'translateX(0)' }],
              { duration: SLIDE_DUR, easing: EASE, fill: 'none' }
            );
            // Hold position after animation with inline style (no fill needed)
            anim.onfinish = () => { ptOverlay.style.transform = 'translateX(0)'; };
            setTimeout(() => { if (ptIcon) ptIcon.style.opacity = '1'; }, Math.round(SLIDE_DUR * 0.45));
            // Wait for BOTH animation AND fetch before swapping DOM
            await Promise.all([
              new Promise<void>(res => { anim.addEventListener('finish', () => res(), { once: true }); }),
              originalLoader(),
            ]);
          };
        });

        // After DOM swap: slide overlay out to reveal new page
        document.addEventListener('astro:after-swap', () => {
          // Update body data-page so CSS selectors (e.g. hide music on work) work
          const path = window.location.pathname;
          const slug = path === '/' ? 'home' : (path.replace(/^\//, '').replace(/\/$/, '') || 'home');
          document.body.setAttribute('data-page', slug);

          // Update nav active state (nav persists via transition:persist)
          document.querySelectorAll<HTMLAnchorElement>('.nav-tab').forEach(tab => {
            const href = tab.getAttribute('href') ?? '';
            const active = href === '/' ? path === '/' : path.startsWith(href);
            tab.classList.toggle('is-active', active);
          });

          // Re-check brand mark / nav luminance for new page background
          updateBrandMark();
          updateMusicToggleColor();

          // Slide overlay out — cancel any lingering exit-animation fills first
          if (ptIcon) ptIcon.style.opacity = '0';
          setTimeout(() => {
            ptOverlay.getAnimations().forEach(a => a.cancel());
            ptOverlay.style.transform = 'translateX(0)'; // pin position before animating
            const anim = ptOverlay.animate(
              [{ transform: 'translateX(0)' }, { transform: 'translateX(100%)' }],
              { duration: SLIDE_DUR, easing: EASE, fill: 'none' }
            );
            anim.onfinish = () => {
              ptOverlay.style.transform = 'translateX(-100%)';
            };
          }, 300);
        });
      }

      // Re-check nav colours once per navigation (catches direct-load cases)
      document.addEventListener('astro:page-load', () => {
        updateBrandMark();
        updateMusicToggleColor();

        // ── Mobile burger menu ──
        const burgerBtn   = document.getElementById('burger-btn') as HTMLButtonElement | null;
        const mobileMenu  = document.getElementById('mobile-menu') as HTMLElement | null;
        const closeBtn    = document.getElementById('mobile-menu-close') as HTMLButtonElement | null;
        if (!burgerBtn || !mobileMenu) return;

        // Sync active state on mobile links
        const path = window.location.pathname;
        mobileMenu.querySelectorAll<HTMLAnchorElement>('.mobile-menu__link').forEach(link => {
          const href = link.getAttribute('href') ?? '';
          const active = href === '/' ? path === '/' : path.startsWith(href);
          link.classList.toggle('is-active', active);
        });

        function openMenu() {
          mobileMenu!.classList.remove('is-closing');
          mobileMenu!.classList.add('is-open');
          mobileMenu!.setAttribute('aria-hidden', 'false');
          burgerBtn!.classList.add('is-open');
          burgerBtn!.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
          document.body.classList.add('burger-open');
        }

        const CLOSE_DUR = 380; // ms — matches closing animation total

        function closeMenu(): Promise<void> {
          return new Promise(resolve => {
            mobileMenu!.classList.add('is-closing');
            mobileMenu!.classList.remove('is-open');
            mobileMenu!.setAttribute('aria-hidden', 'true');
            burgerBtn!.classList.remove('is-open');
            burgerBtn!.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
            document.body.classList.remove('burger-open');
            setTimeout(() => {
              mobileMenu!.classList.remove('is-closing');
              resolve();
            }, CLOSE_DUR);
          });
        }

        burgerBtn.onclick = () => {
          burgerBtn.classList.contains('is-open') ? closeMenu() : openMenu();
        };

        if (closeBtn) closeBtn.onclick = () => closeMenu();

        mobileMenu.querySelectorAll<HTMLAnchorElement>('.mobile-menu__link').forEach(link => {
          link.onclick = (e) => {
            e.preventDefault();
            const href = link.getAttribute('href') ?? '/';
            closeMenu().then(() => {
              import('astro:transitions/client').then(({ navigate }) => navigate(href));
            });
          };
        });
      });

      // Safety: ensure menu is fully closed if navigation fires unexpectedly
      document.addEventListener('astro:after-swap', () => {
        const mobileMenu = document.getElementById('mobile-menu') as HTMLElement | null;
        const burgerBtn  = document.getElementById('burger-btn') as HTMLButtonElement | null;
        mobileMenu?.classList.remove('is-open', 'is-closing');
        mobileMenu?.setAttribute('aria-hidden', 'true');
        burgerBtn?.classList.remove('is-open');
        document.body.style.overflow = '';
        document.body.classList.remove('burger-open');
      });
    </script>
  </body>
</html>
