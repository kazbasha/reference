---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Reference",
  description = "Reference — Supersonic creative.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet" />

    <style is:global>
      *, *::before, *::after { cursor: none !important; }
    </style>

    <style>
      @font-face {
        font-family: "TrashHand";
        src: url("/fonts/TrashHand.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "ObviouslyWide";
        src: url("/fonts/ObviouslyWide-Regular.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "ObviouslyWide";
        src: url("/fonts/ObviouslyWide-Medium.woff2") format("woff2");
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "ObviouslyWide";
        src: url("/fonts/ObviouslyWide-Bold.woff2") format("woff2");
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      :root {
        color-scheme: dark;
      }

      html {
        scroll-behavior: auto;
        overflow-x: hidden;
      }

      body {
        margin: 0;
        background: #0a0a0a;
        color: #e8e4de;
        font-family: "ObviouslyWide", system-ui, -apple-system, sans-serif;
        overflow-x: hidden;
        cursor: none;
      }

      h1, h2, h3, p {
        margin: 0;
      }

      /* Grain overlay — fixed, covers entire viewport */
      .grain {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 9000;
        pointer-events: none;
        opacity: 0.08;
      }


      /* Brand mark */
      .brand-mark {
        position: fixed;
        bottom: 24px;
        left: 24px;
        z-index: 8000;
        display: block;
        height: 32px;
        width: 32px;
        opacity: 1;
        pointer-events: none; /* always none — hover/click handled in JS */
        transition: width 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .brand-mark__symbol,
      .brand-mark__logo {
        position: absolute;
        top: 0;
        left: 0;
        background-size: contain;
        background-repeat: no-repeat;
        background-position: left center;
        pointer-events: none;
        transition: opacity 0.25s ease, filter 0.3s ease;
        /* Convert to white for dark-background sections */
        filter: brightness(0) invert(1);
      }

      .brand-mark__symbol {
        width: 32px;
        height: 32px;
        background-image: url('/brand/reference-symbol.svg');
      }

      .brand-mark__logo {
        width: 160px;
        height: 36px;
        background-image: url('/brand/reference-logo.svg');
        opacity: 0;
        clip-path: inset(0 100% 8% 0);
        transition: opacity 0s, filter 0.3s ease;
      }


      /* Inherit currentColor per section */
      .brand-mark { color: #e8e4de; }
      .brand-mark--on-light { color: #1a1a1a; }

      /* Dark mode — off-white section */
      .brand-mark--on-light .brand-mark__symbol,
      .brand-mark--on-light .brand-mark__logo {
        filter: brightness(0);
      }

      /* ── Top nav bar ── */
      .nav-bar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 8000;
        display: flex;
        justify-content: space-between;
        padding: 20px 24px;
      }

      .nav-tab {
        font-family: "ObviouslyWide", system-ui, sans-serif;
        font-size: 9px;
        font-weight: 400;
        letter-spacing: 0.22em;
        color: rgba(232, 228, 222, 0.55);
        background: none;
        border: none;
        padding: 6px 0 4px;
        cursor: none;
        transition: color 0.2s ease;
        text-transform: uppercase;
        line-height: 1;
      }

      .nav-tab:hover,
      .nav-tab.is-active {
        color: rgba(232, 228, 222, 0.9);
      }

      .nav-tab--on-light {
        color: rgba(26, 26, 26, 0.5);
      }

      .nav-tab--on-light:hover,
      .nav-tab--on-light.is-active {
        color: rgba(26, 26, 26, 0.9);
      }

      @media (max-width: 640px) {
        .nav-tab {
          font-size: 7px;
          letter-spacing: 0.15em;
        }
        .music-toggle {
          font-size: 7px;
          letter-spacing: 0.15em;
        }
      }

      /* Custom cursor dot */
      .cursor-dot {
        position: fixed;
        top: 0;
        left: 0;
        width: 8px;
        height: 8px;
        background: #7040c0;
        border-radius: 50%;
        pointer-events: none;
        z-index: 9999;
        will-change: transform;
        opacity: 0;
        transition: opacity 0.2s ease;
      }

      /* Music toggle */
      .music-toggle {
        position: fixed;
        right: 20px;
        bottom: 24px;
        z-index: 8000;
        background: none;
        border: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 7px;
        font-family: "ObviouslyWide", system-ui, sans-serif;
        font-size: 9px;
        font-weight: 400;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(232, 228, 222, 0.35);
        writing-mode: vertical-rl;
        transition: color 0.25s ease;
      }

      .music-toggle:hover {
        color: rgba(232, 228, 222, 0.8);
      }

      .music-toggle__dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: currentColor;
        flex-shrink: 0;
        transition: background 0.25s ease;
      }

      .music-toggle.is-playing {
        color: rgba(232, 228, 222, 0.6);
      }

      .music-toggle.is-playing .music-toggle__dot {
        background: #986edf;
        animation: dot-pulse 2s ease-in-out infinite;
      }

      @keyframes dot-pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%       { opacity: 0.4; transform: scale(0.65); }
      }

      .music-toggle--on-light {
        color: rgba(26, 26, 26, 0.45);
      }

      .music-toggle--on-light:hover {
        color: rgba(26, 26, 26, 0.8);
      }

      .music-toggle--on-light.is-playing {
        color: rgba(26, 26, 26, 0.6);
      }
    </style>
  </head>
  <body>
    <!-- Brand mark — top left, hidden until past hero -->
    <div class="brand-mark" id="brand-mark" role="button" aria-label="Back to top">
      <div class="brand-mark__symbol"></div>
      <div class="brand-mark__logo"></div>
    </div>

    <!-- Top nav tabs -->
    <nav class="nav-bar">
      <button class="nav-tab is-active" data-tab="home">HOME</button>
      <button class="nav-tab" data-tab="industry">INDUSTRY</button>
      <button class="nav-tab" data-tab="about">ABOUT</button>
      <button class="nav-tab" data-tab="work">WORK</button>
      <button class="nav-tab" data-tab="contact">CONTACT</button>
    </nav>

    <!-- Grain texture — feTurbulence fractalNoise -->
    <svg class="grain" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <filter id="grain-filter" x="0%" y="0%" width="100%" height="100%">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.68"
          numOctaves="3"
          stitchTiles="stitch"
        />
        <feColorMatrix type="saturate" values="0" />
      </filter>
      <rect width="100%" height="100%" filter="url(#grain-filter)" />
    </svg>

    <slot />

    <div class="cursor-dot" id="cursor-dot"></div>

    <!-- Background music -->
    <audio id="bg-music" loop preload="none">
      <source src="/audio/website-audio.ogg" type="audio/ogg" />
    </audio>

    <button class="music-toggle" id="music-toggle" aria-label="Toggle music">
      <span class="music-toggle__text">Turn Music On</span>
    </button>

    <script>
      // ── Smooth scroll (non-Safari fine pointer devices only) ──
      const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);
      if (!isSafari && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
        let currentY = window.scrollY;
        let velocity = 0;

        window.addEventListener("wheel", (e) => {
          e.preventDefault();
          if ((window as any).__scrollLocked) { velocity = 0; return; }
          currentY = window.scrollY; // re-sync in case position changed externally
          let delta = e.deltaY;
          if (e.deltaMode === 1) delta *= 28;
          if (e.deltaMode === 2) delta *= window.innerHeight;
          velocity += delta * 0.14;              // dampen input heavily
        }, { passive: false });

        (function tick() {
          if ((window as any).__scrollLocked) {
            velocity = 0;                             // drain any queued velocity
            currentY = window.scrollY;                // stay in sync
          } else {
            velocity *= 0.80;                         // decay — eases out quickly
            if (Math.abs(velocity) > 0.1) {
              const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
              currentY = Math.max(0, Math.min(currentY + velocity, maxScroll));
              window.scrollTo(0, currentY);
            } else {
              velocity = 0;
            }
          }
          requestAnimationFrame(tick);
        })();
      }

      const dot = document.getElementById("cursor-dot") as HTMLElement;
      const R = 4; // half of 8px dot
      let mx = 0, my = 0;
      let cx = 0, cy = 0;
      let visible = false;

      document.addEventListener("mousemove", (e) => {
        mx = e.clientX;
        my = e.clientY;
        if (!visible) {
          // Snap to position on first move so it doesn't slide in from (0,0)
          cx = mx; cy = my;
          visible = true;
        }
        dot.style.opacity = "1";
      });

      (function animate() {
        cx += (mx - cx) * 0.18;
        cy += (my - cy) * 0.18;
        dot.style.transform = `translate(${cx - R}px, ${cy - R}px)`;
        requestAnimationFrame(animate);
      })();

      // ── Brand mark: hover + click via coordinate tracking (pointer-events stays none) ──
      const brandMark     = document.getElementById("brand-mark") as HTMLElement;
      const navTabEls     = Array.from(document.querySelectorAll<HTMLElement>(".nav-tab"));
      let updateBrandMark     = () => {};
      let updateMusicToggleColor = () => {};

      if (brandMark) {

        function getBgLuminanceAt(x: number, y: number): number {
          // Temporarily hide fixed overlays so elementFromPoint hits the page bg
          const navBar = document.querySelector<HTMLElement>(".nav-bar");
          const overlays = [brandMark, document.getElementById("cursor-dot"), document.getElementById("music-toggle"), navBar];
          overlays.forEach(el => el && (el.style.visibility = "hidden"));

          let el = document.elementFromPoint(x, y) as HTMLElement | null;

          overlays.forEach(el => el && (el.style.visibility = ""));

          while (el && el !== document.body) {
            const bg = getComputedStyle(el).backgroundColor;
            const m  = bg.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
            if (m) {
              const [r, g, b] = [+m[1], +m[2], +m[3]];
              if (r + g + b > 0) {
                // Perceived luminance
                return (0.299 * r + 0.587 * g + 0.114 * b) / 255;
              }
            }
            el = el.parentElement;
          }
          return 0; // default dark
        }

        updateBrandMark = function() {
          const bmR = brandMark.getBoundingClientRect();
          const onLightBm = getBgLuminanceAt(bmR.left + 16, bmR.top + 16) > 0.5;
          brandMark.classList.toggle("brand-mark--on-light", onLightBm);
          navTabEls.forEach((t) => {
            const r = t.getBoundingClientRect();
            const onLight = getBgLuminanceAt(r.left + r.width / 2, r.top + r.height / 2) > 0.5;
            t.classList.toggle("nav-tab--on-light", onLight);
          });
        };
        window.addEventListener("scroll", updateBrandMark, { passive: true });
        updateBrandMark();

        // Click: scroll to top if click lands within brand mark bounds
        document.addEventListener("click", (e) => {
          const r = brandMark.getBoundingClientRect();
          if (e.clientX >= r.left && e.clientX <= r.right &&
              e.clientY >= r.top  && e.clientY <= r.bottom) {
            window.scrollTo({ top: 0, behavior: "smooth" });
          }
        });
      }

      // ── Music toggle ──
      const music       = document.getElementById("bg-music") as HTMLAudioElement;
      const musicToggle = document.getElementById("music-toggle") as HTMLButtonElement;

      if (music && musicToggle) {
        const musicToggleText = musicToggle.querySelector(".music-toggle__text") as HTMLElement;

        updateMusicToggleColor = function() {
          const tr = musicToggle.getBoundingClientRect();
          const cx = tr.left + tr.width / 2;
          const cy = tr.top  + tr.height / 2;
          musicToggle.style.visibility = "hidden";
          let el = document.elementFromPoint(cx, cy) as HTMLElement | null;
          musicToggle.style.visibility = "";
          let lum = 0;
          while (el && el !== document.body) {
            const bg = getComputedStyle(el).backgroundColor;
            const m  = bg.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
            if (m) {
              const [r, g, b] = [+m[1], +m[2], +m[3]];
              if (r + g + b > 0) { lum = (0.299 * r + 0.587 * g + 0.114 * b) / 255; break; }
            }
            el = el.parentElement;
          }
          musicToggle.classList.toggle("music-toggle--on-light", lum > 0.5);
        };
        window.addEventListener("scroll", updateMusicToggleColor, { passive: true });
        updateMusicToggleColor();

        function startMusic() {
          music.play().then(() => {
            musicToggle.classList.add("is-playing");
            if (musicToggleText) musicToggleText.textContent = "Turn Music Off";
          }).catch(() => {});
        }

        musicToggle.addEventListener("click", (e) => {
          e.stopPropagation();
          if (music.paused) {
            startMusic();
          } else {
            music.pause();
            musicToggle.classList.remove("is-playing");
            if (musicToggleText) musicToggleText.textContent = "Turn Music On";
          }
        });
      }

      // ── Nav tabs ──
      const navTabs  = Array.from(document.querySelectorAll<HTMLElement>('.nav-tab'));
      const pages    = Array.from(document.querySelectorAll<HTMLElement>('[data-page]'));

      navTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          navTabs.forEach((t) => t.classList.remove('is-active'));
          tab.classList.add('is-active');
          const target = tab.dataset.tab;
          pages.forEach((p) => {
            p.style.display = p.dataset.page === target ? '' : 'none';
          });
          window.scrollTo({ top: 0, behavior: 'instant' });
          // Let layout settle then re-run size-calibration and colour detection
          requestAnimationFrame(() => {
            window.dispatchEvent(new Event('resize'));
            updateBrandMark();
            updateMusicToggleColor();
            setTimeout(() => {
              (window as any).__calibrateBIGGER?.();
              (window as any).__initAboutParallax?.();
              (window as any).__initBeenAround?.();
            }, 80);
          });
        });
      });
    </script>
  </body>
</html>
