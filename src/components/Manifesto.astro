    transition: opacity 0.25s ease 0.38s;
  }
</style>

<script>
  // ── Reveal on scroll ──
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target); // fire once
        }
      });
    },
    {
      threshold: 0.22,
      rootMargin: "0px 0px -40px 0px",
    }
  );

  document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));

  // ── Parallax + perspective on manifesto sections (desktop only) ──
  const isTouch = !window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  function applyParallax() {
    if (isTouch) return;
    const inners = document.querySelectorAll<HTMLElement>(".manifesto-inner.is-visible");
    const vh = window.innerHeight;

    inners.forEach((inner) => {
      const rect     = inner.getBoundingClientRect();
      const progress = (vh / 2 - (rect.top + rect.height / 2)) / vh;
      const clamped  = Math.max(-0.8, Math.min(0.8, progress));
      const translateY = clamped * -110;
      const rotateX    = clamped * 7;
      inner.style.transform = `perspective(900px) rotateX(${rotateX}deg) translateY(${translateY}px)`;
    });
  }

  // ── Intro slider (i===5) ──
  {
    const track   = document.querySelector<HTMLElement>('.intro-slides-track');
    const prevBtn = document.querySelector<HTMLButtonElement>('.intro-slider-prev');
    const nextBtn = document.querySelector<HTMLButtonElement>('.intro-slider-next');
    const counter = document.querySelector<HTMLElement>('.intro-slider-counter');
    const total   = 6;
    let   current = 0;

    function goTo(idx: number) {
      current = Math.max(0, Math.min(total - 1, idx));
      const slideW = (track?.parentElement as HTMLElement)?.offsetWidth ?? 0;
      if (track) track.style.transform = `translateX(-${current * slideW * 0.85}px)`;
      if (counter) counter.textContent = `${String(current + 1).padStart(2,'0')} / ${String(total).padStart(2,'0')}`;
      if (prevBtn) prevBtn.disabled = current === 0;
      if (nextBtn) nextBtn.disabled = current === total - 1;
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    goTo(0);

    window.addEventListener('resize', () => goTo(current), { passive: true });
  }

  // ── Horizontal scroll text ──
  const hscrollSection   = document.querySelector<HTMLElement>('.manifesto-block--green');
  const hscrollContainer = hscrollSection?.querySelector<HTMLElement>('.manifesto-hscroll');
  const hscrollText      = hscrollContainer?.querySelector<HTMLElement>('.manifesto-hscroll-text');

  let adItems: HTMLElement[] = [];

  if (hscrollSection && hscrollContainer && hscrollText) {
    adItems = Array.from(hscrollContainer.querySelectorAll<HTMLElement>('.ad-item'));
    const sortedByEntry = [...adItems].sort((a, b) =>
      parseFloat(a.dataset.threshold ?? '0') - parseFloat(b.dataset.threshold ?? '0')
    );
    sortedByEntry.forEach((item, i) => {
      item.dataset.exitThreshold = (0.74 + (i / (sortedByEntry.length - 1)) * 0.23).toFixed(3);
    });
    const textW = hscrollText.scrollWidth;
    const vpW   = window.innerWidth;
    const vpH   = window.innerHeight;
    hscrollSection.style.minHeight = `${textW + vpW + vpH}px`;
  }

  function applyHscroll() {
    if (!hscrollSection || !hscrollContainer || !hscrollText) return;
    const rect        = hscrollSection.getBoundingClientRect();
    const vh          = window.innerHeight;
    const sh          = hscrollSection.offsetHeight;
    const active      = rect.top < vh && rect.bottom > 0;
    hscrollContainer.style.opacity = active ? '1' : '0';
    const scrollRange = sh - vh;
    const progress    = Math.max(0, Math.min(1, -rect.top / scrollRange));
    const tw = hscrollText.scrollWidth;
    const vw = window.innerWidth;
    const tx = vw - progress * (vw + tw);
    hscrollText.style.transform = `translateX(${tx}px)`;
    adItems.forEach((item) => {
      const enter = parseFloat(item.dataset.threshold ?? '0');
      const exit  = parseFloat(item.dataset.exitThreshold ?? '1');
      item.classList.toggle('is-visible', progress >= enter && progress < exit);
    });
  }

  // ── Word scroll (i===3) ──
  const wordSection = document.querySelector<HTMLElement>('.manifesto-block--words');
  const wordOverlay = wordSection?.querySelector<HTMLElement>('.word-scroll-overlay');
  const wordEl      = wordOverlay?.querySelector<HTMLElement>('.word-scroll-word');
  const scrollWords   = ['That', 'made', 'the', 'work', 'slow,', 'expensive', 'and', 'shite.', 'Budgets', 'shrank.', 'Big', 'names', 'faded.'];
  const purpleWords   = new Set(['slow,', 'expensive', 'shite.', 'shrank.', 'faded.']);
  let wordIdx = -1;

  if (wordSection) {
    wordSection.style.minHeight = `${window.innerHeight * 3.2}px`;
  }

  function applyWordScroll() {
    if (!wordSection || !wordOverlay || !wordEl) return;
    const rect   = wordSection.getBoundingClientRect();
    const vh     = window.innerHeight;
    const sh     = wordSection.offsetHeight;
    const active = rect.top < vh && rect.bottom > 0;
    wordOverlay.classList.toggle('is-active', active);
    if (!active) { wordIdx = -1; return; }
    const scrollRange = sh - vh;
    const progress    = Math.max(0, Math.min(1, -rect.top / scrollRange));
    const raw         = Math.floor(progress * scrollWords.length);
    const idx         = Math.min(raw, scrollWords.length - 1);
    if (idx !== wordIdx) {
      wordIdx = idx;
      const isLast = idx === scrollWords.length - 1;
      wordEl.classList.remove('is-in');
      void wordEl.offsetWidth;
      const isPurple = purpleWords.has(scrollWords[idx]);
      wordEl.style.color = '';
      const letterColor = (char: string) =>
        isPurple && /[a-zA-Z]/.test(char) ? '#986edf' : '#e8e4de';
      if (isLast) {
        wordEl.innerHTML = '';
        scrollWords[idx].split('').forEach((char) => {
          const span = document.createElement('span');
          span.textContent = char;
          span.style.display = 'inline-block';
          span.style.color = letterColor(char);
          const dissolveDelay = (0.4 + Math.random() * 1.4).toFixed(2);
          const dissolveDur   = (0.2 + Math.random() * 0.4).toFixed(2);
          span.style.animation = `letter-appear 0.25s cubic-bezier(0.16,1,0.3,1) forwards, letter-dissolve ${dissolveDur}s ease-in ${dissolveDelay}s forwards`;
          wordEl.appendChild(span);
        });
      } else if (isPurple) {
        const m = scrollWords[idx].match(/^([a-zA-Z]+)([^a-zA-Z]*)$/);
        wordEl.innerHTML = m && m[2]
          ? `<span style="color:#986edf">${m[1]}</span><span style="color:#e8e4de">${m[2]}</span>`
          : `<span style="color:#986edf">${scrollWords[idx]}</span>`;
        wordEl.classList.add('is-in');
      } else {
        wordEl.style.color = '#e8e4de';
        wordEl.textContent = scrollWords[idx];
        wordEl.classList.add('is-in');
      }
    }
  }

  // ── Bigger section (i===4) ──
  const biggerSection  = document.querySelector<HTMLElement>('.manifesto-block--bigger');
  const biggerOverlay  = biggerSection?.querySelector<HTMLElement>('.bigger-overlay');
  const biggerInner    = biggerOverlay?.querySelector<HTMLElement>('.bigger-inner');
  const biggerTop      = biggerOverlay?.querySelector<HTMLElement>('.bigger-top');
  const biggerWordWrap = biggerOverlay?.querySelector<HTMLElement>('.bigger-word-wrap');
  const biggerReplace  = biggerOverlay?.querySelector<HTMLElement>('.bigger-replace');
  const biggerHaze     = biggerOverlay?.querySelector<HTMLElement>('.bigger-haze');
  const biggerTopText  = "Turns out the world doesn\u2019t need";
  if (biggerSection) {
    biggerSection.style.minHeight = `${window.innerHeight * 12}px`;
  }

  if (biggerTop) {
    biggerTopText.split('').forEach((char) => {
      const span = document.createElement('span');
      span.textContent = char === ' ' ? '\u00a0' : char;
      biggerTop.appendChild(span);
    });
  }

  // ── Calibrate BIGGER font-size to match top line width ──
  function calibrateBIGGERFontSize() {
    if (!biggerTop || !biggerWordWrap) return;
    const glyphs = Array.from(biggerWordWrap.querySelectorAll<HTMLElement>('.bigger-glyph'));
    if (!glyphs.length) return;
    glyphs.forEach(el => { el.style.fontSize = ''; });
    const topW   = biggerTop.offsetWidth;
    const biggerW = biggerWordWrap.offsetWidth;
    if (topW <= 0 || biggerW <= 0) return;
    const currentFS = parseFloat(getComputedStyle(glyphs[0]).fontSize);
    const newFS = Math.round(currentFS * topW / biggerW);
    glyphs.forEach(el => { el.style.fontSize = `${newFS}px`; });
    natLetterHeights.length = 0;
  }
  document.fonts.ready.then(calibrateBIGGERFontSize);
  window.addEventListener('resize', calibrateBIGGERFontSize, { passive: true });

  const TOP_FRAC = 0.70;
  const BOT_FRAC = 0.19;

  function measureCapMetrics(fontSize: number): { leadingPx: number; capHeight: number } {
    const cv  = document.createElement('canvas');
    const cw  = Math.ceil(fontSize * 2);
    const ch  = Math.ceil(fontSize * 2.5);
    cv.width  = cw;
    cv.height = ch;
    const ctx = cv.getContext('2d')!;
    ctx.font      = `400 ${fontSize}px 'Bebas Neue', sans-serif`;
    ctx.fillStyle = '#fff';
    const baseline = Math.round(fontSize * 1.8);
    ctx.fillText('G', 2, baseline);
    const { data } = ctx.getImageData(0, 0, cw, ch);
    let inkTop = ch, inkBot = 0;
    for (let y = 0; y < ch; y++)
      for (let x = 0; x < cw; x++)
        if (data[(y * cw + x) * 4 + 3] > 10) {
          if (y < inkTop) inkTop = y;
          if (y > inkBot) inkBot = y;
        }
    const cssEmTop  = baseline - Math.round(fontSize * 0.80);
    const leadingPx = Math.max(0, inkTop - cssEmTop);
    const capHeight = inkBot - inkTop + 1;
    return { leadingPx, capHeight };
  }

  const natLetterHeights: number[] = [];

  const _sr = (n: number) => (Math.abs(Math.sin(n * 127.1 + 311.7)) * 43758.5453) % 1;
  const cutDirections = Array.from({ length: 6 }, (_, i) => ({
    topX: (_sr(i * 7 + 0) - 0.5) * 340,
    topY: -(_sr(i * 7 + 1) * 200 + 120),
    topR: (_sr(i * 7 + 2) - 0.5) * 100,
    botX: (_sr(i * 7 + 3) - 0.5) * 340,
    botY:  _sr(i * 7 + 4) * 200 + 120,
    botR: (_sr(i * 7 + 5) - 0.5) * 100,
  }));

  function applyBiggerSection() {
    if (!biggerSection || !biggerOverlay || !biggerWordWrap || !biggerTop) return;
    const rect   = biggerSection.getBoundingClientRect();
    const vh     = window.innerHeight;
    const sh     = biggerSection.offsetHeight;
    const active = rect.top < vh && rect.bottom > 0;
    biggerOverlay.classList.toggle('is-active', active);
    if (!active) return;

    const scrollRange = sh - vh;
    const progress    = Math.max(0, Math.min(1, -rect.top / scrollRange));

    const topLetters = Array.from(biggerTop.children) as HTMLElement[];
    topLetters.forEach((el, i) => {
      const threshold = 0.03 + (i / Math.max(topLetters.length - 1, 1)) * 0.06;
      const visible   = progress >= threshold;
      el.style.opacity   = visible ? '1' : '0';
      el.style.transform = visible ? 'translateX(0)' : 'translateX(-14px)';
    });


    const biggerFadeOut = Math.max(0, Math.min(1, (progress - 0.78) / 0.04));
    // BIGGER fades in smoothly once top line is fully in (~0.09)
    const wrapReveal = Math.max(0, Math.min(1, (progress - 0.12) / 0.04));
    biggerWordWrap.style.opacity = String(wrapReveal * (1 - biggerFadeOut));

    // Stretch only starts once BIGGER is fully revealed (~0.28)
    // Cap sy so BIGGER fills viewport from its natural position to ~40px from bottom
    const stretchLocal = Math.max(0, Math.min(1, (progress - 0.28) / 0.40));
    const natH0    = natLetterHeights[0] || 1;
    const topH0    = Math.round(natH0 * TOP_FRAC);
    const botH0    = Math.round(natH0 * BOT_FRAC);
    const midH0    = natH0 - topH0 - botH0;
    const wwTop    = biggerWordWrap.getBoundingClientRect().top;
    const availH   = vh - wwTop - 40;
    const syCap    = Math.max(1, (availH - topH0 - botH0) / midH0);
    const sy       = 1 + stretchLocal * (syCap - 1);

    // Top line starts centered, floats up to top as BIGGER grows
    if (biggerInner) {
      const overlayPadTop = parseFloat(getComputedStyle(biggerOverlay).paddingTop);
      const centerOffset  = Math.max(0, vh * 0.35 - (biggerTop?.offsetHeight ?? 0) / 2 - overlayPadTop);
      const ty = centerOffset * (1 - stretchLocal);
      biggerInner.style.transform = `translateY(${ty}px)`;
    }

    // Atmosphere: rays + haze build in as BIGGER reveals, fade after strike
    const atmosIn  = Math.max(0, Math.min(1, (progress - 0.10) / 0.18));
    const atmosOut = Math.max(0, Math.min(1, (progress - 0.76) / 0.06));
    const atmosA   = atmosIn * (1 - atmosOut);
    if (biggerHaze) biggerHaze.style.opacity = String(atmosA);


    if (biggerReplace) {
      const replaceP = Math.max(0, Math.min(1, (progress - 0.78) / 0.08));
      biggerReplace.style.opacity = String(replaceP);
    }

    const wraps = Array.from(biggerWordWrap.querySelectorAll<HTMLElement>('.bigger-letter-wrap'));
    wraps.forEach((wrap, i) => {
      const topZone  = wrap.children[0] as HTMLElement;
      const midZone  = wrap.children[1] as HTMLElement;
      const botZone  = wrap.children[2] as HTMLElement;
      const topGlyph = topZone?.firstElementChild as HTMLElement;
      const midGlyph = midZone?.firstElementChild as HTMLElement;
      const botGlyph = botZone?.firstElementChild as HTMLElement;
      if (!topGlyph || !midGlyph || !botGlyph) return;

      if (!natLetterHeights[i]) {
        const fontSize = parseFloat(getComputedStyle(topGlyph).fontSize);
        const { leadingPx, capHeight } = measureCapMetrics(fontSize);
        natLetterHeights[i] = capHeight;
        const nh = natLetterHeights[i];
        const tH = Math.round(nh * TOP_FRAC);
        const mH = Math.round(nh * (1 - TOP_FRAC - BOT_FRAC));
        const ov = Math.round(nh * 0.04);
        topGlyph.style.top = `-${leadingPx}px`;
        topZone.style.marginBottom = `-${ov}px`;
        midGlyph.style.top             = `-${leadingPx + tH}px`;
        midGlyph.style.transformOrigin = `50% ${leadingPx + tH}px`;
        botGlyph.style.top = `-${leadingPx + tH + mH - ov}px`;
        botZone.style.marginTop = `-${ov}px`;
      }

      const natH = natLetterHeights[i];
      const topH = Math.round(natH * TOP_FRAC);
      const botH = Math.round(natH * BOT_FRAC);
      const midH = natH - topH - botH;

      // Reveal starts after top line is fully in, letters staggered
      const revealStart = 0.12 + i * 0.012;
      const revealLocal = Math.max(0, Math.min(1, (progress - revealStart) / 0.10));
      const revealEased = 1 - Math.pow(1 - revealLocal, 3);
      const revealH     = revealEased * natH;

      const ov        = Math.round(natH * 0.04);
      const rawTopH   = Math.round(Math.min(revealH, topH));
      const topZoneH  = revealH >= topH ? rawTopH + ov : rawTopH;
      const midReveal = Math.max(0, Math.min(1, (revealH - topH) / midH));
      const midZoneH  = Math.round(midReveal * midH * sy);
      // Bot zone only opens once top + natural mid are fully revealed
      const botReveal = Math.max(0, Math.min(1, (revealH - topH - midH) / botH));
      const botZoneH  = Math.round(botReveal * (botH + ov));

      topZone.style.height = `${topZoneH}px`;
      midZone.style.height = `${midZoneH}px`;
      botZone.style.height = `${botZoneH}px`;
      midGlyph.style.transform = `scaleY(${sy})`;

      topZone.style.transform = '';
      botZone.style.transform = '';
    });
  }

  // ── Target cursor: active once BIGGER is fully stretched on screen ──
  function applyBiggerSectionWithShoot() {
    applyBiggerSection();
    if (!biggerOverlay || !biggerSection) return;
    const rect     = biggerSection.getBoundingClientRect();
    const sh       = biggerSection.offsetHeight;
    const progress = Math.max(0, Math.min(1, -rect.top / (sh - window.innerHeight)));
    // Cursor on once BIGGER has finished stretching to fill the screen (~0.68)
    const aimOn = progress >= 0.66 && biggerOverlay.classList.contains('is-active');
    document.body.classList.toggle('bigger-aim-mode', aimOn);
    if (aimCursorEl) aimCursorEl.style.display = aimOn ? 'block' : 'none';
  }

  // ── Splatter shooting interaction ──
  // One base image; hue-rotate gives colour variety
  const splatHues  = [0, 45, 90, 150, 200, 270, 320]; // spread across spectrum
  const splatAudio = new Audio('/splatters/splatter-sound.mp3');
  splatAudio.volume = 0.6;

  function triggerShake() {
    if (!biggerOverlay) return;
    biggerOverlay.classList.remove('is-shaking');
    void biggerOverlay.offsetWidth;
    biggerOverlay.classList.add('is-shaking');
    biggerOverlay.addEventListener('animationend', () => {
      biggerOverlay.classList.remove('is-shaking');
    }, { once: true });
  }

  function spawnSplat(x: number, y: number) {
    const hue = splatHues[Math.floor(Math.random() * splatHues.length)];
    const rot = Math.random() * 360;
    const img = document.createElement('img');
    img.src   = '/splatters/splatter-blue.png';
    img.className = 'bigger-splat';
    img.style.left = `${x}px`;
    img.style.top  = `${y}px`;
    img.style.setProperty('--splat-rot', `rotate(${rot}deg)`);
    img.style.filter = `hue-rotate(${hue}deg)`;
    document.body.appendChild(img);

    const sfx = splatAudio.cloneNode() as HTMLAudioElement;
    sfx.play().catch(() => {});

    setTimeout(() => img.remove(), 2200);
  }

  // JS-driven cursor element — bypasses all browser cursor reset behaviour
  const aimCursorEl = document.createElement('div');
  aimCursorEl.id = 'bigger-aim-cursor';
  const aimCursorImg = document.createElement('img');
  aimCursorImg.src = '/cursors/target-icon-64.png';
  aimCursorImg.style.cssText = 'width:100%;height:100%;display:block';
  aimCursorEl.appendChild(aimCursorImg);
  document.body.appendChild(aimCursorEl);

  window.addEventListener('mousemove', (e) => {
    aimCursorEl.style.left = `${e.clientX}px`;
    aimCursorEl.style.top  = `${e.clientY}px`;
  }, { passive: true });

  window.addEventListener('click', (e) => {
    if (!document.body.classList.contains('bigger-aim-mode')) return;
    spawnSplat(e.clientX, e.clientY);
    triggerShake();
  });

  // ── Third section headline: scroll-driven word reveal ──
  const thirdSection   = document.querySelector<HTMLElement>('.manifesto-block--third');
  const lostWords      = Array.from(document.querySelectorAll<HTMLElement>('.lost-word'));

  function applyLostHeadline() {
    if (!thirdSection || lostWords.length === 0) return;
    const rect     = thirdSection.getBoundingClientRect();
    const vh       = window.innerHeight;
    // 0 when section bottom enters viewport, 1 when section is 55% scrolled in
    const progress = Math.max(0, Math.min(1, (vh - rect.top) / (vh * 0.55)));
    lostWords.forEach((word, i) => {
      const threshold = i / (lostWords.length + 1);
      word.classList.toggle('is-revealed', progress >= threshold);
    });
  }

  // ── Grid overlay: stays viewport-aligned, lines purple → dark as section scrolls in ──
  const thirdGridSvg   = document.querySelector<SVGSVGElement>('.third-grid');
  const thirdGridGroup = document.querySelector<SVGGElement>('.third-grid-lines');

  function applyGridColor() {
    if (!thirdSection || !thirdGridSvg || !thirdGridGroup) return;
    const rect = thirdSection.getBoundingClientRect();
    const vh   = window.innerHeight;
    thirdGridSvg.style.transform = `translateY(${-rect.top}px)`;
    const progress = Math.max(0, Math.min(1, (vh - rect.top) / vh));
    const r = Math.round(0x98 + (0x1a - 0x98) * progress);
    const g = Math.round(0x6e + (0x1a - 0x6e) * progress);
    const b = Math.round(0xdf + (0x1a - 0xdf) * progress);
    thirdGridGroup.style.stroke = `rgb(${r},${g},${b})`;
  }

  // ── Single RAF-throttled scroll handler ──
  function runScrollHandlers() {
    if (hscrollSection && hscrollContainer && hscrollText) applyHscroll();
    applyParallax();
    applyWordScroll();
    applyBiggerSectionWithShoot();
    applyGridColor();
    applyLostHeadline();
  }

  let scrollRaf = 0;
  window.addEventListener("scroll", () => {
    if (scrollRaf) return;
    scrollRaf = requestAnimationFrame(() => {
      runScrollHandlers();
      scrollRaf = 0;
    });
  }, { passive: true });

  runScrollHandlers();

</script>

<style>
  /* Parallax transform applied directly via JS — no transition so it tracks scroll instantly */
  .manifesto-inner.is-visible {
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Prevent the parallax transform competing with line transitions */
  .manifesto-inner.is-visible .manifesto-line,
  .manifesto-inner--finale.is-visible .manifesto-finale {
    transform: none;
  }
</style>

<script>
  const burstWord  = document.querySelector('.burst-word');
  const burstLayer = document.querySelector<HTMLElement>('.burst-layer');

  if (burstWord && burstLayer) {
    const word = burstWord as Element;
    function rand(a: number, b: number) { return a + Math.random() * (b - a); }

    const FILL_COLORS = ['#e8e4de', '#986edf', '#1a5c3a'];
    const BG = `fill="none"`;
    const S  = `stroke="#1a1a1a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"`;
    const H  = `<circle cx="20" cy="20" r="17" ${BG}/>`;   // filled head
    const FACES = [
      // WOW — round eyes, raised brows, O-mouth
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M9,10 Q13,7 17,10"/><path d="M23,10 Q27,7 31,10"/><circle cx="13" cy="16" r="3.5"/><circle cx="27" cy="16" r="3.5"/><ellipse cx="20" cy="27" rx="5" ry="5.5"/></svg>`,
      // LAUGHING — squint eyes, open grin
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M9,15 Q13,10 17,15"/><path d="M23,15 Q27,10 31,15"/><path d="M10,23 Q15,21 20,22 Q25,21 30,23"/><path d="M10,23 Q20,36 30,23"/></svg>`,
      // SHOCKED — rect eyes, raised brows, oval mouth
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M9,10 Q13,7 17,10"/><path d="M23,10 Q27,7 31,10"/><rect x="10" y="12" width="8" height="7" rx="1"/><rect x="22" y="12" width="8" height="7" rx="1"/><ellipse cx="20" cy="28" rx="5" ry="5.5"/></svg>`,
      // THINKING — one raised brow, eyes looking up, chin touch
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M9,13 Q13,10 17,13"/><path d="M22,11 Q27,8 31,12"/><circle cx="13" cy="17" r="2.5"/><circle cx="27" cy="15" r="2.5"/><path d="M15,27 Q18,25 22,26"/><path d="M26,31 Q28,29 30,27"/></svg>`,
      // CRAZY — swirl eye + X eye, wavy grin
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<circle cx="13" cy="16" r="5"/><circle cx="13" cy="16" r="2"/><path d="M23,11 L31,21"/><path d="M31,11 L23,21"/><path d="M9,27 Q12,24 15,27 Q18,30 21,27 Q24,24 27,27"/></svg>`,
      // SMUG — arched brow, hooded eye, lopsided smirk
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M9,12 Q13,9 17,12"/><path d="M22,10 Q27,8 31,12"/><circle cx="13" cy="17" r="2.5"/><circle cx="27" cy="16" r="2.5"/><path d="M24,13.5 Q27,12 30,13.5"/><path d="M13,26 Q18,24 22,26 Q26,29 28,27"/></svg>`,
      // STAR-EYED — asterisk eyes, big smile
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M13,10.5 L13,20.5 M8,15.5 L18,15.5 M9.5,12 L16.5,19 M16.5,12 L9.5,19"/><path d="M27,10.5 L27,20.5 M22,15.5 L32,15.5 M23.5,12 L30.5,19 M30.5,12 L23.5,19"/><path d="M10,26 Q20,36 30,26"/></svg>`,
      // DISGUSTED — furrowed brows, squinted lines, frown
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M9,14 Q13,17 17,14"/><path d="M23,14 Q27,17 31,14"/><line x1="10" y1="17" x2="16" y2="17"/><line x1="24" y1="17" x2="30" y2="17"/><path d="M12,28 Q20,23 28,28"/></svg>`,
    ];

    function spawnBurst() {
      const rect = word.getBoundingClientRect();

      for (let i = 0; i < 8; i++) {
        const size = rand(48, 72);
        const el   = document.createElement('div');
        const bgColor = FILL_COLORS[Math.floor(Math.random() * FILL_COLORS.length)];
        el.style.cssText = `position:fixed;pointer-events:none;z-index:9998;width:${size}px;height:${size}px;top:0;left:0;border-radius:50%;background:${bgColor};`;
        el.innerHTML = FACES[Math.floor(Math.random() * FACES.length)];
        document.body.appendChild(el);

        let x   = rect.left + rand(0, rect.width)  - size / 2;
        let y   = rect.top  + rand(-6, 6)           - size / 2;
        let vx  = rand(-2, 2);
        let vy  = rand(-7, -4);
        let rot = rand(0, 360);
        const vr = rand(-1.5, 1.5);
        (function tick() {
          vy  += 0.1;
          x   += vx;
          y   += vy;
          rot += vr;
          el.style.transform = `translate(${x}px,${y}px) rotate(${rot}deg)`;
          if (y < window.innerHeight + size) requestAnimationFrame(tick);
          else el.remove();
        })();
      }
    }

    word.addEventListener('mouseenter', spawnBurst);
  }
</script>
