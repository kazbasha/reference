---
import CreativeSins from './CreativeSins.tsx';
const blocks: [string, string][] = [
  [
    "Every great idea starts with a reference.",
    "You see it and think\u00a0\u201cFuck I wish I\u2019d done that\u201d",
  ],
  [
    "That kind of work is an unfair advantage.",
    "But there\u2019s a magic to making it happen.",
  ],
  [
    "Somewhere along the way, we lost it.",
    "We started listening to every opinion. We began calling anything creative. Stopped working with our own hands.",
  ],
  [
    "That made the work slow,",
    "expensive and shite. Budgets shrank. Big names faded.",
  ],
  [
    "Turns out the world doesn\u2019t need bigger.",
    "It needs better.",
  ],
  [
    "Introducing Reference.",
    "A creative studio run like a band.",
  ],
  [
    "Small. Experienced. Hands-on.",
    "Dangerously fast.",
  ],
  [
    "From strategy to ideas to execution.",
    "We handle it all.",
  ],
  [
    "Bringing in the right talent for the job.",
    "Not whoever\u2019s available on Tuesday.",
  ],
  [
    "Because we care about the work.",
    "And we\u2019re sick of all the slop.",
  ],
  [
    "We\u2019re not here to follow the reference.",
    "We\u2019re here to be it.",
  ],
];

// 4 rows × 3 cols — mathematically verified non-overlapping at 768px–1920px.
// Rows 1&4 (large) hug top/bottom edges; rows 2&3 (medium) flank the text.
// Images spread across different rows and columns.
const ads = [
  // ── ROW 1 — top:4%, large (270px), z:5, alpha:1 ──────────────────────
  // cols: left:7%, left:38%, left:69%
  { src: '/video/cadbury-gorilla.mp4',          pos: 'top:4%;left:7%;width:clamp(190px,19vw,270px);z-index:5',   rot: -4, alpha: 1.0,  floatDelay: '0s',   threshold: 0.04 },
  { src: '/video/axa-three-words.webp',         pos: 'top:4%;left:38%;width:clamp(190px,19vw,270px);z-index:5',  rot:  2, alpha: 1.0,  floatDelay: '0.8s', threshold: 0.34 },
  { src: '/video/long-long-man.mp4',            pos: 'top:4%;left:69%;width:clamp(190px,19vw,270px);z-index:5',  rot: -2, alpha: 1.0,  floatDelay: '1.8s', threshold: 0.58 },

  // ── ROW 2 — top:28%, medium (190px), z:3, alpha:0.85 ─────────────────
  // cols: left:11%, left:42%, left:72% — offset from row 1
  { src: '/video/audi-sheep.jpg',               pos: 'top:28%;left:11%;width:clamp(140px,13vw,190px);z-index:3',  rot:  3, alpha: 0.85, floatDelay: '3.2s', threshold: 0.10 },
  { src: '/video/dumb-ways-to-die.mp4',         pos: 'top:28%;left:42%;width:clamp(140px,13vw,190px);z-index:3',  rot: -3, alpha: 0.85, floatDelay: '0.6s', threshold: 0.40 },
  { src: '/video/never-say-no-to-panda-v2.mp4', pos: 'top:28%;left:72%;width:clamp(140px,13vw,190px);z-index:3',  rot:  1, alpha: 0.85, floatDelay: '2.4s', threshold: 0.64 },

  // ── ROW 3 — bottom:28%, medium (190px), z:3, alpha:0.85 ──────────────
  // cols: left:4%, left:35%, left:64% — offset from row 2
  { src: '/video/snickers.mp4',                 pos: 'bottom:28%;left:4%;width:clamp(140px,13vw,190px);z-index:3', rot: -2, alpha: 0.85, floatDelay: '1.5s', threshold: 0.22 },
  { src: '/video/volvo-splits.mp4',             pos: 'bottom:28%;left:35%;width:clamp(140px,13vw,190px);z-index:3', rot:  4, alpha: 0.85, floatDelay: '2.9s', threshold: 0.46 },
  { src: '/video/sony-balls.mp4',               pos: 'bottom:28%;left:64%;width:clamp(140px,13vw,190px);z-index:3', rot: -1, alpha: 0.85, floatDelay: '0.3s', threshold: 0.70 },

  // ── ROW 4 — bottom:4%, large (270px), z:5, alpha:1 ───────────────────
  // cols: left:15%, left:45%, left:74% — offset from row 1
  { src: '/video/nothing-beats-a-londoner.mp4', pos: 'bottom:4%;left:15%;width:clamp(190px,19vw,270px);z-index:5', rot:  2, alpha: 1.0,  floatDelay: '1.1s', threshold: 0.16 },
  { src: '/video/orange-womens.webp',           pos: 'bottom:4%;left:45%;width:clamp(190px,19vw,270px);z-index:5', rot: -4, alpha: 1.0,  floatDelay: '2.7s', threshold: 0.52 },
  { src: '/video/old-spice.mp4',                pos: 'bottom:4%;left:74%;width:clamp(190px,19vw,270px);z-index:5', rot:  3, alpha: 1.0,  floatDelay: '3.5s', threshold: 0.28 },
];

---

<div class="manifesto-bg" aria-hidden="true">
  <svg
    class="perspective-grid"
    viewBox="0 0 1600 900"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    <g stroke="#986edf" stroke-width="1" fill="none" opacity="0.18">
      <line x1="0"    y1="0" x2="1600" y2="900"/>
      <line x1="200"  y1="0" x2="1400" y2="900"/>
      <line x1="400"  y1="0" x2="1200" y2="900"/>
      <line x1="600"  y1="0" x2="1000" y2="900"/>
      <line x1="800"  y1="0" x2="800"  y2="900"/>
      <line x1="1000" y1="0" x2="600"  y2="900"/>
      <line x1="1200" y1="0" x2="400"  y2="900"/>
      <line x1="1400" y1="0" x2="200"  y2="900"/>
      <line x1="1600" y1="0" x2="0"    y2="900"/>
      <line x1="0" y1="112" x2="1600" y2="787"/>
      <line x1="0" y1="225" x2="1600" y2="675"/>
      <line x1="0" y1="337" x2="1600" y2="562"/>
      <line x1="0" y1="450" x2="1600" y2="450"/>
      <line x1="0" y1="562" x2="1600" y2="337"/>
      <line x1="0" y1="675" x2="1600" y2="225"/>
      <line x1="0" y1="787" x2="1600" y2="112"/>
    </g>
  </svg>
</div>

<div class="manifesto">
  {
    blocks.map(([line1, line2], i) => (
      <section class:list={["manifesto-block", { "manifesto-block--alt": i % 2 !== 0, "manifesto-block--first": i === 0, "manifesto-block--green": i === 1, "manifesto-block--third": i === 2, "manifesto-block--words": i === 3, "manifesto-block--bigger": i === 4 }]}>
        {i === 1
          ? <div class="manifesto-hscroll">
              {ads.map((ad) => {
                const isImg = /\.(jpg|png|webp)$/.test(ad.src);
                return (
                  <div
                    class="ad-item"
                    data-threshold={ad.threshold}
                    style={`${ad.pos};--rot:${ad.rot}deg;--float-delay:${ad.floatDelay};--alpha:${ad.alpha}`}
                  >
                    {isImg
                      ? <img src={ad.src} alt="" loading="lazy" />
                      : <video autoplay loop muted playsinline><source src={ad.src} type="video/mp4" /></video>
                    }
                  </div>
                );
              })}
              <p class="manifesto-hscroll-text">{line1}{"   "}{line2}</p>
            </div>
          : i === 2
          ? <div class="lost-diagram" data-reveal>
              <p class="lost-diagram__headline">{line1}</p>
              <CreativeSins client:visible />
            </div>
          : i === 3
          ? <div class="word-scroll-overlay">
              <span class="word-scroll-word" aria-hidden="true"></span>
              <span class="word-scroll-sr">{line1} {line2}</span>
            </div>
          : i === 4
          ? <div class="bigger-overlay">
              <div class="bigger-inner">
                <p class="bigger-top"></p>
                <div class="bigger-word-area">
                  <svg width="0" height="0" aria-hidden="true" style="position:absolute;overflow:visible;pointer-events:none">
                    <defs>
                      <filter id="handdrawn-filter" x="-10%" y="-150%" width="120%" height="400%">
                        <feTurbulence type="fractalNoise" baseFrequency="0.018 0.72" numOctaves="2" seed="7" result="noise"/>
                        <feDisplacementMap in="SourceGraphic" in2="noise" scale="6" xChannelSelector="R" yChannelSelector="G"/>
                      </filter>
                    </defs>
                  </svg>
                  <div class="bigger-word-wrap">
                    {'BIGGER'.split('').map(l => (
                      <div class="bigger-letter-wrap">
                        <div class="bigger-zone bigger-zone--top"><span class="bigger-glyph">{l}</span></div>
                        <div class="bigger-zone bigger-zone--mid"><span class="bigger-glyph">{l}</span></div>
                        <div class="bigger-zone bigger-zone--bot"><span class="bigger-glyph">{l}</span></div>
                      </div>
                    ))}
                  </div>
                  <div class="bigger-strike"></div>
                </div>
              </div>
              <p class="bigger-replace">It needs better.</p>
              <span class="word-scroll-sr">{line1} {line2}</span>
            </div>
          : <div class="manifesto-inner" data-reveal>
              {i === 0
                ? <p class="manifesto-line" set:html={`${line1} ${line2.replace('Fuck', '<span class="burst-word">Fuck</span>')}`} />
                : <p class="manifesto-line">{line1} {line2}</p>
              }
            </div>
        }
        {i === 0 && <div class="burst-layer"></div>}
        {i === 2 && (
          <svg class="third-grid" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <g class="third-grid-lines" stroke="#986edf" stroke-width="1" fill="none" opacity="0.35">
              <line x1="0"    y1="0" x2="1600" y2="900"/>
              <line x1="200"  y1="0" x2="1400" y2="900"/>
              <line x1="400"  y1="0" x2="1200" y2="900"/>
              <line x1="600"  y1="0" x2="1000" y2="900"/>
              <line x1="800"  y1="0" x2="800"  y2="900"/>
              <line x1="1000" y1="0" x2="600"  y2="900"/>
              <line x1="1200" y1="0" x2="400"  y2="900"/>
              <line x1="1400" y1="0" x2="200"  y2="900"/>
              <line x1="1600" y1="0" x2="0"    y2="900"/>
              <line x1="0" y1="112" x2="1600" y2="787"/>
              <line x1="0" y1="225" x2="1600" y2="675"/>
              <line x1="0" y1="337" x2="1600" y2="562"/>
              <line x1="0" y1="450" x2="1600" y2="450"/>
              <line x1="0" y1="562" x2="1600" y2="337"/>
              <line x1="0" y1="675" x2="1600" y2="225"/>
              <line x1="0" y1="787" x2="1600" y2="112"/>
            </g>
          </svg>
        )}
      </section>
    ))
  }

  <!-- Closing CTA — portal -->
  <section class="manifesto-block manifesto-block--finale">

    <!-- Flat regular grid — visible outside the portal -->
    <svg
      class="contact-grid"
      viewBox="0 0 1600 900"
      preserveAspectRatio="xMidYMid slice"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <g stroke="#986edf" stroke-width="1" fill="none">
        <line x1="0" y1="75"  x2="1600" y2="75"/>
        <line x1="0" y1="150" x2="1600" y2="150"/>
        <line x1="0" y1="225" x2="1600" y2="225"/>
        <line x1="0" y1="300" x2="1600" y2="300"/>
        <line x1="0" y1="375" x2="1600" y2="375"/>
        <line x1="0" y1="450" x2="1600" y2="450"/>
        <line x1="0" y1="525" x2="1600" y2="525"/>
        <line x1="0" y1="600" x2="1600" y2="600"/>
        <line x1="0" y1="675" x2="1600" y2="675"/>
        <line x1="0" y1="750" x2="1600" y2="750"/>
        <line x1="0" y1="825" x2="1600" y2="825"/>
        <line x1="107"  y1="0" x2="107"  y2="900"/>
        <line x1="214"  y1="0" x2="214"  y2="900"/>
        <line x1="321"  y1="0" x2="321"  y2="900"/>
        <line x1="428"  y1="0" x2="428"  y2="900"/>
        <line x1="535"  y1="0" x2="535"  y2="900"/>
        <line x1="642"  y1="0" x2="642"  y2="900"/>
        <line x1="749"  y1="0" x2="749"  y2="900"/>
        <line x1="856"  y1="0" x2="856"  y2="900"/>
        <line x1="963"  y1="0" x2="963"  y2="900"/>
        <line x1="1070" y1="0" x2="1070" y2="900"/>
        <line x1="1177" y1="0" x2="1177" y2="900"/>
        <line x1="1284" y1="0" x2="1284" y2="900"/>
        <line x1="1391" y1="0" x2="1391" y2="900"/>
        <line x1="1498" y1="0" x2="1498" y2="900"/>
      </g>
    </svg>

    <!-- Morphing button — circle → rectangle on hover -->
    <a class="contact-btn" href="mailto:hello@reference.studio">
      <span class="contact-btn-label">LET'S JAM</span>
      <span class="contact-btn-email">hello@reference.studio</span>
    </a>

  </section>
</div>

<style>
  .manifesto-block {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(60px, 10vw, 140px) clamp(24px, 7vw, 100px);
    background: transparent;
    overflow: hidden;
  }

  .manifesto-block--alt {
    background: transparent;
  }

  .manifesto-block--finale {
    background: #000000;
    min-height: 100svh;
    padding: 0;
    position: relative;
    z-index: 1;
  }

  /* ── Fixed background — stays pinned behind all sections ── */
  .manifesto-bg {
    position: fixed;
    inset: 0;
    background: #0a0a0a;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .manifesto-bg::before {
    content: '';
    position: absolute;
    inset: -30%;
    background: radial-gradient(
      ellipse 55% 55% at 50% 50%,
      rgba(152, 110, 223, 0.11) 0%,
      transparent 65%
    );
    animation: glow-drift 14s ease-in-out infinite;
  }

  @keyframes glow-drift {
    0%   { transform: translate(0%,   0%); }
    25%  { transform: translate(18%, -12%); }
    50%  { transform: translate(-12%, 16%); }
    75%  { transform: translate(14%,  12%); }
    100% { transform: translate(0%,   0%); }
  }

  /* ── First section: light background, inverted from the rest ── */
  .manifesto-block--first {
    overflow: hidden;
    background: #e8e4de;
    position: relative;
    z-index: 1;
  }

  .manifesto-block--first .manifesto-line {
    color: #1a1a1a;
  }

  /* ── Third section: dark green bg, purple text ── */
  .manifesto-block--third {
    background: #986edf;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }

  .manifesto-block--third .manifesto-line {
    color: #1a1a1a;
  }

  .third-grid {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
  }

  .manifesto-block--third .manifesto-inner {
    position: relative;
    z-index: 1;
  }

  /* ── Horizontal scroll text (i===1) ── */
  /* Section is a transparent scroll spacer — gives scroll distance */
  .manifesto-block--green {
    min-height: 280svh;
  }

  /* Fixed overlay — stays pinned to viewport, only visible when section is active */
  .manifesto-hscroll {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .manifesto-hscroll-text {
    white-space: nowrap;
    font-size: clamp(28px, 4.5vw, 72px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.01em;
    color: #e8e4de;
    will-change: transform;
    position: relative;
    z-index: 5; /* sits above mid/far ads (z:1,4) but below near ads (z:8) */
  }

  /* ── Ad cards ── */
  .ad-item {
    position: absolute;
    /* width is set per-item via inline style for depth effect */
    border-radius: 3px;
    overflow: hidden;
    opacity: 0;
    transform: rotate(var(--rot, 0deg)) scale(0.85) translateY(16px);
    transition:
      opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.65);
  }

  .ad-item video,
  .ad-item img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ad-item.is-visible {
    opacity: var(--alpha, 1);
    transform: rotate(var(--rot, 0deg)) scale(1) translateY(0);
    animation: ad-float 5s ease-in-out var(--float-delay, 0s) infinite;
  }

  @keyframes ad-float {
    0%, 100% { transform: rotate(var(--rot, 0deg)) scale(1) translateY(0px); }
    50%       { transform: rotate(var(--rot, 0deg)) scale(1) translateY(-7px); }
  }

/* ── Burst particle layer ── */
  .burst-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
    z-index: 3;
  }

  /* ── Perspective grid (inside fixed .manifesto-bg) ── */
  .perspective-grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  :global(.burst-word) {
    transition: color 0.15s ease;
    cursor: none;
  }

  :global(.burst-word:hover) {
    color: #986edf;
  }

  /* ── Reveal state ── */
  .manifesto-inner {
    position: relative;
    z-index: 1;
    max-width: 860px;
    width: 100%;
    text-align: center;
  }

  .manifesto-line {
    font-size: clamp(22px, 3.6vw, 58px);
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: #e8e4de;
    text-wrap: balance;
    /* initial hidden state — driven by JS adding .is-visible */
    opacity: 0;
    transform: translateY(36px);
    transition:
      opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .manifesto-line--two {
    margin-top: 0.3em;
    transition-delay: 0.14s;
  }

  .manifesto-inner.is-visible .manifesto-line {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Lost diagram (i===2) ── */
  .lost-diagram {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(20px, 4vw, 60px);
    padding: clamp(24px, 5vw, 80px) clamp(16px, 4vw, 60px);
    overflow-x: hidden;
  }

  @media (max-width: 767px) {
    .manifesto-block--third {
      min-height: unset;
    }
    .lost-diagram {
      position: relative;
      inset: unset;
      justify-content: flex-start;
      padding-top: 48px;
      padding-bottom: 48px;
      overflow-x: hidden;
      overflow-y: visible;
    }
  }

  .lost-diagram__headline {
    font-size: clamp(22px, 3.6vw, 58px);
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: #1a1a1a;
    text-align: center;
    max-width: 640px;
    position: relative;
    z-index: 1;
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lost-diagram.is-visible .lost-diagram__headline {
    opacity: 1;
    transform: translateY(0);
  }


  /* ── Word scroll (i===3) ── */
  .manifesto-block--words {
    /* min-height overridden by JS */
    background: transparent;
  }

  .word-scroll-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: 0;
  }

  .word-scroll-overlay.is-active {
    opacity: 1;
  }

  .word-scroll-word {
    font-size: clamp(52px, 11vw, 160px);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: #e8e4de;
    line-height: 1;
    text-align: center;
  }

  @keyframes word-in {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .word-scroll-word.is-in {
    animation: word-in 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes letter-appear {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes letter-dissolve {
    from { opacity: 1; }
    to   { opacity: 0; }
  }

  .word-scroll-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  /* ── Bigger section (i===4) ── */
  .manifesto-block--bigger {
    /* min-height set by JS */
    background: transparent;
  }

  .bigger-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 44svh clamp(24px, 7vw, 100px) 0;
    overflow: visible;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: 0;
  }

  .bigger-overlay.is-active {
    opacity: 1;
  }

  .bigger-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: visible;
  }

  .bigger-top {
    font-size: clamp(14px, 2.4vw, 39px);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: #e8e4de;
    line-height: 1.18;
    white-space: nowrap;
    margin: 0;
  }

  .bigger-top span {
    display: inline-block;
    opacity: 0;
    transform: translateX(-14px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .bigger-word-area {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 0.1em;
  }

  .bigger-word-wrap {
    display: flex;
    align-items: flex-start;
    gap: 0;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .bigger-strike {
    position: absolute;
    left: 0;
    top: 50%;
    width: 0;
    height: 14px;
    background: #e8230a;
    transform: translateY(-50%);
    pointer-events: none;
    filter: url(#handdrawn-filter);
    border-radius: 3px;
  }

  .bigger-replace {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: clamp(14px, 2.4vw, 39px);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.18;
    color: #e8e4de;
    white-space: nowrap;
    opacity: 0;
    margin: 0;
    pointer-events: none;
  }

  /* Per-letter wrapper — three stacked zones, reads as one word */
  .bigger-letter-wrap {
    display: inline-flex;
    flex-direction: column;
    flex-shrink: 0;
  }

  /* Each zone clips its copy of the glyph to its band only */
  .bigger-zone {
    overflow: hidden;
    height: 0; /* driven by JS */
    flex-shrink: 0;
    position: relative; /* required for z-index in flex */
  }

  /* Top and bottom zones render above the mid zone so overlapping pixels hide the seam */
  .bigger-zone--top,
  .bigger-zone--bot {
    z-index: 1;
  }


  .bigger-glyph {
    display: block;
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(72px, 12vw, 180px);
    font-weight: 400;
    color: #e8e4de;
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
    position: relative; /* top offset set by JS per zone */
  }

  /* ── Finale portal ── */
  .contact-grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    transform-origin: center;
    animation: grid-pulse 4s linear infinite;
  }

  @keyframes grid-pulse {
    0%   { transform: scale(1);    opacity: 0.13; }
    8%   { transform: scale(1.07); opacity: 0.28; }
    28%  { transform: scale(1);    opacity: 0.13; }
    100% { transform: scale(1);    opacity: 0.13; }
  }

  /* Morphing button — circle → rectangle */
  .contact-btn {
    position: relative;
    z-index: 2;
    width: clamp(108px, 9vw, 124px);
    height: clamp(108px, 9vw, 124px);
    border-radius: 50%;
    background: transparent;
    border: 1px solid rgba(152, 110, 223, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    overflow: hidden;
    transition:
      width 0.65s cubic-bezier(0.16, 1, 0.3, 1),
      border-radius 0.65s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s ease,
      background 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-btn:hover {
    width: clamp(240px, 22vw, 320px);
    border-radius: 4px;
    border-color: rgba(152, 110, 223, 0.7);
    background: #0d0318;
  }

  .contact-btn-label {
    position: absolute;
    max-width: 60px;
    text-align: center;
    color: #986edf;
    font-size: clamp(7px, 0.65vw, 9px);
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.65;
    white-space: normal;
    padding: 0 12px;
    /* on hover-out: wait for email to finish fading before reappearing */
    transition: opacity 0.2s ease 0.28s;
  }

  .contact-btn:hover .contact-btn-label {
    opacity: 0;
    /* on hover-in: fade out immediately */
    transition: opacity 0.15s ease;
  }

  .contact-btn-email {
    position: absolute;
    color: rgba(152, 110, 223, 0.85);
    font-size: clamp(9px, 0.8vw, 11px);
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: lowercase;
    white-space: nowrap;
    opacity: 0;
    /* on hover-out: fade out quickly with no delay */
    transition: opacity 0.18s ease;
  }

  .contact-btn:hover .contact-btn-email {
    opacity: 1;
    /* on hover-in: fade in after shape has expanded */
    transition: opacity 0.25s ease 0.38s;
  }
</style>

<script>
  // ── Reveal on scroll ──
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target); // fire once
        }
      });
    },
    {
      threshold: 0.22,
      rootMargin: "0px 0px -40px 0px",
    }
  );

  document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));

  // ── Parallax + perspective on manifesto sections (desktop only) ──
  const isTouch = !window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  function applyParallax() {
    if (isTouch) return;
    const inners = document.querySelectorAll<HTMLElement>(".manifesto-inner.is-visible");
    const vh = window.innerHeight;

    inners.forEach((inner) => {
      const rect     = inner.getBoundingClientRect();
      const progress = (vh / 2 - (rect.top + rect.height / 2)) / vh;
      const clamped  = Math.max(-0.8, Math.min(0.8, progress));
      const translateY = clamped * -110;
      const rotateX    = clamped * 7;
      inner.style.transform = `perspective(900px) rotateX(${rotateX}deg) translateY(${translateY}px)`;
    });
  }

  // ── Horizontal scroll text ──
  const hscrollSection   = document.querySelector<HTMLElement>('.manifesto-block--green');
  const hscrollContainer = hscrollSection?.querySelector<HTMLElement>('.manifesto-hscroll');
  const hscrollText      = hscrollContainer?.querySelector<HTMLElement>('.manifesto-hscroll-text');

  let adItems: HTMLElement[] = [];

  if (hscrollSection && hscrollContainer && hscrollText) {
    adItems = Array.from(hscrollContainer.querySelectorAll<HTMLElement>('.ad-item'));
    const sortedByEntry = [...adItems].sort((a, b) =>
      parseFloat(a.dataset.threshold ?? '0') - parseFloat(b.dataset.threshold ?? '0')
    );
    sortedByEntry.forEach((item, i) => {
      item.dataset.exitThreshold = (0.74 + (i / (sortedByEntry.length - 1)) * 0.23).toFixed(3);
    });
    const textW = hscrollText.scrollWidth;
    const vpW   = window.innerWidth;
    const vpH   = window.innerHeight;
    hscrollSection.style.minHeight = `${textW + vpW + vpH}px`;
  }

  function applyHscroll() {
    if (!hscrollSection || !hscrollContainer || !hscrollText) return;
    const rect        = hscrollSection.getBoundingClientRect();
    const vh          = window.innerHeight;
    const sh          = hscrollSection.offsetHeight;
    const active      = rect.top < vh && rect.bottom > 0;
    hscrollContainer.style.opacity = active ? '1' : '0';
    const scrollRange = sh - vh;
    const progress    = Math.max(0, Math.min(1, -rect.top / scrollRange));
    const tw = hscrollText.scrollWidth;
    const vw = window.innerWidth;
    const tx = vw - progress * (vw + tw);
    hscrollText.style.transform = `translateX(${tx}px)`;
    adItems.forEach((item) => {
      const enter = parseFloat(item.dataset.threshold ?? '0');
      const exit  = parseFloat(item.dataset.exitThreshold ?? '1');
      item.classList.toggle('is-visible', progress >= enter && progress < exit);
    });
  }

  // ── Word scroll (i===3) ──
  const wordSection = document.querySelector<HTMLElement>('.manifesto-block--words');
  const wordOverlay = wordSection?.querySelector<HTMLElement>('.word-scroll-overlay');
  const wordEl      = wordOverlay?.querySelector<HTMLElement>('.word-scroll-word');
  const scrollWords   = ['That', 'made', 'the', 'work', 'slow,', 'expensive', 'and', 'shite.', 'Budgets', 'shrank.', 'Big', 'names', 'faded.'];
  const purpleWords   = new Set(['slow,', 'expensive', 'shite.', 'shrank.', 'faded.']);
  let wordIdx = -1;

  if (wordSection) {
    wordSection.style.minHeight = `${window.innerHeight * 3.2}px`;
  }

  function applyWordScroll() {
    if (!wordSection || !wordOverlay || !wordEl) return;
    const rect   = wordSection.getBoundingClientRect();
    const vh     = window.innerHeight;
    const sh     = wordSection.offsetHeight;
    const active = rect.top < vh && rect.bottom > 0;
    wordOverlay.classList.toggle('is-active', active);
    if (!active) { wordIdx = -1; return; }
    const scrollRange = sh - vh;
    const progress    = Math.max(0, Math.min(1, -rect.top / scrollRange));
    const raw         = Math.floor(progress * scrollWords.length);
    const idx         = Math.min(raw, scrollWords.length - 1);
    if (idx !== wordIdx) {
      wordIdx = idx;
      const isLast = idx === scrollWords.length - 1;
      wordEl.classList.remove('is-in');
      void wordEl.offsetWidth;
      const isPurple = purpleWords.has(scrollWords[idx]);
      wordEl.style.color = '';
      const letterColor = (char: string) =>
        isPurple && /[a-zA-Z]/.test(char) ? '#986edf' : '#e8e4de';
      if (isLast) {
        wordEl.innerHTML = '';
        scrollWords[idx].split('').forEach((char) => {
          const span = document.createElement('span');
          span.textContent = char;
          span.style.display = 'inline-block';
          span.style.color = letterColor(char);
          const dissolveDelay = (0.4 + Math.random() * 1.4).toFixed(2);
          const dissolveDur   = (0.2 + Math.random() * 0.4).toFixed(2);
          span.style.animation = `letter-appear 0.25s cubic-bezier(0.16,1,0.3,1) forwards, letter-dissolve ${dissolveDur}s ease-in ${dissolveDelay}s forwards`;
          wordEl.appendChild(span);
        });
      } else if (isPurple) {
        const m = scrollWords[idx].match(/^([a-zA-Z]+)([^a-zA-Z]*)$/);
        wordEl.innerHTML = m && m[2]
          ? `<span style="color:#986edf">${m[1]}</span><span style="color:#e8e4de">${m[2]}</span>`
          : `<span style="color:#986edf">${scrollWords[idx]}</span>`;
        wordEl.classList.add('is-in');
      } else {
        wordEl.style.color = '#e8e4de';
        wordEl.textContent = scrollWords[idx];
        wordEl.classList.add('is-in');
      }
    }
  }

  // ── Bigger section (i===4) ──
  const biggerSection  = document.querySelector<HTMLElement>('.manifesto-block--bigger');
  const biggerOverlay  = biggerSection?.querySelector<HTMLElement>('.bigger-overlay');
  const biggerInner    = biggerOverlay?.querySelector<HTMLElement>('.bigger-inner');
  const biggerTop      = biggerOverlay?.querySelector<HTMLElement>('.bigger-top');
  const biggerWordWrap = biggerOverlay?.querySelector<HTMLElement>('.bigger-word-wrap');
  const biggerStrike   = biggerOverlay?.querySelector<HTMLElement>('.bigger-strike');
  const biggerReplace  = biggerOverlay?.querySelector<HTMLElement>('.bigger-replace');
  const biggerTopText  = "Turns out the world doesn\u2019t need";
  if (biggerSection) {
    biggerSection.style.minHeight = `${window.innerHeight * 12}px`;
  }

  if (biggerTop) {
    biggerTopText.split('').forEach((char) => {
      const span = document.createElement('span');
      span.textContent = char === ' ' ? '\u00a0' : char;
      biggerTop.appendChild(span);
    });
  }

  // ── Calibrate BIGGER font-size to match top line width ──
  function calibrateBIGGERFontSize() {
    if (!biggerTop || !biggerWordWrap) return;
    const glyphs = Array.from(biggerWordWrap.querySelectorAll<HTMLElement>('.bigger-glyph'));
    if (!glyphs.length) return;
    glyphs.forEach(el => { el.style.fontSize = ''; }); // reset to CSS clamp before measuring
    const topW   = biggerTop.offsetWidth;
    const biggerW = biggerWordWrap.offsetWidth;
    if (topW <= 0 || biggerW <= 0) return;
    const currentFS = parseFloat(getComputedStyle(glyphs[0]).fontSize);
    const newFS = Math.round(currentFS * topW / biggerW);
    glyphs.forEach(el => { el.style.fontSize = `${newFS}px`; });
    natLetterHeights.length = 0; // clear cached cap metrics — font size changed
  }
  document.fonts.ready.then(calibrateBIGGERFontSize);
  window.addEventListener('resize', calibrateBIGGERFontSize, { passive: true });

  // Per-letter zone split: top 70% fixed, mid 11% stretchable, bot 19% fixed
  const TOP_FRAC = 0.70;
  const BOT_FRAC = 0.19;

  // Measure the actual ink bounds of Bebas Neue at a given fontSize using a canvas.
  // Returns { leadingPx, capHeight } relative to the CSS em-box top.
  function measureCapMetrics(fontSize: number): { leadingPx: number; capHeight: number } {
    const cv  = document.createElement('canvas');
    const cw  = Math.ceil(fontSize * 2);
    const ch  = Math.ceil(fontSize * 2.5);
    cv.width  = cw;
    cv.height = ch;
    const ctx = cv.getContext('2d')!;
    ctx.font      = `400 ${fontSize}px 'Bebas Neue', sans-serif`;
    ctx.fillStyle = '#fff';
    // Draw 'G' at baseline = 1.8 × fontSize so the full cap fits in frame
    const baseline = Math.round(fontSize * 1.8);
    ctx.fillText('G', 2, baseline);
    const { data } = ctx.getImageData(0, 0, cw, ch);
    let inkTop = ch, inkBot = 0;
    for (let y = 0; y < ch; y++)
      for (let x = 0; x < cw; x++)
        if (data[(y * cw + x) * 4 + 3] > 10) {
          if (y < inkTop) inkTop = y;
          if (y > inkBot) inkBot = y;
        }
    // Bebas Neue is all-caps: ink bottom ≈ baseline.
    // CSS em-box top = baseline - ascender × fontSize (ascender ≈ 0.80 for Bebas Neue).
    const cssEmTop  = baseline - Math.round(fontSize * 0.80);
    const leadingPx = Math.max(0, inkTop - cssEmTop);
    const capHeight = inkBot - inkTop + 1;
    return { leadingPx, capHeight };
  }

  const natLetterHeights: number[] = [];

  // Pre-compute seeded random cut directions for each letter in BIGGER (6 letters)
  const _sr = (n: number) => (Math.abs(Math.sin(n * 127.1 + 311.7)) * 43758.5453) % 1;
  const cutDirections = Array.from({ length: 6 }, (_, i) => ({
    topX: (_sr(i * 7 + 0) - 0.5) * 340,      // ±170px horizontal
    topY: -(_sr(i * 7 + 1) * 200 + 120),      // −120 to −320px (flies up)
    topR: (_sr(i * 7 + 2) - 0.5) * 100,       // ±50deg rotation
    botX: (_sr(i * 7 + 3) - 0.5) * 340,       // ±170px horizontal
    botY:  _sr(i * 7 + 4) * 200 + 120,        // +120 to +320px (flies down)
    botR: (_sr(i * 7 + 5) - 0.5) * 100,       // ±50deg rotation
  }));

  function applyBiggerSection() {
    if (!biggerSection || !biggerOverlay || !biggerWordWrap || !biggerTop) return;
    const rect   = biggerSection.getBoundingClientRect();
    const vh     = window.innerHeight;
    const sh     = biggerSection.offsetHeight;
    const active = rect.top < vh && rect.bottom > 0;
    biggerOverlay.classList.toggle('is-active', active);
    if (!active) return;

    const scrollRange = sh - vh;
    const progress    = Math.max(0, Math.min(1, -rect.top / scrollRange));

    // Top line: letters slide in — gated at 0.03 min so 'T' never appears alone
    const topLetters = Array.from(biggerTop.children) as HTMLElement[];
    topLetters.forEach((el, i) => {
      const threshold = 0.03 + (i / Math.max(topLetters.length - 1, 1)) * 0.06;
      const visible   = progress >= threshold;
      el.style.opacity   = visible ? '1' : '0';
      el.style.transform = visible ? 'translateX(0)' : 'translateX(-14px)';
    });

    // "Turns out…" and BIGGER travel up together until top line exits viewport (0.40 → 0.62)
    const topExitLocal = Math.max(0, Math.min(1, (progress - 0.40) / 0.22));
    const topExitE     = topExitLocal * topExitLocal; // ease-in: accelerates upward
    const topLineH     = biggerTop.offsetHeight;
    // Translate the full inner block — both lines move as one unit
    if (biggerInner) {
      biggerInner.style.transform = `translateY(-${topExitE * (vh * 0.5 + topLineH)}px)`;
    }
    // Keep top line fully opaque — no fade, it just travels out of frame

    // BIGGER fade-in (0.04); fades out after cut (0.78 → 0.82)
    const biggerFadeOut = Math.max(0, Math.min(1, (progress - 0.78) / 0.04));
    biggerWordWrap.style.opacity = progress >= 0.04 ? String(1 - biggerFadeOut) : '0';

    // Mid zone stretches: progress 0.10 → 0.55
    const stretchLocal = Math.max(0, Math.min(1, (progress - 0.10) / 0.45));
    const sy = 1 + stretchLocal * 14;

    // Red strikethrough — only after "Turns out…" is gone (0.65 → 0.76), fades out (0.76 → 0.80)
    const strikeP    = Math.max(0, Math.min(1, (progress - 0.65) / 0.11));
    const strikeOutP = Math.max(0, Math.min(1, (progress - 0.76) / 0.04));
    if (biggerStrike) {
      const wordAreaTop = biggerStrike.parentElement!.getBoundingClientRect().top;
      biggerStrike.style.width   = `${strikeP * 100}%`;
      biggerStrike.style.opacity = String(1 - strikeOutP);
      biggerStrike.style.top     = `${vh / 2 - wordAreaTop}px`;
    }

    // "It needs better." fades in after strike (0.78 → 0.86)
    if (biggerReplace) {
      const replaceP = Math.max(0, Math.min(1, (progress - 0.78) / 0.08));
      biggerReplace.style.opacity = String(replaceP);
    }

    const wraps = Array.from(biggerWordWrap.querySelectorAll<HTMLElement>('.bigger-letter-wrap'));
    wraps.forEach((wrap, i) => {
      const topZone  = wrap.children[0] as HTMLElement;
      const midZone  = wrap.children[1] as HTMLElement;
      const botZone  = wrap.children[2] as HTMLElement;
      const topGlyph = topZone?.firstElementChild as HTMLElement;
      const midGlyph = midZone?.firstElementChild as HTMLElement;
      const botGlyph = botZone?.firstElementChild as HTMLElement;
      if (!topGlyph || !midGlyph || !botGlyph) return;

      // Cache natural height + set static glyph offsets once per letter
      if (!natLetterHeights[i]) {
        const fontSize = parseFloat(getComputedStyle(topGlyph).fontSize);
        const { leadingPx, capHeight } = measureCapMetrics(fontSize);
        natLetterHeights[i] = capHeight; // natH = actual measured cap height
        const nh = natLetterHeights[i];
        const tH = Math.round(nh * TOP_FRAC);
        const mH = Math.round(nh * (1 - TOP_FRAC - BOT_FRAC));
        // Overlap in px: top/bot zones extend this many px into the mid zone
        // so the seam never cuts through a curve
        const ov = Math.round(nh * 0.04);
        // Shift all glyphs up so cap-top aligns with each zone's top edge
        topGlyph.style.top = `-${leadingPx}px`;
        // Top zone eats into mid zone by ov px; negative margin keeps layout tight
        topZone.style.marginBottom = `-${ov}px`;
        // Mid glyph: show the 11% cap strip and stretch it downward from its top edge
        midGlyph.style.top             = `-${leadingPx + tH}px`;
        midGlyph.style.transformOrigin = `50% ${leadingPx + tH}px`;
        // Bot zone starts ov px earlier into mid zone; negative margin keeps layout tight
        botGlyph.style.top = `-${leadingPx + tH + mH - ov}px`;
        botZone.style.marginTop = `-${ov}px`;
      }

      const natH = natLetterHeights[i];
      const topH = Math.round(natH * TOP_FRAC);
      const botH = Math.round(natH * BOT_FRAC);
      const midH = natH - topH - botH;

      // Phase 1 — reveal top→mid→bot, staggered by letter (progress 0.04 → 0.18)
      const revealStart = 0.04 + i * 0.01;
      const revealLocal = Math.max(0, Math.min(1, (progress - revealStart) / 0.10));
      const revealEased = 1 - Math.pow(1 - revealLocal, 3);
      const revealH     = revealEased * natH;

      const ov        = Math.round(natH * 0.04);
      const rawTopH   = Math.round(Math.min(revealH, topH));
      // Once top is fully revealed, extend it by ov px into mid zone
      const topZoneH  = revealH >= topH ? rawTopH + ov : rawTopH;
      const midReveal = Math.max(0, Math.min(1, (revealH - topH) / midH));
      const midZoneH  = Math.round(midReveal * midH * sy);

      topZone.style.height = `${topZoneH}px`;
      midZone.style.height = `${midZoneH}px`;
      // Bottom zone always full height + overlap so it extends ov px into mid zone
      botZone.style.height = `${botH + ov}px`;
      midGlyph.style.transform = `scaleY(${sy})`;

      // Per-letter cut: as red line passes each letter, halves fly apart dramatically
      if (strikeP > 0 && biggerWordWrap) {
        const wrapRect   = wrap.getBoundingClientRect();
        const wwRect     = biggerWordWrap.getBoundingClientRect();
        const letterMidX = wrapRect.left - wwRect.left + wrapRect.width * 0.5;
        const lineX      = strikeP * biggerWordWrap.offsetWidth;
        // 0 = line hasn't reached this letter, 1 = fully cut (transition over 25% of letter width)
        const cutP = Math.max(0, Math.min(1, (lineX - letterMidX) / (wrapRect.width * 0.25)));
        if (cutP > 0) {
          // Ease-in-cubic: pieces accelerate as they fly
          const cutE = cutP * cutP * cutP;
          const dir  = cutDirections[i];
          // Collapse the mid zone immediately so no stretched strip shows between the flying halves
          midZone.style.height = `${Math.round(midZoneH * Math.max(0, 1 - cutP * 4))}px`;
          topZone.style.transform = `translate(${dir.topX * cutE}px, ${dir.topY * cutE}px) rotate(${dir.topR * cutE}deg)`;
          botZone.style.transform = `translate(${dir.botX * cutE}px, ${dir.botY * cutE}px) rotate(${dir.botR * cutE}deg)`;
        } else {
          topZone.style.transform = '';
          botZone.style.transform = '';
        }
      } else {
        topZone.style.transform = '';
        botZone.style.transform = '';
      }
    });
  }

  // ── Grid overlay: stays viewport-aligned, lines purple → dark as section scrolls in ──
  const thirdSection   = document.querySelector<HTMLElement>('.manifesto-block--third');
  const thirdGridSvg   = document.querySelector<SVGSVGElement>('.third-grid');
  const thirdGridGroup = document.querySelector<SVGGElement>('.third-grid-lines');

  function applyGridColor() {
    if (!thirdSection || !thirdGridSvg || !thirdGridGroup) return;
    const rect = thirdSection.getBoundingClientRect();
    const vh   = window.innerHeight;
    if (!isTouch) thirdGridSvg.style.transform = `translateY(${-rect.top}px)`;
    const progress = Math.max(0, Math.min(1, (vh - rect.top) / vh));
    const r = Math.round(0x98 + (0x1a - 0x98) * progress);
    const g = Math.round(0x6e + (0x1a - 0x6e) * progress);
    const b = Math.round(0xdf + (0x1a - 0xdf) * progress);
    thirdGridGroup.style.stroke = `rgb(${r},${g},${b})`;
  }

  // ── Single RAF-throttled scroll handler ──
  function runScrollHandlers() {
    if (hscrollSection && hscrollContainer && hscrollText) applyHscroll();
    applyParallax();
    applyWordScroll();
    applyBiggerSection();
    applyGridColor();
  }

  let scrollRaf = 0;
  window.addEventListener("scroll", () => {
    if (scrollRaf) return;
    scrollRaf = requestAnimationFrame(() => {
      runScrollHandlers();
      scrollRaf = 0;
    });
  }, { passive: true });

  runScrollHandlers();

</script>

<style>
  /* Parallax transform applied directly via JS — no transition so it tracks scroll instantly */
  .manifesto-inner.is-visible {
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Prevent the parallax transform competing with line transitions */
  .manifesto-inner.is-visible .manifesto-line,
  .manifesto-inner--finale.is-visible .manifesto-finale {
    transform: none;
  }
</style>

<script>
  const burstWord  = document.querySelector('.burst-word');
  const burstLayer = document.querySelector<HTMLElement>('.burst-layer');

  if (burstWord && burstLayer) {
    const word = burstWord as Element;
    function rand(a: number, b: number) { return a + Math.random() * (b - a); }

    const FILL_COLORS = ['#e8e4de', '#986edf', '#1a5c3a'];
    const BG = `fill="none"`;
    const S  = `stroke="#1a1a1a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"`;
    const H  = `<circle cx="20" cy="20" r="17" ${BG}/>`;   // filled head
    const FACES = [
      // WOW — round eyes, raised brows, O-mouth
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M9,10 Q13,7 17,10"/><path d="M23,10 Q27,7 31,10"/><circle cx="13" cy="16" r="3.5"/><circle cx="27" cy="16" r="3.5"/><ellipse cx="20" cy="27" rx="5" ry="5.5"/></svg>`,
      // LAUGHING — squint eyes, open grin
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M9,15 Q13,10 17,15"/><path d="M23,15 Q27,10 31,15"/><path d="M10,23 Q15,21 20,22 Q25,21 30,23"/><path d="M10,23 Q20,36 30,23"/></svg>`,
      // SHOCKED — rect eyes, raised brows, oval mouth
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M9,10 Q13,7 17,10"/><path d="M23,10 Q27,7 31,10"/><rect x="10" y="12" width="8" height="7" rx="1"/><rect x="22" y="12" width="8" height="7" rx="1"/><ellipse cx="20" cy="28" rx="5" ry="5.5"/></svg>`,
      // THINKING — one raised brow, eyes looking up, chin touch
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M9,13 Q13,10 17,13"/><path d="M22,11 Q27,8 31,12"/><circle cx="13" cy="17" r="2.5"/><circle cx="27" cy="15" r="2.5"/><path d="M15,27 Q18,25 22,26"/><path d="M26,31 Q28,29 30,27"/></svg>`,
      // CRAZY — swirl eye + X eye, wavy grin
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<circle cx="13" cy="16" r="5"/><circle cx="13" cy="16" r="2"/><path d="M23,11 L31,21"/><path d="M31,11 L23,21"/><path d="M9,27 Q12,24 15,27 Q18,30 21,27 Q24,24 27,27"/></svg>`,
      // SMUG — arched brow, hooded eye, lopsided smirk
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M9,12 Q13,9 17,12"/><path d="M22,10 Q27,8 31,12"/><circle cx="13" cy="17" r="2.5"/><circle cx="27" cy="16" r="2.5"/><path d="M24,13.5 Q27,12 30,13.5"/><path d="M13,26 Q18,24 22,26 Q26,29 28,27"/></svg>`,
      // STAR-EYED — asterisk eyes, big smile
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M13,10.5 L13,20.5 M8,15.5 L18,15.5 M9.5,12 L16.5,19 M16.5,12 L9.5,19"/><path d="M27,10.5 L27,20.5 M22,15.5 L32,15.5 M23.5,12 L30.5,19 M30.5,12 L23.5,19"/><path d="M10,26 Q20,36 30,26"/></svg>`,
      // DISGUSTED — furrowed brows, squinted lines, frown
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M9,14 Q13,17 17,14"/><path d="M23,14 Q27,17 31,14"/><line x1="10" y1="17" x2="16" y2="17"/><line x1="24" y1="17" x2="30" y2="17"/><path d="M12,28 Q20,23 28,28"/></svg>`,
    ];

    function spawnBurst() {
      const rect = word.getBoundingClientRect();

      for (let i = 0; i < 8; i++) {
        const size = rand(48, 72);
        const el   = document.createElement('div');
        const bgColor = FILL_COLORS[Math.floor(Math.random() * FILL_COLORS.length)];
        el.style.cssText = `position:fixed;pointer-events:none;z-index:9998;width:${size}px;height:${size}px;top:0;left:0;border-radius:50%;background:${bgColor};`;
        el.innerHTML = FACES[Math.floor(Math.random() * FACES.length)];
        document.body.appendChild(el);

        let x   = rect.left + rand(0, rect.width)  - size / 2;
        let y   = rect.top  + rand(-6, 6)           - size / 2;
        let vx  = rand(-2, 2);
        let vy  = rand(-7, -4);
        let rot = rand(0, 360);
        const vr = rand(-1.5, 1.5);
        (function tick() {
          vy  += 0.1;
          x   += vx;
          y   += vy;
          rot += vr;
          el.style.transform = `translate(${x}px,${y}px) rotate(${rot}deg)`;
          if (y < window.innerHeight + size) requestAnimationFrame(tick);
          else el.remove();
        })();
      }
    }

    word.addEventListener('mouseenter', spawnBurst);
  }
</script>
