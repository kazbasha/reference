<script>
  import * as THREE from 'three';
  import { GLTFLoader }     from 'three/examples/jsm/loaders/GLTFLoader.js';
  import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';


  // ── Reveal on scroll ──
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target); // fire once
        }
      });
    },
    {
      threshold: 0.22,
      rootMargin: "0px 0px -40px 0px",
    }
  );

  document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));

  // ── Parallax + perspective on manifesto sections (desktop only) ──
  const isTouch = !window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  function applyParallax() {
    if (isTouch) return;
    const inners = document.querySelectorAll<HTMLElement>(".manifesto-inner.is-visible");
    const vh = window.innerHeight;

    inners.forEach((inner) => {
      const rect     = inner.getBoundingClientRect();
      const progress = (vh / 2 - (rect.top + rect.height / 2)) / vh;
      const clamped  = Math.max(-0.8, Math.min(0.8, progress));
      const translateY = clamped * -110;
      const rotateX    = clamped * 7;
      inner.style.transform = `perspective(900px) rotateX(${rotateX}deg) translateY(${translateY}px)`;
    });
  }

  // ── Intro slider (i===5) ──
  {
    const track   = document.querySelector<HTMLElement>('.intro-slides-track');
    const prevBtn = document.querySelector<HTMLButtonElement>('.intro-slider-prev');
    const nextBtn = document.querySelector<HTMLButtonElement>('.intro-slider-next');
    const counter = document.querySelector<HTMLElement>('.intro-slider-counter');
    const total   = 5;
    let   current = 0;

    function goTo(idx: number) {
      current = Math.max(0, Math.min(total - 1, idx));
      // Measure the first slide's actual rendered width so the offset is correct
      // regardless of whether slides are 85% (desktop) or 100% (mobile) wide.
      const firstSlide = track?.children[0] as HTMLElement | undefined;
      const slideW = firstSlide?.offsetWidth ?? (track?.parentElement as HTMLElement)?.offsetWidth ?? 0;
      if (track) track.style.transform = `translateX(-${current * slideW}px)`;
      if (counter) counter.textContent = `${String(current + 1).padStart(2,'0')} / ${String(total).padStart(2,'0')}`;
      if (prevBtn) prevBtn.disabled = current === 0;
      if (nextBtn) nextBtn.disabled = current === total - 1;
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    goTo(0);

    window.addEventListener('resize', () => goTo(current), { passive: true });
  }

  // ── Horizontal scroll text ──
  const hscrollSection   = document.querySelector<HTMLElement>('.manifesto-block--green');
  const hscrollContainer = hscrollSection?.querySelector<HTMLElement>('.manifesto-hscroll');
  const hscrollText      = hscrollContainer?.querySelector<HTMLElement>('.manifesto-hscroll-text');

  let adItems: HTMLElement[] = [];

  if (hscrollSection && hscrollContainer && hscrollText) {
    adItems = Array.from(hscrollContainer.querySelectorAll<HTMLElement>('.ad-item'));
    const sortedByEntry = [...adItems].sort((a, b) =>
      parseFloat(a.dataset.threshold ?? '0') - parseFloat(b.dataset.threshold ?? '0')
    );
    sortedByEntry.forEach((item, i) => {
      item.dataset.exitThreshold = (0.74 + (i / (sortedByEntry.length - 1)) * 0.23).toFixed(3);
    });
    const textW = hscrollText.scrollWidth;
    const vpW   = window.innerWidth;
    const vpH   = window.innerHeight;
    hscrollSection.style.minHeight = `${textW + vpW + vpH}px`;
  }

  function applyHscroll() {
    if (!hscrollSection || !hscrollContainer || !hscrollText) return;
    const rect        = hscrollSection.getBoundingClientRect();
    const vh          = window.innerHeight;
    const sh          = hscrollSection.offsetHeight;
    const active      = rect.top < vh && rect.bottom > 0;
    hscrollContainer.style.opacity = active ? '1' : '0';
    const scrollRange = sh - vh;
    const progress    = Math.max(0, Math.min(1, -rect.top / scrollRange));
    const tw = hscrollText.scrollWidth;
    const vw = window.innerWidth;
    const tx = vw - progress * (vw + tw);
    hscrollText.style.transform = `translateX(${tx}px)`;
    adItems.forEach((item) => {
      const enter = parseFloat(item.dataset.threshold ?? '0');
      const exit  = parseFloat(item.dataset.exitThreshold ?? '1');
      item.classList.toggle('is-visible', progress >= enter && progress < exit);
    });
  }

  // ── Word scroll (i===3) ──
  const wordSection  = document.querySelector<HTMLElement>('.manifesto-block--words');
  const wordOverlay  = wordSection?.querySelector<HTMLElement>('.word-scroll-overlay');
  const wordEl       = wordOverlay?.querySelector<HTMLElement>('.word-scroll-word');
  const wslContainer = wordOverlay?.querySelector<HTMLElement>('.word-scroll-lines');
  const wslLine1     = wslContainer?.querySelector<HTMLElement>('.wsl-line--1');
  const wslLine2     = wslContainer?.querySelector<HTMLElement>('.wsl-line--2');
  const scrollWords  = ['That', 'made', 'the', 'work', 'slow,', 'expensive', 'and', 'shite.'];
  const purpleWords  = new Set(['slow,', 'expensive', 'shite.']);
  let wordIdx  = -1;
  let inLines  = false;
  let inFading = false;
  const WORD_END = 0.5;

  // Build word/letter spans; periods are purple
  function buildWslLine(el: HTMLElement, text: string) {
    el.innerHTML = '';
    text.split(' ').forEach((word, wi, arr) => {
      const wordSpan = document.createElement('span');
      wordSpan.className = 'wsl-word';
      word.split('').forEach((char) => {
        const ls = document.createElement('span');
        ls.className = 'wsl-letter';
        ls.textContent = char;
        if (char === '.') ls.style.color = '#986edf';
        wordSpan.appendChild(ls);
      });
      if (wi < arr.length - 1) wordSpan.appendChild(document.createTextNode('\u00a0'));
      el.appendChild(wordSpan);
    });
  }

  if (wslLine1) buildWslLine(wslLine1, 'Budgets shrank.');
  if (wslLine2) buildWslLine(wslLine2, 'Big names faded.');

  // All word spans across both lines
  const wslWords = [
    ...(wslLine1 ? Array.from(wslLine1.querySelectorAll<HTMLElement>('.wsl-word')) : []),
    ...(wslLine2 ? Array.from(wslLine2.querySelectorAll<HTMLElement>('.wsl-word')) : []),
  ];
  // Time-based stagger (ms): Budgets, shrank., [gap], Big, names, faded.
  const wslDelays = [0, 320, 900, 1200, 1500];
  let wslTimers: ReturnType<typeof setTimeout>[] = [];

  if (wordSection) {
    wordSection.style.minHeight = `${window.innerHeight * 5.5}px`;
  }

  function startWslSequence() {
    // Pin every word to its hidden state with no transition
    wslWords.forEach((w) => {
      w.style.transition = 'none';
      w.style.opacity    = '0';
      w.style.transform  = 'translateY(10px)';
    });
    // Double-RAF: let the browser paint the hidden state before any transition starts
    requestAnimationFrame(() => requestAnimationFrame(() => {
      wslWords.forEach((w, i) => {
        const t = setTimeout(() => {
          w.style.transition = 'opacity 0.45s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1)';
          w.style.opacity    = '1';
          w.style.transform  = 'translateY(0)';
        }, wslDelays[i]);
        wslTimers.push(t);
      });
    }));
  }

  function triggerLetterDissolve() {
    if (!wslContainer) return;
    const letters = Array.from(wslContainer.querySelectorAll<HTMLElement>('.wsl-letter'));
    const delays  = letters.map(() => Math.random());
    const max     = Math.max(...delays);
    letters.forEach((l, i) => {
      const t = (delays[i] / max * 0.9).toFixed(2);
      l.style.animation = `letter-dissolve 0.25s ease-in ${t}s forwards`;
    });
  }

  function resetWslWords() {
    wslTimers.forEach(clearTimeout);
    wslTimers = [];
    wslWords.forEach((w) => {
      w.style.transition = 'none';
      w.style.opacity    = '0';
      w.style.transform  = 'translateY(10px)';
    });
    wslContainer?.querySelectorAll<HTMLElement>('.wsl-letter').forEach((l) => { l.style.animation = ''; });
  }

  function applyWordScroll() {
    if (!wordSection || !wordOverlay || !wordEl) return;
    const rect   = wordSection.getBoundingClientRect();
    const vh     = window.innerHeight;
    const sh     = wordSection.offsetHeight;
    const active = rect.top < vh && rect.bottom > 0;
    wordOverlay.classList.toggle('is-active', active);
    if (!active) {
      wordIdx = -1; inLines = false; inFading = false;
      wordEl.style.display = '';
      if (wslContainer) wslContainer.style.display = 'none';
      return;
    }
    const scrollRange = sh - vh;
    const progress    = Math.max(0, Math.min(1, -rect.top / scrollRange));

    if (progress >= WORD_END) {
      // ── Two-line ending phase ──
      if (!inLines) {
        inLines = true;
        wordIdx = -1;
        wordEl.innerHTML = '';
        wordEl.classList.remove('is-in');
        wordEl.style.display = 'none';
        if (wslContainer) wslContainer.style.display = 'flex';
        startWslSequence();
      }
      const lP = (progress - WORD_END) / (1 - WORD_END);

      const shouldFade = lP >= 0.84;
      if (shouldFade && !inFading) {
        inFading = true;
        triggerLetterDissolve();
      } else if (!shouldFade && inFading) {
        inFading = false;
        wslContainer?.querySelectorAll<HTMLElement>('.wsl-letter').forEach((l) => { l.style.animation = ''; });
      }
    } else {
      // ── Word phase ──
      if (inLines) {
        inLines  = false;
        inFading = false;
        wordEl.style.display = '';
        if (wslContainer) wslContainer.style.display = 'none';
        resetWslWords();
      }
      const wordProgress = progress / WORD_END;
      const raw = Math.floor(wordProgress * scrollWords.length);
      const idx = Math.min(raw, scrollWords.length - 1);
      if (idx !== wordIdx) {
        wordIdx = idx;
        const isLast  = idx === scrollWords.length - 1;
        wordEl.classList.remove('is-in');
        void wordEl.offsetWidth;
        const isPurple = purpleWords.has(scrollWords[idx]);
        if (isLast) {
          wordEl.innerHTML = '';
          scrollWords[idx].split('').forEach((char) => {
            const span = document.createElement('span');
            span.textContent = char;
            span.style.display = 'inline-block';
            span.style.color = /[a-zA-Z]/.test(char) ? '#986edf' : '#e8e4de';
            const dDelay = (0.3 + Math.random() * 0.8).toFixed(2);
            const dDur   = (0.2 + Math.random() * 0.25).toFixed(2);
            span.style.animation = `letter-appear 0.22s cubic-bezier(0.16,1,0.3,1) forwards, letter-dissolve ${dDur}s ease-in ${dDelay}s forwards`;
            wordEl.appendChild(span);
          });
        } else if (isPurple) {
          const m = scrollWords[idx].match(/^([a-zA-Z]+)([^a-zA-Z]*)$/);
          wordEl.innerHTML = m && m[2]
            ? `<span style="color:#986edf">${m[1]}</span><span style="color:#e8e4de">${m[2]}</span>`
            : `<span style="color:#986edf">${scrollWords[idx]}</span>`;
          wordEl.classList.add('is-in');
        } else {
          wordEl.style.color = '#e8e4de';
          wordEl.textContent = scrollWords[idx];
          wordEl.classList.add('is-in');
        }
      }
    }
  }

  // ── Bigger section (i===4) ──
  const biggerSection  = document.querySelector<HTMLElement>('.manifesto-block--bigger');
  const biggerOverlay  = biggerSection?.querySelector<HTMLElement>('.bigger-overlay');
  const biggerInner    = biggerOverlay?.querySelector<HTMLElement>('.bigger-inner');
  const biggerTop      = biggerOverlay?.querySelector<HTMLElement>('.bigger-top');
  const biggerWordWrap = biggerOverlay?.querySelector<HTMLElement>('.bigger-word-wrap');
  const biggerReplace  = biggerOverlay?.querySelector<HTMLElement>('.bigger-replace');
  const biggerHaze     = biggerOverlay?.querySelector<HTMLElement>('.bigger-haze');
  const biggerTopText  = "Turns out the world doesn\u2019t need";
  if (biggerSection) {
    biggerSection.style.minHeight = `${window.innerHeight * 12}px`;
  }

  if (biggerTop) {
    // Word-level spans so each word is an individual hit target
    biggerTopText.split(' ').forEach((word, wi) => {
      if (wi > 0) {
        const sp = document.createElement('span');
        sp.textContent = '\u00a0';
        biggerTop.appendChild(sp);
      }
      const ws = document.createElement('span');
      ws.className = 'bigger-top-word';
      ws.textContent = word;
      biggerTop.appendChild(ws);
    });
  }

  // Split "It needs better." into word spans for staggered reveal
  if (biggerReplace) {
    const words = (biggerReplace.textContent ?? '').trim().split(' ');
    biggerReplace.textContent = '';
    biggerReplace.style.opacity = '1'; // container always visible; spans control reveal
    words.forEach((word, wi) => {
      if (wi > 0) biggerReplace.appendChild(document.createTextNode('\u00a0'));
      const ws = document.createElement('span');
      ws.textContent = word;
      ws.style.cssText = 'display:inline-block;opacity:0;transform:translateX(-14px);';
      biggerReplace.appendChild(ws);
    });
  }

  // ── Calibrate BIGGER font-size to match top line width ──
  function calibrateBIGGERFontSize() {
    if (!biggerTop || !biggerWordWrap) return;
    const glyphs = Array.from(biggerWordWrap.querySelectorAll<HTMLElement>('.bigger-glyph'));
    if (!glyphs.length) return;
    glyphs.forEach(el => { el.style.fontSize = ''; });
    const topW   = biggerTop.offsetWidth;
    const biggerW = biggerWordWrap.offsetWidth;
    if (topW <= 0 || biggerW <= 0) return;
    const currentFS = parseFloat(getComputedStyle(glyphs[0]).fontSize);
    const newFS = Math.round(currentFS * topW / biggerW);
    glyphs.forEach(el => { el.style.fontSize = `${newFS}px`; });
    natLetterHeights.length = 0;
  }
  document.fonts.ready.then(calibrateBIGGERFontSize);
  window.addEventListener('resize', calibrateBIGGERFontSize, { passive: true });
  (window as any).__calibrateBIGGER = calibrateBIGGERFontSize;

  const TOP_FRAC = 0.70;
  const BOT_FRAC = 0.19;

  function measureCapMetrics(fontSize: number): { leadingPx: number; capHeight: number } {
    const cv  = document.createElement('canvas');
    const cw  = Math.ceil(fontSize * 2);
    const ch  = Math.ceil(fontSize * 2.5);
    cv.width  = cw;
    cv.height = ch;
    const ctx = cv.getContext('2d')!;
    ctx.font      = `400 ${fontSize}px 'Bebas Neue', sans-serif`;
    ctx.fillStyle = '#fff';
    const baseline = Math.round(fontSize * 1.8);
    ctx.fillText('G', 2, baseline);
    const { data } = ctx.getImageData(0, 0, cw, ch);
    let inkTop = ch, inkBot = 0;
    for (let y = 0; y < ch; y++)
      for (let x = 0; x < cw; x++)
        if (data[(y * cw + x) * 4 + 3] > 10) {
          if (y < inkTop) inkTop = y;
          if (y > inkBot) inkBot = y;
        }
    const cssEmTop  = baseline - Math.round(fontSize * 0.80);
    const leadingPx = Math.max(0, inkTop - cssEmTop);
    const capHeight = inkBot - inkTop + 1;
    return { leadingPx, capHeight };
  }

  const natLetterHeights: number[] = [];

  const _sr = (n: number) => (Math.abs(Math.sin(n * 127.1 + 311.7)) * 43758.5453) % 1;
  const cutDirections = Array.from({ length: 6 }, (_, i) => ({
    topX: (_sr(i * 7 + 0) - 0.5) * 340,
    topY: -(_sr(i * 7 + 1) * 200 + 120),
    topR: (_sr(i * 7 + 2) - 0.5) * 100,
    botX: (_sr(i * 7 + 3) - 0.5) * 340,
    botY:  _sr(i * 7 + 4) * 200 + 120,
    botR: (_sr(i * 7 + 5) - 0.5) * 100,
  }));

  function applyBiggerSection() {
    if (!biggerSection || !biggerOverlay || !biggerWordWrap || !biggerTop) return;
    const rect   = biggerSection.getBoundingClientRect();
    const vh     = window.innerHeight;
    const sh     = biggerSection.offsetHeight;
    const active = rect.top < vh && rect.bottom > 0;
    biggerOverlay.classList.toggle('is-active', active);
    if (!active) return;

    const scrollRange = sh - vh;
    const progress    = Math.max(0, Math.min(1, -rect.top / scrollRange));

    // Top line fades out before "It needs better" appears at 0.78
    const topFadeOut = Math.max(0, Math.min(1, (progress - 0.74) / 0.04));
    const topLetters = Array.from(biggerTop.children) as HTMLElement[];
    topLetters.forEach((el, i) => {
      if (el.classList.contains('is-ejected')) return; // word already shot off
      const threshold = 0.03 + (i / Math.max(topLetters.length - 1, 1)) * 0.06;
      const visible   = progress >= threshold;
      el.style.opacity   = visible ? String(1 - topFadeOut) : '0';
      el.style.transform = visible ? 'translateX(0)' : 'translateX(-14px)';
    });


    const biggerFadeOut = Math.max(0, Math.min(1, (progress - 0.78) / 0.04));
    // BIGGER fades in smoothly once top line is fully in (~0.09)
    const wrapReveal = Math.max(0, Math.min(1, (progress - 0.12) / 0.04));
    biggerWordWrap.style.opacity = String(wrapReveal * (1 - biggerFadeOut));

    // Stretch only starts once BIGGER is fully revealed (~0.28)
    // Cap sy so BIGGER fills viewport from its natural position to ~40px from bottom
    const stretchLocal = Math.max(0, Math.min(1, (progress - 0.28) / 0.40));
    const natH0    = natLetterHeights[0] || 1;
    const topH0    = Math.round(natH0 * TOP_FRAC);
    const botH0    = Math.round(natH0 * BOT_FRAC);
    const midH0    = natH0 - topH0 - botH0;
    const wwTop    = biggerWordWrap.getBoundingClientRect().top;
    const availH   = vh - wwTop - 40;
    const syCap    = Math.max(1, (availH - topH0 - botH0) / midH0);
    const sy       = 1 + stretchLocal * (syCap - 1);

    // Top line starts centered, floats up to top as BIGGER grows
    if (biggerInner) {
      const overlayPadTop = parseFloat(getComputedStyle(biggerOverlay).paddingTop);
      const centerOffset  = Math.max(0, vh * 0.35 - (biggerTop?.offsetHeight ?? 0) / 2 - overlayPadTop);
      const ty = centerOffset * (1 - stretchLocal);
      biggerInner.style.transform = `translateY(${ty}px)`;
    }

    // Atmosphere: rays + haze build in as BIGGER reveals, fade after strike
    const atmosIn  = Math.max(0, Math.min(1, (progress - 0.10) / 0.18));
    const atmosOut = Math.max(0, Math.min(1, (progress - 0.76) / 0.06));
    const atmosA   = atmosIn * (1 - atmosOut);
    if (biggerHaze) biggerHaze.style.opacity = String(atmosA);


    if (biggerReplace) {
      const replaceWords = Array.from(biggerReplace.children) as HTMLElement[];
      // Stagger: first word starts at 0.78, last word starts at 0.90, each takes 0.06 to fully reveal
      replaceWords.forEach((word, i) => {
        const start = 0.78 + (i / Math.max(replaceWords.length - 1, 1)) * 0.12;
        const p     = Math.max(0, Math.min(1, (progress - start) / 0.06));
        word.style.opacity   = String(p);
        word.style.transform = `translateX(${(1 - p) * -14}px)`;
      });
    }

    const wraps = Array.from(biggerWordWrap.querySelectorAll<HTMLElement>('.bigger-letter-wrap'));
    wraps.forEach((wrap, i) => {
      const topZone  = wrap.children[0] as HTMLElement;
      const midZone  = wrap.children[1] as HTMLElement;
      const botZone  = wrap.children[2] as HTMLElement;
      const topGlyph = topZone?.firstElementChild as HTMLElement;
      const midGlyph = midZone?.firstElementChild as HTMLElement;
      const botGlyph = botZone?.firstElementChild as HTMLElement;
      if (!topGlyph || !midGlyph || !botGlyph) return;

      if (!natLetterHeights[i]) {
        const fontSize = parseFloat(getComputedStyle(topGlyph).fontSize);
        const { leadingPx, capHeight } = measureCapMetrics(fontSize);
        natLetterHeights[i] = capHeight;
        const nh = natLetterHeights[i];
        const tH = Math.round(nh * TOP_FRAC);
        const mH = Math.round(nh * (1 - TOP_FRAC - BOT_FRAC));
        const ov = Math.round(nh * 0.04);
        topGlyph.style.top = `-${leadingPx}px`;
        topZone.style.marginBottom = `-${ov}px`;
        midGlyph.style.top             = `-${leadingPx + tH}px`;
        midGlyph.style.transformOrigin = `50% ${leadingPx + tH}px`;
        botGlyph.style.top = `-${leadingPx + tH + mH - ov}px`;
        botZone.style.marginTop = `-${ov}px`;
      }

      const natH = natLetterHeights[i];
      const topH = Math.round(natH * TOP_FRAC);
      const botH = Math.round(natH * BOT_FRAC);
      const midH = natH - topH - botH;

      // Reveal starts after top line is fully in, letters staggered
      const revealStart = 0.12 + i * 0.012;
      const revealLocal = Math.max(0, Math.min(1, (progress - revealStart) / 0.10));
      const revealEased = 1 - Math.pow(1 - revealLocal, 3);
      const revealH     = revealEased * natH;

      const ov        = Math.round(natH * 0.04);
      const rawTopH   = Math.round(Math.min(revealH, topH));
      const topZoneH  = revealH >= topH ? rawTopH + ov : rawTopH;
      const midReveal = Math.max(0, Math.min(1, (revealH - topH) / midH));
      const midZoneH  = Math.round(midReveal * midH * sy);
      // Bot zone only opens once top + natural mid are fully revealed
      const botReveal = Math.max(0, Math.min(1, (revealH - topH - midH) / botH));
      const botZoneH  = Math.round(botReveal * (botH + ov));

      topZone.style.height = `${topZoneH}px`;
      midZone.style.height = `${midZoneH}px`;
      botZone.style.height = `${botZoneH}px`;
      midGlyph.style.transform = `scaleY(${sy})`;

      topZone.style.transform = '';
      botZone.style.transform = '';
    });
  }

  // ── Target cursor: active once BIGGER is fully stretched on screen ──
  function applyBiggerSectionWithShoot() {
    applyBiggerSection();
    if (!biggerOverlay || !biggerSection) return;
    const rect     = biggerSection.getBoundingClientRect();
    const sh       = biggerSection.offsetHeight;
    const progress = Math.max(0, Math.min(1, -rect.top / (sh - window.innerHeight)));
    // Trigger SHOOT flash just before aim mode — fires once when progress crosses 0.62
    if (progress >= 0.62 && biggerOverlay.classList.contains('is-active')) startShootFlash();

    // Aim mode: flash must be done, progress must not have reached the outro yet
    const aimOn = shootFlashState === 'done'
               && progress < 0.74
               && biggerOverlay.classList.contains('is-active');
    document.body.classList.toggle('bigger-aim-mode', aimOn);
    if (aimCursorEl) aimCursorEl.style.display = aimOn ? 'block' : 'none';
    // Hide gun when section leaves or outro begins; shown by startShootFlash
    if (!biggerOverlay.classList.contains('is-active') || progress >= 0.74) {
      gunHide();
    }
  }

  // ── Splatter shooting interaction ──
  // One base image; hue-rotate gives colour variety
  const splatHues  = [0, 45, 90, 150, 200, 270, 320]; // spread across spectrum
  const splatAudio = new Audio('/splatters/splatter-sound.mp3');
  splatAudio.volume = 0.6;

  function triggerShake() {
    if (!biggerOverlay) return;
    biggerOverlay.classList.remove('is-shaking');
    void biggerOverlay.offsetWidth;
    biggerOverlay.classList.add('is-shaking');
    biggerOverlay.addEventListener('animationend', () => {
      biggerOverlay.classList.remove('is-shaking');
    }, { once: true });
  }

  function spawnSplat(x: number, y: number) {
    const hue = splatHues[Math.floor(Math.random() * splatHues.length)];
    const rot = Math.random() * 360;
    const img = document.createElement('img');
    img.src   = '/splatters/splatter-blue.png';
    img.className = 'bigger-splat';
    img.style.left = `${x}px`;
    img.style.top  = `${y}px`;
    img.style.setProperty('--splat-rot', `rotate(${rot}deg)`);
    img.style.filter = `hue-rotate(${hue}deg)`;
    document.body.appendChild(img);

    const sfx = splatAudio.cloneNode() as HTMLAudioElement;
    sfx.play().catch(() => {});

    setTimeout(() => img.remove(), 2200);
  }

  // Load game font for SHOOT cursor
  (() => {
    const lnk = document.createElement('link');
    lnk.rel  = 'stylesheet';
    lnk.href = 'https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap';
    document.head.appendChild(lnk);
  })();

  // JS-driven cursor elements — bypass all browser cursor reset behaviour
  const aimCursorEl = document.createElement('div');
  aimCursorEl.id = 'bigger-aim-cursor';
  const aimCursorImg = document.createElement('img');
  aimCursorImg.src = '/cursors/target-icon-64.png';
  aimCursorImg.style.cssText = 'width:100%;height:100%;display:block;filter:hue-rotate(120deg) saturate(1.4)';
  aimCursorEl.appendChild(aimCursorImg);
  document.body.appendChild(aimCursorEl);

  const shootCursorEl = document.createElement('div');
  shootCursorEl.id = 'bigger-shoot-cursor';
  shootCursorEl.textContent = 'SHOOT';
  document.body.appendChild(shootCursorEl);

  // ── Space gun (3D model, first-person) ───────────────────────────────────
  const gunWrapper = document.getElementById('bigger-gun') as HTMLElement | null;
  const gunCanvas  = document.getElementById('gun-canvas')  as HTMLCanvasElement | null;

  // ── Three.js gun setup ─────────────────────────────────────────────────────
  let gunModel: THREE.Group | null = null;
  let gunTargetRotY = 0, gunTargetRotX = 0;
  let gunRotY = 0, gunRotX = 0;
  // GUN_BASE_Y: 0 = model default orientation; adjust once visible
  const GUN_BASE_Y = 0;

  if (gunCanvas) {
    const renderer = new THREE.WebGLRenderer({ canvas: gunCanvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping         = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 2.5;
    renderer.setClearColor(0x000000, 0);

    const scene  = new THREE.Scene();
    const aspect = gunCanvas.clientWidth / gunCanvas.clientHeight;
    const camera = new THREE.PerspectiveCamera(50, aspect, 0.001, 1000);
    camera.position.set(0, 0.3, 1.8);
    camera.lookAt(0, 0, 0);

    // RoomEnvironment provides IBL so PBR metallic materials are actually visible
    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
    pmrem.dispose();

    scene.add(new THREE.AmbientLight(0xffffff, 2));
    const key  = new THREE.DirectionalLight(0xffffff, 3);
    key.position.set(2, 3, 4);
    scene.add(key);

    const loader = new GLTFLoader();
    loader.load('/3d/atom_blaster.glb', (gltf) => {
      gunModel = gltf.scene;
      // Force double-sided rendering so no faces are culled
      gunModel.traverse((child) => {
        if ((child as THREE.Mesh).isMesh) {
          const mesh = child as THREE.Mesh;
          const mats = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
          mats.forEach((m: THREE.Material) => { m.side = THREE.DoubleSide; });
        }
      });
      const box    = new THREE.Box3().setFromObject(gunModel);
      const centre = box.getCenter(new THREE.Vector3());
      const size   = box.getSize(new THREE.Vector3()).length();
      const scl    = 1.8 / (size || 1);
      gunModel.scale.setScalar(scl);
      // Position must offset by scale * centre, not bare centre.
      // (world_centre = scale * local_centre + position → position = -scale * local_centre)
      gunModel.position.set(-centre.x * scl, -centre.y * scl, -centre.z * scl);
      gunModel.rotation.y = GUN_BASE_Y;
      scene.add(gunModel);
    }, undefined, (err) => console.error('[gun] load error:', err));

    // Resize renderer when canvas changes size
    const cv = gunCanvas;
    function resizeRenderer() {
      const w = cv.clientWidth;
      const h = cv.clientHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    new ResizeObserver(resizeRenderer).observe(cv);
    resizeRenderer();

    let gunTargetY = window.innerHeight * 1.5; // starts off-screen below
    let gunY       = window.innerHeight * 1.5;

    // Barrel tip in gunModel local space (from bbox analysis of the exported model)
    const BARREL_TIP = new THREE.Vector3(0, 0.2, -20.2);

    function renderGun() {
      // Lerp rotation toward cursor target
      gunRotY += (gunTargetRotY - gunRotY) * 0.10;
      gunRotX += (gunTargetRotX - gunRotX) * 0.10;
      if (gunModel) {
        gunModel.rotation.y = GUN_BASE_Y + gunRotY;
        gunModel.rotation.x = gunRotX;
        // Project barrel tip to screen coords for muzzle flash placement
        const tip = BARREL_TIP.clone();
        gunModel.localToWorld(tip);
        tip.project(camera);
        const cr = cv.getBoundingClientRect();
        (window as any).__gunMuzzleX = cr.left + (tip.x *  0.5 + 0.5) * cr.width;
        (window as any).__gunMuzzleY = cr.top  + (1 - (tip.y * 0.5 + 0.5)) * cr.height;
      }
      // Slide wrapper on/off screen
      gunY += (gunTargetY - gunY) * 0.03;
      if (gunWrapper) gunWrapper.style.transform = `translateY(${gunY}px)`;
      renderer.render(scene, camera);
      requestAnimationFrame(renderGun);
    }
    renderGun();

    // Expose show/hide/recoil for external callers
    (window as any).__gunShow   = () => { gunTargetY = 0; };
    (window as any).__gunHide   = () => { gunTargetY = window.innerHeight * 1.5; };
    (window as any).__gunRecoil = () => {
      // Kick up ~25px then spring back via lerp
      gunTargetY -= 25;
      setTimeout(() => { gunTargetY += 25; }, 75);
    };

    // Cursor tracking: compute real aim angle from gun base to cursor
    window.addEventListener('mousemove', (e) => {
      const nx = (e.clientX / window.innerWidth  - 0.5);
      const ny = (e.clientY / window.innerHeight - 0.5);
      gunTargetRotY = -nx * Math.PI * 0.35; // negated: positive cursor-right → barrel swings right
      gunTargetRotX = -ny * Math.PI * 0.20; // ±18° pitch
    }, { passive: true });
  }

  // Helper used by flash / scroll handler below
  function gunShow() { (window as any).__gunShow?.(); }
  function gunHide() { (window as any).__gunHide?.(); }

  window.addEventListener('mousemove', (e) => {
    aimCursorEl.style.left   = `${e.clientX}px`;
    aimCursorEl.style.top    = `${e.clientY}px`;
    shootCursorEl.style.left = `${e.clientX}px`;
    shootCursorEl.style.top  = `${e.clientY}px`;
    // Gun cursor tracking handled inside the Three.js block
  }, { passive: true });

  // ── SHOOT flash sequence ──────────────────────────────────────────────────
  let shootFlashState: 'idle' | 'flashing' | 'done' = 'idle';

  function lockScrollFor(ms: number) {
    (window as any).__scrollLocked = true;
    const lockedY = window.scrollY;
    const block   = (e: Event) => e.preventDefault();
    const restore = () => window.scrollTo(0, lockedY); // catches Safari momentum
    window.addEventListener('wheel',     block,   { passive: false });
    window.addEventListener('touchmove', block,   { passive: false });
    window.addEventListener('scroll',    restore, { passive: true });
    setTimeout(() => {
      (window as any).__scrollLocked = false;
      window.removeEventListener('wheel',     block);
      window.removeEventListener('touchmove', block);
      window.removeEventListener('scroll',    restore);
    }, ms);
  }

  function startShootFlash() {
    if (shootFlashState !== 'idle') return;
    shootFlashState = 'flashing';
    document.body.classList.add('bigger-shoot-mode');
    shootCursorEl.style.display = 'block';
    gunShow(); // gun and SHOOT appear together
    lockScrollFor(3500); // hold scroll for ~flash duration so fast scrollers don't skip it

    let count = 0;
    const flashes = 7;
    const onMs   = 300;
    const offMs  = 160;

    function step() {
      if (count >= flashes) {
        // All flashes done — activate aim cursor immediately without waiting for scroll
        shootCursorEl.style.display = 'none';
        document.body.classList.remove('bigger-shoot-mode');
        shootFlashState = 'done';
        document.body.classList.add('bigger-aim-mode');
        if (aimCursorEl) aimCursorEl.style.display = 'block';
        gunShow(); // already on-screen from flash start
        return;
      }
      shootCursorEl.style.opacity = '1';
      setTimeout(() => {
        shootCursorEl.style.opacity = '0';
        count++;
        setTimeout(step, offMs);
      }, onMs);
    }

    step();
  }

  // Irregular shard shapes — look like broken solid material
  const chipShapes = [
    'polygon(0% 0%, 100% 8%, 92% 100%, 6% 94%)',
    'polygon(8% 0%, 100% 0%, 94% 100%, 0% 86%)',
    'polygon(0% 6%, 94% 0%, 100% 94%, 4% 100%)',
    'polygon(10% 0%, 100% 4%, 90% 96%, 0% 100%)',
    'polygon(0% 0%, 96% 10%, 88% 100%, 8% 90%)',
    'polygon(4% 0%, 100% 0%, 100% 88%, 0% 100%)',
  ];

  function spawnChips(cx: number, cy: number) {
    // Find which letter zone was hit so chips spawn from the right place
    const wraps = Array.from(document.querySelectorAll<HTMLElement>('.bigger-letter-wrap'));
    let hitEl: HTMLElement | null = null;
    for (const wrap of wraps) {
      const r = wrap.getBoundingClientRect();
      if (cx >= r.left && cx <= r.right && cy >= r.top && cy <= r.bottom) {
        // Find the specific child zone (top / mid / bot)
        for (let zi = 0; zi < wrap.children.length; zi++) {
          const zr = (wrap.children[zi] as HTMLElement).getBoundingClientRect();
          if (cy >= zr.top && cy <= zr.bottom) { hitEl = wrap.children[zi] as HTMLElement; break; }
        }
        if (!hitEl) hitEl = wrap;
        break;
      }
    }

    const count = 4 + Math.floor(Math.random() * 3); // 4–6 chips
    for (let i = 0; i < count; i++) {
      const chip = document.createElement('div');
      chip.className = 'bigger-chip';

      const w = 10 + Math.random() * 22;
      const h =  7 + Math.random() * 16;
      const initAngle = Math.random() * 360;
      const shape = chipShapes[Math.floor(Math.random() * chipShapes.length)];

      // Burst outward from click point with slight upward bias
      const flyAngle = Math.random() * Math.PI * 2;
      const speed    = 130 + Math.random() * 230;
      const vx = Math.cos(flyAngle) * speed;
      const vy = Math.sin(flyAngle) * speed - 80;
      const spin     = (Math.random() - 0.5) * 900;
      const duration = 480 + Math.random() * 320;

      // Spawn at the exact impact point, optionally offset slightly into the hit zone
      const ox = hitEl ? (Math.random() - 0.5) * 20 : 0;
      const oy = hitEl ? (Math.random() - 0.5) * 20 : 0;

      chip.style.cssText =
        `left:${cx + ox}px;top:${cy + oy}px;` +
        `width:${w}px;height:${h}px;` +
        `clip-path:${shape};` +
        `transform:translate(-50%,-50%) rotate(${initAngle}deg);`;

      document.body.appendChild(chip);

      chip.animate(
        [
          { transform: `translate(-50%,-50%) rotate(${initAngle}deg)`,                                              opacity: 1 },
          { transform: `translate(calc(-50% + ${vx}px), calc(-50% + ${vy}px)) rotate(${initAngle + spin}deg)`, opacity: 0 },
        ],
        { duration, easing: 'cubic-bezier(0.2, 0.6, 0.4, 1)', fill: 'forwards' }
      ).onfinish = () => chip.remove();
    }
  }

  // ── Per-letter canvas destruction (organic blobs) ────────────────────────
  // Canvas starts fully opaque (white). Blasts punch transparent holes with
  // canvas 2D destination-out GCO. The canvas is then exported as a data-URL
  // and applied as -webkit-mask-image / mask-image, giving real cutouts that
  // work on both Chrome and Safari without any blend-mode CSS tricks.

  interface LetterMask { canvas: HTMLCanvasElement; ctx: CanvasRenderingContext2D; blasted: number; letterArea: number; }
  const letterMaskMap = new Map<HTMLElement, LetterMask>();

  function getOrCreateLetterMask(wrap: HTMLElement): LetterMask {
    if (letterMaskMap.has(wrap)) return letterMaskMap.get(wrap)!;
    const r = wrap.getBoundingClientRect();

    const canvas = document.createElement('canvas');
    canvas.width  = Math.ceil(r.width);
    canvas.height = Math.ceil(r.height);
    const ctx = canvas.getContext('2d')!;
    // Fill white = fully visible; holes punched by destination-out → transparent → masked out
    ctx.fillStyle = 'white';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Apply initial mask (fully visible)
    wrap.style['webkitMaskSize'] = '100% 100%';
    wrap.style.maskSize          = '100% 100%';

    const entry: LetterMask = { canvas, ctx, blasted: 0, letterArea: r.width * r.height };
    letterMaskMap.set(wrap, entry);
    return entry;
  }

  function applyCanvasMask(wrap: HTMLElement, canvas: HTMLCanvasElement) {
    const url = canvas.toDataURL();
    wrap.style['webkitMaskImage'] = `url('${url}')`;
    wrap.style.maskImage          = `url('${url}')`;
  }

  function spawnDamageHole(cx: number, cy: number) {
    if (!biggerWordWrap) return;
    const wraps = Array.from(biggerWordWrap.querySelectorAll<HTMLElement>('.bigger-letter-wrap'));

    let hitWrap: HTMLElement | null = null;
    for (let i = 0; i < wraps.length; i++) {
      const r = wraps[i].getBoundingClientRect();
      if (cx >= r.left && cx <= r.right && cy >= r.top && cy <= r.bottom) {
        hitWrap = wraps[i]; break;
      }
    }
    if (!hitWrap) {
      let best = Infinity;
      wraps.forEach((w) => {
        const r = w.getBoundingClientRect();
        const d = Math.hypot(cx - (r.left + r.width / 2), cy - (r.top + r.height / 2));
        if (d < best) { best = d; hitWrap = w; }
      });
    }
    if (!hitWrap) return;

    const entry  = getOrCreateLetterMask(hitWrap);
    const r      = hitWrap.getBoundingClientRect();
    const lx     = cx - r.left;
    const ly     = cy - r.top;
    const radius = r.width * 0.38;

    // Punch a transparent hole into the mask canvas using canvas destination-out
    const { ctx, canvas } = entry;
    ctx.globalCompositeOperation = 'destination-out';
    const n = 13 + Math.floor(Math.random() * 4);
    ctx.beginPath();
    for (let i = 0; i < n; i++) {
      const angle = (i / n) * Math.PI * 2 + (Math.random() - 0.5) * (Math.PI / n) * 1.4;
      const rad   = radius * (0.40 + Math.random() * 0.95);
      const x = lx + Math.cos(angle) * rad;
      const y = ly + Math.sin(angle) * rad;
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.closePath();
    ctx.fill();
    ctx.globalCompositeOperation = 'source-over';

    // Export canvas as mask-image — transparent holes = element pixels hidden
    applyCanvasMask(hitWrap, canvas);

    // Approximate area of an irregular blast (~55% of bounding circle)
    entry.blasted += Math.PI * radius * radius * 0.55;

    // Once ~80% of the letter area has been blasted, fade it out entirely
    if (entry.blasted >= entry.letterArea * 0.8) {
      (hitWrap as HTMLElement).style.transition = 'opacity 0.25s ease';
      (hitWrap as HTMLElement).style.opacity    = '0';
    }
  }

  // ── Top-line word ejection ────────────────────────────────────────────────
  function ejectWord(span: HTMLElement) {
    span.classList.add('is-ejected');
    span.style.position = 'relative';
    span.style.zIndex   = '20';
    span.style.display  = 'inline-block'; // ensure transform works inline

    // Initial blast velocity (px per frame at ~60 fps)
    // Horizontal: random left/right lean
    // Vertical: slight upward kick — gravity then pulls it down
    let vx  = (Math.random() - 0.5) * 10;          // ±5 px/frame horizontal
    let vy  = -(2 + Math.random() * 3);             // 2–5 px/frame upward
    let vr  = (Math.random() < 0.5 ? 1 : -1)
            * (1.8 + Math.random() * 2.8);          // ±1.8–4.6 deg/frame
    const gravity = 0.48;                           // px/frame² — weighty but not floaty

    let x = 0, y = 0, rot = 0;
    const startTop = span.getBoundingClientRect().top;

    function tick() {
      vy  += gravity;
      x   += vx;
      y   += vy;
      rot += vr;
      span.style.transform = `translate(${x}px,${y}px) rotate(${rot}deg)`;
      // Keep animating until the word has fully cleared the bottom of the viewport
      if (startTop + y < window.innerHeight + 120) requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
  }

  function tryShootTopLine(cx: number, cy: number): boolean {
    if (!biggerTop) return false;
    const words = Array.from(biggerTop.querySelectorAll<HTMLElement>('.bigger-top-word'));
    for (const span of words) {
      if (span.classList.contains('is-ejected')) continue;
      const r = span.getBoundingClientRect();
      if (cx >= r.left && cx <= r.right && cy >= r.top && cy <= r.bottom) {
        ejectWord(span);
        return true;
      }
    }
    return false;
  }

  function spawnMuzzleFlash() {
    const cx = (window as any).__gunMuzzleX;
    const cy = (window as any).__gunMuzzleY;
    if (!cx || !cy) return;
    const el = document.createElement('div');
    el.style.cssText = [
      'position:fixed', 'pointer-events:none', 'z-index:9991',
      `left:${cx - 40}px`, `top:${cy - 40}px`,
      'width:80px', 'height:80px', 'border-radius:50%',
      'background:radial-gradient(circle,rgba(255,255,180,0.85) 0%,rgba(255,210,80,0.45) 45%,transparent 72%)',
      'opacity:1', 'transition:opacity 0.14s ease-out',
    ].join(';');
    document.body.appendChild(el);
    requestAnimationFrame(() => requestAnimationFrame(() => { el.style.opacity = '0'; }));
    setTimeout(() => el.remove(), 220);
  }

  window.addEventListener('click', (e) => {
    if (!document.body.classList.contains('bigger-aim-mode')) return;
    const hitTop = tryShootTopLine(e.clientX, e.clientY);
    spawnSplat(e.clientX, e.clientY);
    spawnChips(e.clientX, e.clientY);
    if (!hitTop) spawnDamageHole(e.clientX, e.clientY);
    triggerShake();
    spawnMuzzleFlash();
    (window as any).__gunRecoil?.();
  });

  // ── Third section headline: scroll-driven word reveal ──
  const thirdSection   = document.querySelector<HTMLElement>('.manifesto-block--third');
  const lostWords      = Array.from(document.querySelectorAll<HTMLElement>('.lost-word'));

  function applyLostHeadline() {
    if (!thirdSection || lostWords.length === 0) return;
    const rect     = thirdSection.getBoundingClientRect();
    const vh       = window.innerHeight;
    // 0 when section bottom enters viewport, 1 when section is 55% scrolled in
    const progress = Math.max(0, Math.min(1, (vh - rect.top) / (vh * 0.55)));
    lostWords.forEach((word, i) => {
      const threshold = i / (lostWords.length + 1);
      word.classList.toggle('is-revealed', progress >= threshold);
    });
  }

  // ── Grid overlay: stays viewport-aligned, lines purple → dark as section scrolls in ──
  const thirdGridSvg   = document.querySelector<SVGSVGElement>('.third-grid');
  const thirdGridGroup = document.querySelector<SVGGElement>('.third-grid-lines');

  function applyGridColor() {
    if (!thirdSection || !thirdGridSvg || !thirdGridGroup) return;
    const rect = thirdSection.getBoundingClientRect();
    const vh   = window.innerHeight;
    thirdGridSvg.style.transform = `translateY(${-rect.top}px)`;
    const progress = Math.max(0, Math.min(1, (vh - rect.top) / vh));
    const r = Math.round(0x98 + (0x1a - 0x98) * progress);
    const g = Math.round(0x6e + (0x1a - 0x6e) * progress);
    const b = Math.round(0xdf + (0x1a - 0xdf) * progress);
    thirdGridGroup.style.stroke = `rgb(${r},${g},${b})`;
  }

  // ── Single RAF-throttled scroll handler ──
  function runScrollHandlers() {
    if (hscrollSection && hscrollContainer && hscrollText) applyHscroll();
    applyParallax();
    applyWordScroll();
    applyBiggerSectionWithShoot();
    applyGridColor();
    applyLostHeadline();
  }

  let scrollRaf = 0;
  window.addEventListener("scroll", () => {
    if (scrollRaf) return;
    scrollRaf = requestAnimationFrame(() => {
      runScrollHandlers();
      scrollRaf = 0;
    });
  }, { passive: true });

  runScrollHandlers();

</script>

<style>
  /* Parallax transform applied directly via JS — no transition so it tracks scroll instantly */
  .manifesto-inner.is-visible {
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Prevent the parallax transform competing with line transitions */
  .manifesto-inner.is-visible .manifesto-line,
  .manifesto-inner--finale.is-visible .manifesto-finale {
    transform: none;
  }
</style>

<script>
  const burstWord  = document.querySelector('.burst-word');
  const burstLayer = document.querySelector<HTMLElement>('.burst-layer');

  if (burstWord && burstLayer) {
    const word = burstWord as Element;
    function rand(a: number, b: number) { return a + Math.random() * (b - a); }

    const FILL_COLORS = ['#e8e4de', '#986edf', '#1a5c3a'];
    const BG = `fill="none"`;
    const S  = `stroke="#1a1a1a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"`;
    const H  = `<circle cx="20" cy="20" r="17" ${BG}/>`;   // filled head
    const FACES = [
      // WOW — round eyes, raised brows, O-mouth
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M9,10 Q13,7 17,10"/><path d="M23,10 Q27,7 31,10"/><circle cx="13" cy="16" r="3.5"/><circle cx="27" cy="16" r="3.5"/><ellipse cx="20" cy="27" rx="5" ry="5.5"/></svg>`,
      // LAUGHING — squint eyes, open grin
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M9,15 Q13,10 17,15"/><path d="M23,15 Q27,10 31,15"/><path d="M10,23 Q15,21 20,22 Q25,21 30,23"/><path d="M10,23 Q20,36 30,23"/></svg>`,
      // SHOCKED — rect eyes, raised brows, oval mouth
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M9,10 Q13,7 17,10"/><path d="M23,10 Q27,7 31,10"/><rect x="10" y="12" width="8" height="7" rx="1"/><rect x="22" y="12" width="8" height="7" rx="1"/><ellipse cx="20" cy="28" rx="5" ry="5.5"/></svg>`,
      // THINKING — one raised brow, eyes looking up, chin touch
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M9,13 Q13,10 17,13"/><path d="M22,11 Q27,8 31,12"/><circle cx="13" cy="17" r="2.5"/><circle cx="27" cy="15" r="2.5"/><path d="M15,27 Q18,25 22,26"/><path d="M26,31 Q28,29 30,27"/></svg>`,
      // CRAZY — swirl eye + X eye, wavy grin
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<circle cx="13" cy="16" r="5"/><circle cx="13" cy="16" r="2"/><path d="M23,11 L31,21"/><path d="M31,11 L23,21"/><path d="M9,27 Q12,24 15,27 Q18,30 21,27 Q24,24 27,27"/></svg>`,
      // SMUG — arched brow, hooded eye, lopsided smirk
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M9,12 Q13,9 17,12"/><path d="M22,10 Q27,8 31,12"/><circle cx="13" cy="17" r="2.5"/><circle cx="27" cy="16" r="2.5"/><path d="M24,13.5 Q27,12 30,13.5"/><path d="M13,26 Q18,24 22,26 Q26,29 28,27"/></svg>`,
      // STAR-EYED — asterisk eyes, big smile
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M13,10.5 L13,20.5 M8,15.5 L18,15.5 M9.5,12 L16.5,19 M16.5,12 L9.5,19"/><path d="M27,10.5 L27,20.5 M22,15.5 L32,15.5 M23.5,12 L30.5,19 M30.5,12 L23.5,19"/><path d="M10,26 Q20,36 30,26"/></svg>`,
      // DISGUSTED — furrowed brows, squinted lines, frown
      `<svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" ${S}>${H}<path d="M9,14 Q13,17 17,14"/><path d="M23,14 Q27,17 31,14"/><line x1="10" y1="17" x2="16" y2="17"/><line x1="24" y1="17" x2="30" y2="17"/><path d="M12,28 Q20,23 28,28"/></svg>`,
    ];

    function spawnBurst() {
      const rect = word.getBoundingClientRect();

      for (let i = 0; i < 8; i++) {
        const size = rand(48, 72);
        const el   = document.createElement('div');
        const bgColor = FILL_COLORS[Math.floor(Math.random() * FILL_COLORS.length)];
        el.style.cssText = `position:fixed;pointer-events:none;z-index:9998;width:${size}px;height:${size}px;top:0;left:0;border-radius:50%;background:${bgColor};`;
        el.innerHTML = FACES[Math.floor(Math.random() * FACES.length)];
        document.body.appendChild(el);

        let x   = rect.left + rand(0, rect.width)  - size / 2;
        let y   = rect.top  + rand(-6, 6)           - size / 2;
        let vx  = rand(-2, 2);
        let vy  = rand(-7, -4);
        let rot = rand(0, 360);
        const vr = rand(-1.5, 1.5);
        (function tick() {
          vy  += 0.1;
          x   += vx;
          y   += vy;
          rot += vr;
          el.style.transform = `translate(${x}px,${y}px) rotate(${rot}deg)`;
          if (y < window.innerHeight + size) requestAnimationFrame(tick);
          else el.remove();
        })();
      }
    }

    word.addEventListener('mouseenter', spawnBurst);
  }
</script>
