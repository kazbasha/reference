---
import Layout from "../../layouts/Layout.astro";

const videos = ['id8LPUAWEiY', 'T6HhpnVUXC0', 'GsbUOkUxL_E', '6Id44b9geYQ', 'tunK9_MF6TU', 'lZHlXeXzlY0'];
const shorts = ['O_mF_rXXZEA', 'Txgv3TzOBFc', 'uFGfaygQVek'];
---

<Layout title="Shahid — The Devil's Promise — Reference" description="Shahid — The Devil's Promise. Reference creative studio.">
  <main class="project-page">
    <div class="project-inner">

      <!-- Header -->
      <div class="project-header">
        <p class="project-client">SHAHID</p>
        <h1 class="project-title">The Devil's<br/>Promise</h1>
        <p class="project-meta">Agency: Shahid &nbsp;·&nbsp; Production: Prodigy &nbsp;·&nbsp; 2022</p>
      </div>

      <!-- Body copy -->
      <div class="project-body">
        <p>To promote the Shahid Original series The Devil's Promise, we didn't just launch a trailer... we launched a recruitment drive for the underworld.</p>
        <p>In the show, the antagonist (played by Fathy Abdel Wahab) manipulates a man into selling his soul to save his wife. To bring this tension to life, we created a contextual teaser campaign featuring the Devil himself, offering viewers an "alternative" way to achieve their wildest dreams.</p>
      </div>

      <!-- Full videos -->
      {videos.map((vid) => (
        <div class="project-video-wrap">
          <div class="yt-facade" data-vid={vid} role="button" aria-label="Play video" tabindex="0">
            <img class="yt-facade__thumb" src={`https://img.youtube.com/vi/${vid}/maxresdefault.jpg`} data-fallback={`https://img.youtube.com/vi/${vid}/hqdefault.jpg`} alt="" loading="lazy" />
            <button class="yt-facade__play" aria-hidden="true" tabindex="-1">
              <svg viewBox="0 0 68 48" xmlns="http://www.w3.org/2000/svg">
                <path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C56 0 34 0 34 0S12 0 7.5 1.7a8.5 8.5 0 0 0-6 6C0 12.1 0 24 0 24s0 11.9 1.5 16.3a8.5 8.5 0 0 0 6 6C12 48 34 48 34 48s22 0 26.5-1.7a8.5 8.5 0 0 0 6-6C68 35.9 68 24 68 24s0-11.9-1.5-16.3z" fill="#fff" opacity="0.9"/>
                <path d="M27 34l18-10-18-10v20z" fill="#000"/>
              </svg>
            </button>
          </div>
        </div>
      ))}

      <!-- Strategy section -->
      <div class="project-section">
        <h2 class="project-section__title">The Creative Strategy</h2>
        <div class="project-body">
          <p>We produced over 20 unique content pieces designed to hijack the user journey. By mapping the Devil's appearances to specific search behaviors and platforms, we met people exactly where their desires (and frustrations) lived.</p>
          <p><strong>Omnichannel Execution:</strong> We developed tailored content for Twitter, TikTok, and Instagram (Feed &amp; Stories), ensuring the Devil's message felt native to every platform.</p>
          <p><strong>Hyper-Personalized Themes:</strong> The campaign tapped into universal human desires. Whether users were looking for professional success, financial gain, or personal transformation, we had a specific execution ready covering work, money, body image, and relationships.</p>
          <p><strong>Production Efficiency:</strong> Despite the high volume of assets, the campaign was as cost-effective as it was clever. We managed to capture the entire library of content in a single intensive shoot day, maximizing our resources without compromising on the cinematic quality.</p>
        </div>
      </div>

      <!-- Shorts row -->
      <div class="project-shorts">
        {shorts.map((vid) => (
          <div class="project-short-wrap">
            <div class="yt-facade" data-vid={vid} role="button" aria-label="Play video" tabindex="0">
              <img class="yt-facade__thumb" src={`https://img.youtube.com/vi/${vid}/maxresdefault.jpg`} data-fallback={`https://img.youtube.com/vi/${vid}/hqdefault.jpg`} alt="" loading="lazy" />
              <button class="yt-facade__play" aria-hidden="true" tabindex="-1">
                <svg viewBox="0 0 68 48" xmlns="http://www.w3.org/2000/svg">
                  <path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C56 0 34 0 34 0S12 0 7.5 1.7a8.5 8.5 0 0 0-6 6C0 12.1 0 24 0 24s0 11.9 1.5 16.3a8.5 8.5 0 0 0 6 6C12 48 34 48 34 48s22 0 26.5-1.7a8.5 8.5 0 0 0 6-6C68 35.9 68 24 68 24s0-11.9-1.5-16.3z" fill="#fff" opacity="0.9"/>
                  <path d="M27 34l18-10-18-10v20z" fill="#000"/>
                </svg>
              </button>
            </div>
          </div>
        ))}
      </div>

      <!-- Impact section -->
      <div class="project-section">
        <h2 class="project-section__title">The Impact</h2>
        <div class="project-body">
          <p>The results were as supernatural as the show itself. By blurring the line between fiction and reality across every major digital touchpoint, the initiative became the most successful pre-launch campaign in Shahid's history, shattering engagement records and setting a new benchmark for how we introduce Shahid Originals to the world.</p>
        </div>
      </div>

      <!-- Back to work -->
      <div class="project-back-wrap">
        <a class="project-back-btn" id="project-back-btn" href="/work">
          <svg width="16" height="10" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M0.646 5.354a.5.5 0 0 1 0-.708L4.293.999a.5.5 0 1 1 .707.708L1.707 5l3.293 3.293a.5.5 0 0 1-.707.708L.646 5.354zM16 5.5H1v-1h15v1z" fill="currentColor"/>
          </svg>
          BACK TO WORK
        </a>
      </div>

    </div>
  </main>
</Layout>

<style>
  .project-page {
    min-height: 100svh;
    background: #000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .project-inner {
    width: 100%;
    max-width: clamp(320px, 88vw, 960px);
    padding: clamp(48px, 8vw, 100px) 0 clamp(80px, 10vw, 140px);
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 40px);
  }

  .project-header {
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }

  .project-client {
    font-size: clamp(9px, 0.72vw, 11px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #986edf;
    margin: 0;
  }

  .project-title {
    font-size: clamp(48px, 7vw, 110px);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: #e8e4de;
    margin: 0;
  }

  .project-meta {
    font-size: clamp(9px, 0.72vw, 11px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(232, 228, 222, 0.35);
    margin: 0;
  }

  .project-video-wrap {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 4px;
    background: #0a0a0a;
  }

  .project-shorts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(10px, 1.5vw, 20px);
  }

  .project-short-wrap {
    position: relative;
    width: 100%;
    padding-bottom: 177.78%;
    height: 0;
    overflow: hidden;
    border-radius: 4px;
    background: #0a0a0a;
  }

  .yt-facade {
    position: absolute;
    inset: 0;
    cursor: none;
    overflow: hidden;
    border-radius: 4px;
  }

  .yt-facade__thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .yt-facade:hover .yt-facade__thumb { transform: scale(1.03); }

  .yt-facade__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.18);
    border: none;
    cursor: none;
    transition: background 0.25s ease;
  }

  .yt-facade:hover .yt-facade__play { background: rgba(0, 0, 0, 0.32); }

  .yt-facade__play svg {
    width: clamp(40px, 5vw, 68px);
    height: auto;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    filter: drop-shadow(0 2px 12px rgba(0,0,0,0.4));
  }

  .yt-facade:hover .yt-facade__play svg { transform: scale(1.1); }

  .project-body {
    display: flex;
    flex-direction: column;
    gap: 1.2em;
  }

  .project-body p {
    font-size: clamp(14px, 1.2vw, 18px);
    font-weight: 400;
    line-height: 1.65;
    color: rgba(232, 228, 222, 0.7);
    max-width: 68ch;
    margin: 0;
  }

  .project-body strong {
    color: rgba(232, 228, 222, 0.9);
    font-weight: 500;
  }

  .project-section {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2vw, 24px);
    padding-top: clamp(8px, 1vw, 16px);
    border-top: 1px solid rgba(232, 228, 222, 0.08);
  }

  .project-section__title {
    font-size: clamp(9px, 0.72vw, 11px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(232, 228, 222, 0.4);
    margin: 0;
    font-weight: 400;
  }

  .project-back-wrap {
    display: flex;
    justify-content: center;
    padding-top: clamp(16px, 3vw, 32px);
  }

  .project-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: #000;
    border: 1px solid rgba(152, 110, 223, 0.35);
    border-radius: 4px;
    color: #986edf;
    font-family: "ObviouslyWide", system-ui, sans-serif;
    font-size: clamp(9px, 0.7vw, 11px);
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 14px 28px;
    transition:
      background 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.25s ease,
      gap 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      padding 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-back-btn:hover {
    background: #0d0318;
    border-color: rgba(152, 110, 223, 0.7);
    gap: 22px;
    padding-left: 42px;
    padding-right: 42px;
  }

  .project-back-btn svg {
    flex-shrink: 0;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-back-btn:hover svg { transform: translateX(-4px); }

  @media (max-width: 768px) {
    .project-inner { padding-top: 80px; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    // Thumbnail fallback (maxresdefault → hqdefault)
    document.querySelectorAll<HTMLImageElement>('.yt-facade__thumb').forEach((img) => {
      const check = () => { if (img.naturalWidth <= 120) { const fb = img.dataset.fallback; if (fb) img.src = fb; } };
      if (img.complete) { check(); } else { img.addEventListener('load', check, { once: true }); }
    });

    // Facade click → iframe embed
    document.querySelectorAll<HTMLElement>('.yt-facade').forEach((facade) => {
      function activate() {
        const vid = facade.dataset.vid;
        const iframe = document.createElement('iframe');
        iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:none;';
        iframe.src = `https://www.youtube.com/embed/${vid}?autoplay=1&rel=0`;
        iframe.title = 'Video';
        iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
        iframe.allowFullscreen = true;
        facade.replaceWith(iframe);
      }
      facade.addEventListener('click', activate, { once: true });
      facade.addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === 'Enter' || e.key === ' ') activate(); }, { once: true });
    });

    const backBtn = document.getElementById('project-back-btn') as HTMLAnchorElement | null;
    if (backBtn) {
      backBtn.addEventListener('click', (e) => {
        e.preventDefault();
        import('astro:transitions/client').then(({ navigate }) => navigate('/work'));
      });
    }
  });
</script>
