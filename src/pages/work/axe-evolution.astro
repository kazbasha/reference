---
import Layout from "../../layouts/Layout.astro";

const videos = ['wV78-vi1HQA', 'sl_f3zr8Nv0'];

const results = [
  { value: 3.5, decimals: 1, suffix: 'M', label: 'Views' },
  { value: 27,  decimals: 0, suffix: 'K', label: 'Uploads' },
  { value: 17,  decimals: 0, suffix: '%', label: 'Sales increase' },
];

const awards = [
  {
    show: 'African Cristals 2016',
    items: [
      { tier: 'Grand Prix', category: 'Sphinx Awards' },
      { tier: 'Emerald',    category: 'Viral Film' },
    ],
  },
  {
    show: 'Mena Cristals 2016',
    items: [
      { tier: 'Emerald', category: 'Digital & Mobile' },
    ],
  },
];
---

<Layout title="Axe — Evolution of Hooking Up — Reference" description="Axe — Evolution of Hooking Up. Reference creative studio.">
  <main class="project-page">
    <div class="project-inner">

      <!-- Back link -->
      <a class="back-link" href="/work">
        <svg width="16" height="10" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M0.646 5.354a.5.5 0 0 1 0-.708L4.293.999a.5.5 0 1 1 .707.708L1.707 5l3.293 3.293a.5.5 0 0 1-.707.708L.646 5.354zM16 5.5H1v-1h15v1z" fill="currentColor"/>
        </svg>
        Work
      </a>

      <!-- Header -->
      <div class="project-header">
        <p class="project-client">AXE</p>
        <h1 class="project-title">Evolution of<br/>Hooking Up</h1>
      </div>

      <!-- Videos -->
      {videos.map((vid) => (
        <div class="project-video-wrap">
          <div class="yt-facade" data-vid={vid} role="button" aria-label="Play video" tabindex="0">
            <img
              class="yt-facade__thumb"
              src={`https://img.youtube.com/vi/${vid}/maxresdefault.jpg`}
              data-fallback={`https://img.youtube.com/vi/${vid}/hqdefault.jpg`}
              alt=""
              loading="lazy"
            />
            <button class="yt-facade__play" aria-hidden="true" tabindex="-1">
              <svg viewBox="0 0 68 48" xmlns="http://www.w3.org/2000/svg">
                <path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C56 0 34 0 34 0S12 0 7.5 1.7a8.5 8.5 0 0 0-6 6C0 12.1 0 24 0 24s0 11.9 1.5 16.3a8.5 8.5 0 0 0 6 6C12 48 34 48 34 48s22 0 26.5-1.7a8.5 8.5 0 0 0 6-6C68 35.9 68 24 68 24s0-11.9-1.5-16.3z" fill="#fff" opacity="0.9"/>
                <path d="M27 34l18-10-18-10v20z" fill="#000"/>
              </svg>
            </button>
          </div>
        </div>
      ))}

      <!-- Body copy -->
      <p class="project-body">
        In celebration of Axe changing their look for the first time in 7 years, we created a music video about the evolution of hooking up. People could star in the video by uploading their own pictures showing us how they changed in the last 7 years.
      </p>

      <!-- Results -->
      <div class="project-results">
        {results.map((r) => (
          <div class="result-item">
            <span
              class="result-number"
              data-target={r.value}
              data-decimals={r.decimals}
              data-suffix={r.suffix}
            >+0{r.suffix}</span>
            <span class="result-label">{r.label}</span>
          </div>
        ))}
      </div>

      <!-- Awards -->
      <div class="project-awards">
        <h2 class="awards-heading">Awards</h2>
        <div class="awards-table">
          {awards.map((show) => (
            <div class="awards-row">
              <div class="awards-show">{show.show}</div>
              <div class="awards-items">
                {show.items.map((item) => (
                  <div class="awards-item">
                    <span class="awards-tier">{item.tier}</span>
                    <span class="awards-category">{item.category}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </main>
</Layout>

<style>
  .project-page {
    min-height: 100svh;
    background: #000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .project-inner {
    width: 100%;
    max-width: clamp(320px, 88vw, 960px);
    padding: clamp(48px, 8vw, 100px) 0 clamp(80px, 10vw, 140px);
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 40px);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: rgba(232, 228, 222, 0.4);
    text-decoration: none;
    font-size: clamp(9px, 0.72vw, 11px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color 0.2s ease;
    align-self: flex-start;
  }
  .back-link:hover { color: #986edf; }

  .project-header {
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }

  .project-client {
    font-size: clamp(9px, 0.72vw, 11px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #986edf;
    margin: 0;
  }

  .project-title {
    font-size: clamp(48px, 7vw, 110px);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: #e8e4de;
    margin: 0;
  }

  /* Video */
  .project-video-wrap {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 4px;
    background: #0a0a0a;
  }

  .yt-facade {
    position: absolute;
    inset: 0;
    cursor: none;
    overflow: hidden;
    border-radius: 4px;
  }

  .yt-facade__thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .yt-facade:hover .yt-facade__thumb { transform: scale(1.03); }

  .yt-facade__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.18);
    border: none;
    cursor: none;
    transition: background 0.25s ease;
  }

  .yt-facade:hover .yt-facade__play { background: rgba(0, 0, 0, 0.32); }

  .yt-facade__play svg {
    width: clamp(48px, 6vw, 80px);
    height: auto;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    filter: drop-shadow(0 2px 12px rgba(0,0,0,0.4));
  }

  .yt-facade:hover .yt-facade__play svg { transform: scale(1.1); }

  .project-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Body */
  .project-body {
    font-size: clamp(14px, 1.2vw, 18px);
    font-weight: 400;
    line-height: 1.65;
    color: rgba(232, 228, 222, 0.7);
    max-width: 68ch;
    margin: 0;
  }

  /* Results */
  .project-results {
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: clamp(16px, 3vw, 40px);
    padding: clamp(28px, 4vw, 48px) clamp(24px, 4vw, 48px);
    border: 1px solid rgba(152, 110, 223, 0.2);
    border-radius: 4px;
    background: rgba(152, 110, 223, 0.04);
  }

  .result-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35em;
    text-align: center;
  }

  .result-number {
    font-size: clamp(28px, 3.8vw, 56px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
    color: #986edf;
    white-space: nowrap;
  }

  .result-label {
    font-size: clamp(9px, 0.72vw, 11px);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(232, 228, 222, 0.45);
  }

  /* Awards */
  .project-awards {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2vw, 24px);
  }

  .awards-heading {
    font-size: clamp(9px, 0.72vw, 11px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(232, 228, 222, 0.4);
    margin: 0;
    font-weight: 400;
  }

  .awards-table {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(232, 228, 222, 0.08);
  }

  .awards-row {
    display: grid;
    grid-template-columns: clamp(180px, 28%, 260px) 1fr;
    gap: clamp(16px, 3vw, 48px);
    padding: clamp(16px, 2vw, 24px) 0;
    border-bottom: 1px solid rgba(232, 228, 222, 0.08);
    align-items: start;
  }

  .awards-show {
    font-size: clamp(10px, 0.8vw, 12px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(232, 228, 222, 0.4);
    padding-top: 0.1em;
  }

  .awards-items {
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }

  .awards-item {
    display: flex;
    align-items: baseline;
    gap: 0.75em;
  }

  .awards-tier {
    font-size: clamp(9px, 0.72vw, 11px);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #986edf;
    flex-shrink: 0;
  }

  .awards-category {
    font-size: clamp(13px, 1.1vw, 16px);
    font-weight: 400;
    color: #e8e4de;
    letter-spacing: 0.02em;
  }

  @media (max-width: 480px) {
    .project-results { flex-direction: column; }
    .awards-row { grid-template-columns: 1fr; gap: 8px; }
  }
</style>

<script>
  function initProject() {
    // Thumbnail fallback
    document.querySelectorAll<HTMLImageElement>('.yt-facade__thumb').forEach((img) => {
      const check = () => {
        if (img.naturalWidth <= 120) {
          const fb = img.dataset.fallback;
          if (fb) img.src = fb;
        }
      };
      if (img.complete) { check(); } else { img.addEventListener('load', check, { once: true }); }
    });

    // Video facades
    document.querySelectorAll<HTMLElement>('.yt-facade').forEach((facade) => {
      function activate() {
        const vid = facade.dataset.vid;
        const iframe = document.createElement('iframe');
        iframe.className = 'project-video';
        iframe.src = `https://www.youtube.com/embed/${vid}?autoplay=1&rel=0`;
        iframe.title = 'Video';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        facade.replaceWith(iframe);
      }
      facade.addEventListener('click', activate, { once: true });
      facade.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') activate();
      }, { once: true });
    });
  }

  // Scroll-triggered counters
  function initCounters() {
    const results = document.querySelector('.project-results');
    if (!results) return;

    const items = Array.from(results.querySelectorAll<HTMLElement>('.result-number'));
    let ran = false;

    function runCounters() {
      if (ran) return;
      ran = true;
      const duration = 2800;
      const start = performance.now();

      function tick(now: number) {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);

        items.forEach((el) => {
          const target   = parseFloat(el.dataset.target ?? '0');
          const decimals = parseInt(el.dataset.decimals ?? '0', 10);
          const suffix   = el.dataset.suffix ?? '';
          const current  = eased * target;
          el.textContent = `+${current.toFixed(decimals)}${suffix}`;
        });

        if (progress < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    const observer = new IntersectionObserver(
      (entries) => { if (entries[0].isIntersecting) { runCounters(); observer.disconnect(); } },
      { threshold: 0.5 }
    );
    observer.observe(results);
  }

  document.addEventListener('astro:page-load', initProject);
  document.addEventListener('astro:page-load', initCounters);
</script>
