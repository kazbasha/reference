---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Shahid x Mastercard — Gone — Reference" description="Shahid x Mastercard — Gone. Reference creative studio.">
  <main class="project-page">

    <div class="project-inner">

      <!-- Back link -->
      <a class="back-link" href="/work">
        <svg width="16" height="10" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M0.646 5.354a.5.5 0 0 1 0-.708L4.293.999a.5.5 0 1 1 .707.708L1.707 5l3.293 3.293a.5.5 0 0 1-.707.708L.646 5.354zM16 5.5H1v-1h15v1z" fill="currentColor"/>
        </svg>
        Work
      </a>

      <!-- Header -->
      <div class="project-header">
        <p class="project-client">SHAHID X MASTERCARD</p>
        <h1 class="project-title">Gone</h1>
        <p class="project-meta">Agency: Shahid &nbsp;·&nbsp; Production: Bigfoot &nbsp;·&nbsp; 2024</p>
      </div>

      <!-- Video — lite embed: thumbnail shown until user clicks, then iframe loads -->
      <div class="project-video-wrap">
        <div class="yt-facade" id="yt-facade" data-vid="omNTTUlPdOM" role="button" aria-label="Play video" tabindex="0">
          <img
            class="yt-facade__thumb"
            src="https://img.youtube.com/vi/omNTTUlPdOM/maxresdefault.jpg"
            data-fallback="https://img.youtube.com/vi/omNTTUlPdOM/hqdefault.jpg"
            alt=""
            loading="lazy"
          />
          <button class="yt-facade__play" aria-hidden="true" tabindex="-1">
            <svg viewBox="0 0 68 48" xmlns="http://www.w3.org/2000/svg">
              <path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C56 0 34 0 34 0S12 0 7.5 1.7a8.5 8.5 0 0 0-6 6C0 12.1 0 24 0 24s0 11.9 1.5 16.3a8.5 8.5 0 0 0 6 6C12 48 34 48 34 48s22 0 26.5-1.7a8.5 8.5 0 0 0 6-6C68 35.9 68 24 68 24s0-11.9-1.5-16.3z" fill="#fff" opacity="0.9"/>
              <path d="M27 34l18-10-18-10v20z" fill="#000"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Body copy -->
      <p class="project-body">
        We're all guilty of missing great deals. But with the Shahid Mastercard offer, there's no FOMO — it lasts all year. So we created a catchy earworm and rolled it out across MENA.
      </p>

    </div>
  </main>
</Layout>

<script>
  function initProject() {
    // YouTube returns a 120×90 grey placeholder (200 OK) when maxresdefault doesn't exist.
    // Detect it by natural size and swap to hqdefault.
    document.querySelectorAll<HTMLImageElement>('.yt-facade__thumb').forEach((img) => {
      const check = () => {
        if (img.naturalWidth <= 120) {
          const fb = img.dataset.fallback;
          if (fb) img.src = fb;
        }
      };
      if (img.complete) { check(); } else { img.addEventListener('load', check, { once: true }); }
    });

    const facade = document.getElementById('yt-facade') as HTMLElement;
    if (!facade) return;

    function activate() {
      const vid = facade.dataset.vid;
      const iframe = document.createElement('iframe');
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:none;';
      iframe.src = `https://www.youtube.com/embed/${vid}?autoplay=1&rel=0`;
      iframe.title = 'Shahid x Mastercard — Gone';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      facade.replaceWith(iframe);
    }

    facade.addEventListener('click', activate, { once: true });
    facade.addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === 'Enter' || e.key === ' ') activate(); }, { once: true });
  }

  document.addEventListener('astro:page-load', initProject);
</script>

<style>
  .project-page {
    min-height: 100svh;
    background: #000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .project-inner {
    width: 100%;
    max-width: clamp(320px, 88vw, 960px);
    padding: clamp(48px, 8vw, 100px) 0 clamp(80px, 10vw, 140px);
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4vw, 56px);
  }

  /* Back link */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: rgba(232, 228, 222, 0.4);
    text-decoration: none;
    font-size: clamp(9px, 0.72vw, 11px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color 0.2s ease;
    align-self: flex-start;
  }
  .back-link:hover { color: #986edf; }

  /* Header */
  .project-header {
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }

  .project-client {
    font-size: clamp(9px, 0.72vw, 11px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #986edf;
    margin: 0;
  }

  .project-meta {
    font-size: clamp(9px, 0.72vw, 11px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(232, 228, 222, 0.35);
    margin: 0;
  }

  .project-title {
    font-size: clamp(48px, 7vw, 110px);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: #e8e4de;
    margin: 0;
  }

  /* Video */
  .project-video-wrap {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 */
    height: 0;
    overflow: hidden;
    border-radius: 4px;
    background: #0a0a0a;
  }

  /* Lite embed facade */
  .yt-facade {
    position: absolute;
    inset: 0;
    cursor: none;
    overflow: hidden;
    border-radius: 4px;
  }

  .yt-facade__thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .yt-facade:hover .yt-facade__thumb {
    transform: scale(1.03);
  }

  .yt-facade__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.18);
    border: none;
    cursor: none;
    transition: background 0.25s ease;
  }

  .yt-facade:hover .yt-facade__play {
    background: rgba(0, 0, 0, 0.32);
  }

  .yt-facade__play svg {
    width: clamp(48px, 6vw, 80px);
    height: auto;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    filter: drop-shadow(0 2px 12px rgba(0,0,0,0.4));
  }

  .yt-facade:hover .yt-facade__play svg {
    transform: scale(1.1);
  }

  /* Actual iframe — hidden until facade is clicked */
  .project-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Body copy */
  .project-body {
    font-size: clamp(14px, 1.2vw, 18px);
    font-weight: 400;
    line-height: 1.65;
    color: rgba(232, 228, 222, 0.7);
    max-width: 64ch;
    margin: 0;
  }
</style>
