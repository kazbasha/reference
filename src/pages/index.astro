---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Manifesto from "../components/Manifesto.astro";
import StudioIntro from "../components/StudioIntro.astro";
---

<Layout>
  <div data-page="home">
    <Hero />
    <StudioIntro />
    <Manifesto startIndex={5} endIndex={6} />
  </div>
  <div data-page="industry" style="display:none">
    <Manifesto endIndex={5} />
  </div>
  <div data-page="about" style="display:none">
    <section class="about-page">
      <div class="about-image-wrap">
        <img src="/images/about-us.webp" alt="" class="about-img" id="about-parallax-img" />
      </div>
      <div class="about-content">
        <h2 class="about-headline">WHERE IT STARTED</h2>
        <div class="about-body">
          <p>Wembley Stadium.<br />August 2nd, 2025.<br />Oasis back on stage.<br />Two brothers. Loud. Raw.</p>
          <p>That's how great work happens.<br />Close to the people making it.<br />Hands-on. Backing instinct.<br />No committee killing it.</p>
          <p>So we started Reference. Together.<br />To take back control.</p>
          <p>Like a band.</p>
        </div>
      </div>
    </section>
    <section class="about-parallax-full"><div class="about-parallax-full__img"></div></section>
    <section class="about-been-around">
      <h2 class="about-been-around__headline">WE'VE BEEN AROUND</h2>
      <h3 class="about-been-around__pull">From indies to multinationals to <span style="white-space:nowrap">client-side.</span> We've played every stage.</h3>
      <div class="about-been-around__body">
        <div class="about-pillar">
          <h4 class="about-pillar__title">BRANDING TASTE</h4>
          <p>Started in branding, shaping high-end automotive and real estate work. Taste built early, learnt from people who now run some of the best agencies in the region.</p>
        </div>
        <div class="about-pillar">
          <h4 class="about-pillar__title">SOCIAL PIONEERS</h4>
          <p>Got in early when social and digital were still the wild west. Launched the first sites, accounts and games for the biggest brands. Helped build Digital Republic. Dentsu came knocking.</p>
        </div>
        <div class="about-pillar">
          <h4 class="about-pillar__title">CREATIVE GIANTS</h4>
          <p>Spent most of our careers at Leo Burnett, BBDO, Publicis and AKQA. Worked on the biggest brands under serious pressure. Mad. Intense. Great fun.</p>
        </div>
        <div class="about-pillar">
          <h4 class="about-pillar__title">CLIENT-SIDE IMPACT</h4>
          <p>Crossed over. Built in-house creative teams. Got closer to the business than most creatives ever will. That's where it clicked. Pretty is easy. Moving the needle isn't.</p>
        </div>
      </div>
    </section>
    <section class="about-video-full">
      <video class="about-video-full__video" src="/video/love-it.mp4" autoplay muted loop playsinline></video>
    </section>
    <section class="about-done-it-all">
      <h2 class="about-done-it-all__label">WE'VE DONE IT ALL</h2>
      <h3 class="about-done-it-all__headline">Every industry. Every channel. Entertainment at the core.</h3>
      <div class="about-done-it-all__body">
        <p>We've worked with the biggest brands, the smallest ones, and launched plenty from scratch. Along the way, we've made great work and some that taught us the hard way.</p>
        <p>We've crafted treatments for some of the biggest directors in the region and picked up awards from Lynx to Effies to Cannes. But what we love most is using creativity and entertainment to help brands win and grow. That's what we've been doing for a long time.</p>
      </div>
    </section>
    <section class="about-video-full">
      <video class="about-video-full__video" src="/video/kfc2.mp4" autoplay muted loop playsinline></video>
    </section>
    <section class="about-our-way">
      <h2 class="about-our-way__label">SO WE DO IT OUR WAY</h2>
      <h3 class="about-our-way__headline">Small team. Senior people. Hands-on from start to finish.</h3>
      <div class="about-our-way__body">
        <p>No layers. No dilution. No endless rounds of "feedback". We stay close to the work. We make the calls. We keep it creative and actually entertaining. That's the bar. We bring in the right people when needed, people we trust. That's how the work stays good.</p>
        <p>From strategy to concept to execution, production and delivery. We take it all the way. From first thought to final frame. No drop in standards. No shortcuts.</p>
        <p>That's when it becomes the benchmark.</p>
      </div>
    </section>
  </div>
  <div data-page="work" style="display:none">
  </div>
  <div data-page="contact" style="display:none">
    <Manifesto startIndex={6} />
  </div>
</Layout>

<style>
  .about-been-around {
    background: #0a0a0a;
    padding: clamp(80px, 12vw, 160px) clamp(24px, 7vw, 120px);
  }

  @keyframes ba-slide-down {
    from { opacity: 0; transform: translateY(-24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes ba-slide-right {
    from { opacity: 0; transform: translateX(-32px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  .about-been-around__headline,
  .about-been-around__pull,
  .about-done-it-all__label,
  .about-done-it-all__headline,
  .about-our-way__label,
  .about-our-way__headline {
    opacity: 0;
  }

  .about-been-around__body .about-pillar,
  .about-done-it-all__body p,
  .about-our-way__body p {
    opacity: 0;
  }

  .about-been-around.is-visible .about-been-around__headline {
    animation: ba-slide-down 2s cubic-bezier(0.16, 1, 0.3, 1) 0s forwards;
  }

  .about-been-around.is-visible .about-been-around__pull {
    animation: ba-slide-down 2s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;
  }

  .about-been-around.is-visible .about-pillar:nth-child(1) { animation: ba-slide-right 1.8s cubic-bezier(0.16, 1, 0.3, 1) 0.8s  forwards; }
  .about-been-around.is-visible .about-pillar:nth-child(2) { animation: ba-slide-right 1.8s cubic-bezier(0.16, 1, 0.3, 1) 1.2s  forwards; }
  .about-been-around.is-visible .about-pillar:nth-child(3) { animation: ba-slide-right 1.8s cubic-bezier(0.16, 1, 0.3, 1) 1.6s  forwards; }
  .about-been-around.is-visible .about-pillar:nth-child(4) { animation: ba-slide-right 1.8s cubic-bezier(0.16, 1, 0.3, 1) 2.0s  forwards; }

  .about-done-it-all.is-visible .about-done-it-all__label    { animation: ba-slide-down  2s   cubic-bezier(0.16, 1, 0.3, 1) 0s   forwards; }
  .about-done-it-all.is-visible .about-done-it-all__headline { animation: ba-slide-down  2s   cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards; }
  .about-done-it-all.is-visible .about-done-it-all__body p:nth-child(1) { animation: ba-slide-right 1.8s cubic-bezier(0.16, 1, 0.3, 1) 0.8s  forwards; }
  .about-done-it-all.is-visible .about-done-it-all__body p:nth-child(2) { animation: ba-slide-right 1.8s cubic-bezier(0.16, 1, 0.3, 1) 1.2s  forwards; }

  .about-our-way.is-visible .about-our-way__label    { animation: ba-slide-down  2s   cubic-bezier(0.16, 1, 0.3, 1) 0s   forwards; }
  .about-our-way.is-visible .about-our-way__headline { animation: ba-slide-down  2s   cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards; }
  .about-our-way.is-visible .about-our-way__body p:nth-child(1) { animation: ba-slide-right 1.8s cubic-bezier(0.16, 1, 0.3, 1) 0.8s  forwards; }
  .about-our-way.is-visible .about-our-way__body p:nth-child(2) { animation: ba-slide-right 1.8s cubic-bezier(0.16, 1, 0.3, 1) 1.2s  forwards; }
  .about-our-way.is-visible .about-our-way__body p:nth-child(3) { animation: ba-slide-right 1.8s cubic-bezier(0.16, 1, 0.3, 1) 1.6s  forwards; }

  .about-been-around__headline {
    font-family: "TrashHand", cursive;
    font-size: clamp(11px, 1vw, 14px);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(232, 228, 222, 0.5);
    margin: 0 0 2em;
  }

  .about-been-around__body {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3vw;
    margin-top: clamp(40px, 5vw, 72px);
  }

  .about-pillar {
    display: flex;
    flex-direction: column;
    gap: 1em;
  }

  .about-pillar__title {
    font-family: "ObviouslyWide", system-ui, sans-serif;
    font-size: clamp(9px, 0.7vw, 11px);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(232, 228, 222, 0.45);
    margin: 0;
  }

  .about-been-around__pull {
    font-family: "ObviouslyWide", system-ui, sans-serif;
    font-size: clamp(22px, 3vw, 48px);
    font-weight: 500;
    line-height: 1.15;
    color: #7040c0;
    margin: 0 0 0.6em;
    max-width: 70vw;
  }

  .about-been-around__body p {
    font-family: "ObviouslyWide", system-ui, sans-serif;
    font-size: clamp(11px, 0.85vw, 14px);
    font-weight: 400;
    line-height: 1.55;
    color: #e8e4de;
    margin: 0;
  }

  .about-video-full {
    height: 100svh;
    overflow: hidden;
    position: relative;
  }

  .about-video-full__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-done-it-all {
    background: #e8e4de;
    padding: clamp(80px, 12vw, 160px) clamp(24px, 7vw, 120px);
  }

  .about-done-it-all__label {
    font-family: "TrashHand", cursive;
    font-size: clamp(11px, 1vw, 14px);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(26, 26, 26, 0.5);
    margin: 0 0 2em;
  }

  .about-done-it-all__headline {
    font-family: "ObviouslyWide", system-ui, sans-serif;
    font-size: clamp(22px, 3vw, 48px);
    font-weight: 500;
    line-height: 1.15;
    color: #7040c0;
    margin: 0 0 0.6em;
    max-width: 70vw;
  }

  .about-done-it-all__body {
    display: flex;
    flex-direction: column;
    gap: 1.4em;
    max-width: 600px;
  }

  .about-done-it-all__body p {
    font-family: "ObviouslyWide", system-ui, sans-serif;
    font-size: clamp(11px, 0.85vw, 14px);
    font-weight: 400;
    line-height: 1.55;
    color: #1a1a1a;
    margin: 0;
  }

  .about-our-way {
    background: #f2c4ce;
    padding: clamp(80px, 12vw, 160px) clamp(24px, 7vw, 120px);
  }

  .about-our-way__label {
    font-family: "TrashHand", cursive;
    font-size: clamp(11px, 1vw, 14px);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(26, 26, 26, 0.5);
    margin: 0 0 2em;
  }

  .about-our-way__headline {
    font-family: "ObviouslyWide", system-ui, sans-serif;
    font-size: clamp(22px, 3vw, 48px);
    font-weight: 500;
    line-height: 1.15;
    color: #7040c0;
    margin: 0 0 0.6em;
    max-width: 70vw;
  }

  .about-our-way__body {
    display: flex;
    flex-direction: column;
    gap: 1.4em;
    max-width: 600px;
  }

  .about-our-way__body p {
    font-family: "ObviouslyWide", system-ui, sans-serif;
    font-size: clamp(11px, 0.85vw, 14px);
    font-weight: 400;
    line-height: 1.55;
    color: #1a1a1a;
    margin: 0;
  }

  .about-parallax-full {
    height: 100svh;
    overflow: hidden;
    position: relative;
  }

  .about-parallax-full__img {
    position: absolute;
    inset: -25% 0;
    background-image: url('/images/about-started2.webp');
    background-size: cover;
    background-position: center;
    will-change: transform;
  }

  .about-page {
    min-height: 100svh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    background: #0a0a0a;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(80px, 10vw, 140px) clamp(24px, 7vw, 100px);
    padding-left: clamp(16px, 4vw, 60px);
    padding-bottom: clamp(120px, 18vw, 200px);
  }

  .about-image-wrap {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin: clamp(32px, 5vw, 72px);
    margin-top: clamp(48px, 7vw, 96px);
    margin-right: clamp(16px, 3vw, 40px);
    border-radius: 4px;
    overflow: hidden;
  }

  .about-img {
    width: 55%;
    height: auto;
    display: block;
    border-radius: 4px;
    will-change: transform;
  }

  @keyframes about-reveal {
    from {
      opacity: 0;
      transform: translateY(-18px);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  .about-headline,
  .about-body p {
    opacity: 0;
  }

  .about-content.is-visible .about-headline,
  .about-content.is-visible .about-body p {
    animation: about-reveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .about-content.is-visible .about-headline        { animation-delay: 0.05s; }
  .about-content.is-visible .about-body p:nth-child(1) { animation-delay: 0.18s; }
  .about-content.is-visible .about-body p:nth-child(2) { animation-delay: 0.32s; }
  .about-content.is-visible .about-body p:nth-child(3) { animation-delay: 0.46s; }
  .about-content.is-visible .about-body p:nth-child(4) { animation-delay: 0.58s; }

  .about-headline {
    font-family: "TrashHand", cursive;
    font-size: clamp(11px, 1vw, 14px);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(232, 228, 222, 0.5);
    margin: 0 0 1.5em;
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 1.2em;
  }

  .about-body p {
    font-family: "ObviouslyWide", system-ui, sans-serif;
    font-size: clamp(13px, 1.1vw, 17px);
    font-weight: 400;
    line-height: 1.45;
    color: #e8e4de;
    margin: 0;
  }
</style>

<script>
  const parallaxImg = document.getElementById('about-parallax-img') as HTMLElement | null;
  const aboutContent = document.querySelector<HTMLElement>('.about-content');
  const parallaxFullImgs = Array.from(document.querySelectorAll<HTMLElement>('.about-parallax-full__img'));
  const beenAround = document.querySelector<HTMLElement>('.about-been-around');
  const doneItAll  = document.querySelector<HTMLElement>('.about-done-it-all');
  const ourWay     = document.querySelector<HTMLElement>('.about-our-way');

  let beenAroundTriggered = false;
  let doneItAllTriggered  = false;
  let ourWayTriggered     = false;
  let rafPending = false;

  function checkSection(el: HTMLElement | null, triggered: boolean, onTrigger: () => void) {
    if (!el || triggered) return;
    const page = el.closest<HTMLElement>('[data-page]');
    if (page && page.style.display === 'none') return;
    const top = el.getBoundingClientRect().top;
    if (top > 0 && top < window.innerHeight * 0.85) {
      el.classList.add('is-visible');
      onTrigger();
    }
  }

  function checkBeenAround() {
    checkSection(beenAround, beenAroundTriggered, () => { beenAroundTriggered = true; });
    checkSection(doneItAll,  doneItAllTriggered,  () => { doneItAllTriggered  = true; });
    checkSection(ourWay,     ourWayTriggered,     () => { ourWayTriggered     = true; });
  }

  function updateParallax() {
    if (parallaxImg) {
      const wrap = parallaxImg.parentElement!;
      const rect = wrap.getBoundingClientRect();
      const vh   = window.innerHeight;
      const progress = 1 - (rect.bottom / (vh + rect.height));
      parallaxImg.style.transform = `translateY(${(-progress * vh * 0.12).toFixed(2)}px)`;
    }
    parallaxFullImgs.forEach((img) => {
      const section = img.parentElement!;
      const rect    = section.getBoundingClientRect();
      const vh      = window.innerHeight;
      const progress = (vh - rect.top) / (vh + rect.height);
      const offset   = (progress - 0.5) * vh * 0.4;
      img.style.transform = `translateY(${offset.toFixed(2)}px)`;
    });
    checkBeenAround();
  }

  function scheduleUpdate() {
    if (!rafPending) {
      rafPending = true;
      requestAnimationFrame(() => { rafPending = false; updateParallax(); });
    }
  }

  (window as any).__initAboutParallax = () => {
    updateParallax();
    if (aboutContent) {
      aboutContent.classList.remove('is-visible');
      void aboutContent.offsetWidth;
      aboutContent.classList.add('is-visible');
    }
  };

  (window as any).__initBeenAround = () => {
    beenAroundTriggered = false;
    doneItAllTriggered  = false;
    ourWayTriggered     = false;
    beenAround?.classList.remove('is-visible');
    doneItAll?.classList.remove('is-visible');
    ourWay?.classList.remove('is-visible');
    checkBeenAround();
  };

  window.addEventListener('scroll', scheduleUpdate, { passive: true });
  updateParallax();
</script>
