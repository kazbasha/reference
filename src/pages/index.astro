---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Manifesto from "../components/Manifesto.astro";
import StudioIntro from "../components/StudioIntro.astro";
---

<Layout>
  <Hero />
  <StudioIntro />
  <div class="home-video-full">
    <video class="home-video-full__video" src="/video/hand.mp4" autoplay muted loop playsinline></video>
  </div>
  <Manifesto startIndex={5} endIndex={6} />

  <script>
    document.addEventListener('astro:page-load', () => {
      const btn = document.querySelector<HTMLAnchorElement>('.home-cta__btn');
      if (!btn) return;
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        import('astro:transitions/client').then(({ navigate }) => navigate('/contact'));
      });
    });
  </script>

  <section class="home-cta">
    <p class="home-cta__text">We're not here to follow the reference. We're here to be it.</p>
    <a class="home-cta__btn" href="/contact">GET IN TOUCH</a>
  </section>
</Layout>

<style>
  .home-cta {
    background: #e8e4de;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(80px, 12vw, 160px) clamp(24px, 6vw, 80px);
  }

  .home-cta__text {
    font-family: "ObviouslyWide", system-ui, sans-serif;
    font-size: clamp(22px, 3.6vw, 58px);
    font-weight: 400;
    color: #111;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0;
    max-width: 26em;
  }

  .home-cta__btn {
    margin-top: clamp(36px, 5vw, 64px);
    display: inline-block;
    padding: 14px 36px;
    border: 2px solid #111;
    color: #111;
    font-family: "ObviouslyWide", system-ui, sans-serif;
    font-size: clamp(9px, 0.8vw, 12px);
    font-weight: 400;
    letter-spacing: 0.22em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .home-cta__btn:hover {
    background: #111;
    color: #e8e4de;
  }
</style>
