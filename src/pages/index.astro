    font-weight: 400;
    line-height: 1.45;
    color: #e8e4de;
    margin: 0;
  }
</style>

<script>
  const parallaxImg = document.getElementById('about-parallax-img') as HTMLElement | null;
  const aboutContent    = document.querySelector<HTMLElement>('.about-content');
  const aboutContentTop = document.querySelector<HTMLElement>('.about-content-top');
  const parallaxFullImgs = Array.from(document.querySelectorAll<HTMLElement>('.about-parallax-full__img'));
  const beenAround = document.querySelector<HTMLElement>('.about-been-around');
  const doneItAll  = document.querySelector<HTMLElement>('.about-done-it-all');
  const ourWay     = document.querySelector<HTMLElement>('.about-our-way');

  let beenAroundTriggered = false;
  let doneItAllTriggered  = false;
  let ourWayTriggered     = false;


  function checkSection(el: HTMLElement | null, triggered: boolean, onTrigger: () => void) {
    if (!el || triggered) return;
    const page = el.closest<HTMLElement>('[data-page]');
    if (page && page.style.display === 'none') return;
    const top = el.getBoundingClientRect().top;
    if (top > 0 && top < window.innerHeight * 0.85) {
      el.classList.add('is-visible');
      onTrigger();
    }
  }

  function checkBeenAround() {
    checkSection(beenAround, beenAroundTriggered, () => { beenAroundTriggered = true; });
    checkSection(doneItAll,  doneItAllTriggered,  () => { doneItAllTriggered  = true; });
    checkSection(ourWay,     ourWayTriggered,     () => { ourWayTriggered     = true; });
  }

  function updateParallax() {
    if (parallaxImg && window.innerWidth > 640) {
      const wrap = parallaxImg.parentElement!;
      const rect = wrap.getBoundingClientRect();
      const vh   = window.innerHeight;
      const progress = 1 - (rect.bottom / (vh + rect.height));
      parallaxImg.style.transform = `translate3d(0, ${(-progress * vh * 0.12).toFixed(2)}px, 0)`;
    } else if (parallaxImg && window.innerWidth <= 640) {
      parallaxImg.style.transform = '';
    }
    parallaxFullImgs.forEach((img) => {
      const section = img.parentElement!;
      const rect    = section.getBoundingClientRect();
      const vh      = window.innerHeight;
      const progress = (vh - rect.top) / (vh + rect.height);
      const offset   = (progress - 0.5) * vh * 0.4;
      img.style.transform = `translate3d(0, ${offset.toFixed(2)}px, 0)`;
    });
    checkBeenAround();
  }

  // Continuous rAF loop — keeps parallax smooth on mobile during momentum scrolling
  // Animate grain seed every frame for moving film-grain effect
  const grainTurb = document.getElementById('wg-turb') as SVGFETurbulenceElement | null;
  let grainSeed = 0;

  function loop() {
    updateParallax();
    if (grainTurb) {
      grainSeed = (grainSeed + 1) % 9999;
      grainTurb.setAttribute('seed', String(grainSeed));
    }
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);

  (window as any).__initAboutParallax = () => {
    updateParallax();
    if (aboutContent) {
      aboutContent.classList.remove('is-visible');
      aboutContentTop?.classList.remove('is-visible');
      void aboutContent.offsetWidth;
      aboutContent.classList.add('is-visible');
      aboutContentTop?.classList.add('is-visible');
    }
  };

  (window as any).__initBeenAround = () => {
    beenAroundTriggered = false;
    doneItAllTriggered  = false;
    ourWayTriggered     = false;
    beenAround?.classList.remove('is-visible');
    doneItAll?.classList.remove('is-visible');
    ourWay?.classList.remove('is-visible');
    checkBeenAround();
  };

  // Mobile pillar slider
  const pillarsTrack   = document.querySelector<HTMLElement>('.about-pillars-track');
  const pillarsCounter = document.querySelector<HTMLElement>('.about-pillars-counter');
  const pillarsPrev    = document.querySelector<HTMLElement>('.about-pillars-prev');
  const pillarsNext    = document.querySelector<HTMLElement>('.about-pillars-next');
  const pillarsTotal   = document.querySelectorAll('.about-pillar').length;
  let pillarCurrent    = 0;

  function goToPillar(index: number) {
    pillarCurrent = Math.max(0, Math.min(pillarsTotal - 1, index));
    if (pillarsTrack) {
      pillarsTrack.style.transform = `translateX(-${pillarCurrent * 100}%)`;
    }
    if (pillarsCounter) {
      const n = String(pillarCurrent + 1).padStart(2, '0');
      const t = String(pillarsTotal).padStart(2, '0');
      pillarsCounter.textContent = `${n} / ${t}`;
    }
  }

  pillarsPrev?.addEventListener('click', () => goToPillar(pillarCurrent - 1));
  pillarsNext?.addEventListener('click', () => goToPillar(pillarCurrent + 1));

  // Touch swipe for pillars
  let pillarTouchStartX = 0;
  pillarsTrack?.addEventListener('touchstart', (e) => {
    pillarTouchStartX = e.touches[0].clientX;
  }, { passive: true });
  pillarsTrack?.addEventListener('touchend', (e) => {
    const diff = pillarTouchStartX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 40) goToPillar(diff > 0 ? pillarCurrent + 1 : pillarCurrent - 1);
  }, { passive: true });

  // ── Work video cards ──
  const workBg = document.querySelector<HTMLElement>('.work-bg');
  const workCardEls = document.querySelectorAll<HTMLElement>('.work-card');
  const workDefaultBg = '#1a4a6e';
  const cursorLabel = document.querySelector<HTMLElement>('.work-cursor-label');

  // Off-screen canvas for color sampling
  const colorProbe = document.createElement('canvas');
  colorProbe.width = 16;
  colorProbe.height = 16;
  const colorCtx = colorProbe.getContext('2d', { willReadFrequently: true });

  function sampleColor(video: HTMLVideoElement): string {
    if (!colorCtx) return workDefaultBg;
    try {
      colorCtx.drawImage(video, 0, 0, 16, 16);
      const d = colorCtx.getImageData(0, 0, 16, 16).data;
      let r = 0, g = 0, b = 0;
      const n = d.length / 4;
      for (let i = 0; i < d.length; i += 4) { r += d[i]; g += d[i+1]; b += d[i+2]; }
      return `rgb(${Math.round(r/n)},${Math.round(g/n)},${Math.round(b/n)})`;
    } catch { return workDefaultBg; }
  }

  workCardEls.forEach((card) => {
    const video = card.querySelector<HTMLVideoElement>('.work-card__video');
    if (!video) return;

    // Sample first frame color once data is available
    video.addEventListener('loadeddata', () => {
      card.dataset.color = sampleColor(video);
    }, { once: true });

    card.addEventListener('mouseenter', () => {
      video.muted = false;
      video.currentTime = 0;
      video.play();
      if (workBg) workBg.style.backgroundColor = card.dataset.color || workDefaultBg;
      if (cursorLabel) {
        cursorLabel.textContent = card.dataset.label || '';
        cursorLabel.classList.add('is-visible');
      }
    });

    card.addEventListener('mousemove', (e) => {
      if (cursorLabel) {
        cursorLabel.style.left = `${e.clientX}px`;
        cursorLabel.style.top  = `${e.clientY}px`;
      }
    });

    card.addEventListener('mouseleave', () => {
      video.muted = true;
      video.pause();
      video.currentTime = 0;
      if (workBg) workBg.style.backgroundColor = workDefaultBg;
      if (cursorLabel) cursorLabel.classList.remove('is-visible');
    });
  });
</script>
