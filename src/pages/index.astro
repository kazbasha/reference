---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Manifesto from "../components/Manifesto.astro";
import StudioIntro from "../components/StudioIntro.astro";
---

<Layout>
  <div data-page="home">
    <Hero />
    <StudioIntro />
    <Manifesto startIndex={5} endIndex={6} />
  </div>
  <div data-page="industry" style="display:none">
    <Manifesto endIndex={5} />
  </div>
  <div data-page="about" style="display:none">
    <section class="about-page">
      <div class="about-image-wrap">
        <img src="/images/about-us.webp" alt="" class="about-img" id="about-parallax-img" />
      </div>
      <div class="about-content">
        <h2 class="about-headline">WHERE IT STARTED</h2>
        <div class="about-body">
          <p>Wembley Stadium.<br />August 2nd, 2025.<br />Oasis back on stage.<br />Two brothers. Loud. Raw.</p>
          <p>That's how great work happens.<br />Close to the people making it.<br />Hands-on. Backing instinct.<br />No committee killing it.</p>
          <p>So we started Reference. Together.<br />To take back control.</p>
          <p>Like a band.</p>
        </div>
      </div>
    </section>
    <section class="about-parallax-full"></section>
    <section class="about-been-around">
      <h2 class="about-been-around__headline">WE'VE BEEN AROUND</h2>
      <div class="about-been-around__body">
        <p>We started in branding, learning from some of the best. Then helped pioneer social and digital across the region, before moving into agencies like Leo Burnett, BBDO, AKQA and M&C Saatchi, and spending time at Hill + Knowlton.</p>
        <p>Then we went client-side. Built teams, ran studios, and saw what actually matters.</p>
        <p>We've worked across everything. Big brands, small ones, and the ones still figuring it out.</p>
        <p>We made the work, won the awards from Lynx to Effies to Cannes, and yes, cut a very convincing case study film. We know how to make it look good. That's the easy part.</p>
        <p>What matters is whether it actually moves something.</p>
        <p>So we know the difference between what looks good… and what works.</p>
      </div>
    </section>
  </div>
  <div data-page="work" style="display:none">
  </div>
  <div data-page="contact" style="display:none">
    <Manifesto startIndex={6} />
  </div>
</Layout>

<style>
  .about-been-around {
    background: #0a0a0a;
    padding: clamp(80px, 12vw, 160px) clamp(24px, 7vw, 120px);
  }

  .about-been-around__headline {
    font-family: "ObviouslyWide", system-ui, sans-serif;
    font-size: clamp(11px, 1vw, 14px);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(232, 228, 222, 0.5);
    margin: 0 0 2em;
  }

  .about-been-around__body {
    display: flex;
    flex-direction: column;
    gap: 1.4em;
    max-width: 600px;
  }

  .about-been-around__body p {
    font-family: "ObviouslyWide", system-ui, sans-serif;
    font-size: clamp(13px, 1.1vw, 17px);
    font-weight: 400;
    line-height: 1.55;
    color: #e8e4de;
    margin: 0;
  }

  .about-parallax-full {
    height: 100svh;
    background-image: url('/images/about-started.webp');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
  }

  .about-page {
    min-height: 100svh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    background: #0a0a0a;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(80px, 10vw, 140px) clamp(24px, 7vw, 100px);
    padding-left: clamp(16px, 4vw, 60px);
    padding-bottom: clamp(120px, 18vw, 200px);
  }

  .about-image-wrap {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin: clamp(32px, 5vw, 72px);
    margin-top: clamp(48px, 7vw, 96px);
    margin-right: clamp(16px, 3vw, 40px);
    border-radius: 4px;
    overflow: hidden;
  }

  .about-img {
    width: 55%;
    height: auto;
    display: block;
    border-radius: 4px;
    will-change: transform;
  }

  @keyframes about-reveal {
    from {
      opacity: 0;
      transform: translateY(-18px);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  .about-headline,
  .about-body p {
    opacity: 0;
  }

  .about-content.is-visible .about-headline,
  .about-content.is-visible .about-body p {
    animation: about-reveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .about-content.is-visible .about-headline        { animation-delay: 0.05s; }
  .about-content.is-visible .about-body p:nth-child(1) { animation-delay: 0.18s; }
  .about-content.is-visible .about-body p:nth-child(2) { animation-delay: 0.32s; }
  .about-content.is-visible .about-body p:nth-child(3) { animation-delay: 0.46s; }
  .about-content.is-visible .about-body p:nth-child(4) { animation-delay: 0.58s; }

  .about-headline {
    font-family: "ObviouslyWide", system-ui, sans-serif;
    font-size: clamp(11px, 1vw, 14px);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(232, 228, 222, 0.5);
    margin: 0 0 1.5em;
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 1.2em;
  }

  .about-body p {
    font-family: "ObviouslyWide", system-ui, sans-serif;
    font-size: clamp(13px, 1.1vw, 17px);
    font-weight: 400;
    line-height: 1.45;
    color: #e8e4de;
    margin: 0;
  }
</style>

<script>
  const parallaxImg = document.getElementById('about-parallax-img') as HTMLElement | null;

  function updateParallax() {
    if (!parallaxImg) return;
    const wrap = parallaxImg.parentElement!;
    const rect = wrap.getBoundingClientRect();
    const vh   = window.innerHeight;
    // progress: 0 when wrap bottom enters viewport, 1 when wrap top exits
    const progress = 1 - (rect.bottom / (vh + rect.height));
    const offset   = progress * vh * 0.12;
    parallaxImg.style.transform = `translateY(${-offset.toFixed(2)}px)`;
  }

  let rafPending = false;
  function scheduleParallax() {
    if (!rafPending) {
      rafPending = true;
      requestAnimationFrame(() => { rafPending = false; updateParallax(); });
    }
  }

  const aboutContent = document.querySelector<HTMLElement>('.about-content');

  function triggerAboutAnimation() {
    if (!aboutContent) return;
    aboutContent.classList.remove('is-visible');
    // Force reflow so removing the class resets the animation
    void aboutContent.offsetWidth;
    aboutContent.classList.add('is-visible');
  }

  (window as any).__initAboutParallax = () => {
    updateParallax();
    triggerAboutAnimation();
  };

  window.addEventListener('scroll', scheduleParallax, { passive: true });
  updateParallax();
</script>
