---
import Layout from "../layouts/Layout.astro";
import WorkScene from "../components/WorkScene.astro";
---

<Layout title="Work — Reference | Brand Campaigns & Creative Projects" description="Selected work from Reference creative studio. Entertainment-led brand campaigns, social content, and integrated creative for Shahid, AXE, KFC, Rexona, and more.">
  <section class="work-intro">
    <p class="work-intro__label">Selected Work</p>
    <p class="work-intro__text">Made with partners who back bold ideas. And fight for them until they exist.</p>
  </section>
  <div class="work-scene">
    <WorkScene>
    <!-- Cards scroll over the sticky bg -->
    <div class="work-cards">
      <div class="work-card-wrap" data-href="/work/axe-evolution">
        <div class="work-card work-card--1" data-label="AXE — EVOLUTION OF HOOKING UP">
          <img class="work-card__poster" src="/images/work/axe-evolution.webp" alt="" loading="eager" fetchpriority="high" decoding="async" />
          <video class="work-card__video" data-src="/video/work/axe%20-%20evolution.mp4" muted playsinline preload="none" loop></video>
        </div>
        <span class="work-card__mobile-label">AXE — EVOLUTION OF HOOKING UP</span>
      </div>
      <div class="work-card-wrap" data-href="/work/al-diriyah-fc-underdogs">
        <div class="work-card work-card--2" data-label="AL DIRIYAH FC — UNDERDOGS">
          <img class="work-card__poster" src="/images/work/al-diriyah-fc-underdogs.webp" alt="" loading="eager" fetchpriority="high" decoding="async" />
          <video class="work-card__video" data-src="/video/work/al%20dirriyah%20fc%20-%20underdogs.mp4" muted playsinline preload="none" loop></video>
        </div>
        <span class="work-card__mobile-label">AL DIRIYAH FC — UNDERDOGS</span>
      </div>
      <div class="work-card-wrap" data-href="/work/shahid-epic-originals">
        <div class="work-card work-card--3" data-label="SHAHID — EPIC ORIGINALS">
          <img class="work-card__poster" src="/images/work/shahid-epic-originals.webp" alt="" loading="lazy" decoding="async" />
          <video class="work-card__video" data-src="/video/work/shahid%20-%20epic%20originals.mp4" muted playsinline preload="none" loop></video>
        </div>
        <span class="work-card__mobile-label">SHAHID — EPIC ORIGINALS</span>
      </div>
      <div class="work-card-wrap" data-href="/work/du-love-it">
        <div class="work-card work-card--4" data-label="DU — LOVE IT">
          <img class="work-card__poster" src="/images/work/du-love-it.webp" alt="" loading="lazy" decoding="async" />
          <video class="work-card__video" data-src="/video/work/du%20-%20love%20it.mp4" muted playsinline preload="none" loop></video>
        </div>
        <span class="work-card__mobile-label">DU — LOVE IT</span>
      </div>
      <div class="work-card-wrap" data-href="/work/kfc-winner-winner-chicken-dinner">
        <div class="work-card work-card--5" data-label="KFC — WINNER WINNER CHICKEN DINNER">
          <img class="work-card__poster" src="/images/work/kfc-winner-winner-chicken-dinner.webp" alt="" loading="lazy" decoding="async" />
          <video class="work-card__video" data-src="/video/work/kfc%20-%20winner%20winner%20chicken%20dinner.mp4" muted playsinline preload="none" loop></video>
        </div>
        <span class="work-card__mobile-label">KFC — WINNER WINNER CHICKEN DINNER</span>
      </div>
      <div class="work-card-wrap" data-href="/work/axe-wingman">
        <div class="work-card work-card--6" data-label="AXE — WINGMAN">
          <img class="work-card__poster" src="/images/work/axe-wingman.webp" alt="" loading="lazy" decoding="async" />
          <video class="work-card__video" data-src="/video/work/axe%20-%20wingman.mp4" muted playsinline preload="none" loop></video>
        </div>
        <span class="work-card__mobile-label">AXE — WINGMAN</span>
      </div>
      <div class="work-card-wrap" data-href="/work/abtal-x-la-liga-made-for-champions">
        <div class="work-card work-card--7" data-label="ABTAL X LA LIGA — MADE FOR CHAMPIONS">
          <img class="work-card__poster" src="/images/work/abtal-x-la-liga-made-for-champions.webp" alt="" loading="lazy" decoding="async" />
          <video class="work-card__video" data-src="/video/work/abtal%20x%20la%20liga%20-%20made%20for%20champions.mp4" muted playsinline preload="none" loop></video>
        </div>
        <span class="work-card__mobile-label">ABTAL X LA LIGA — MADE FOR CHAMPIONS</span>
      </div>
      <div class="work-card-wrap" data-href="/work/cst-the-hand">
        <div class="work-card work-card--8" data-label="CST — THE HAND">
          <img class="work-card__poster" src="/images/work/cst-the-hand.webp" alt="" loading="lazy" decoding="async" />
          <video class="work-card__video" data-src="/video/work/cst%20-%20the%20hand.mp4" muted playsinline preload="none" loop></video>
        </div>
        <span class="work-card__mobile-label">CST — THE HAND</span>
      </div>
      <div class="work-card-wrap" data-href="/work/rexona-alphabet-of-cheering">
        <div class="work-card work-card--9" data-label="REXONA — ALPHABET OF CHEERING">
          <img class="work-card__poster" src="/images/work/rexona-alphabet-of-cheering.webp" alt="" loading="lazy" decoding="async" />
          <video class="work-card__video" data-src="/video/work/rexona%20-%20alphabet%20of%20cheering.mp4" muted playsinline preload="none" loop></video>
        </div>
        <span class="work-card__mobile-label">REXONA — ALPHABET OF CHEERING</span>
      </div>
      <div class="work-card-wrap" data-href="/work/shahid-no-escape">
        <div class="work-card work-card--10" data-label="SHAHID — NO ESCAPE">
          <img class="work-card__poster" src="/images/work/shahid-no-escape.webp" alt="" loading="lazy" decoding="async" />
          <video class="work-card__video" data-src="/video/work/shahid%20-%20watch%20alone.mp4" muted playsinline preload="none" loop></video>
        </div>
        <span class="work-card__mobile-label">SHAHID — NO ESCAPE</span>
      </div>
      <div class="work-card-wrap" data-href="/work/shahid-x-mastercard">
        <div class="work-card work-card--11" data-label="SHAHID X MASTERCARD — GONE">
          <img class="work-card__poster" src="/images/work/shahid-x-mastercard.webp" alt="" loading="lazy" decoding="async" />
          <video class="work-card__video" data-src="/video/work/shahid%20x%20mastercard%20-%20gone.mp4" muted playsinline preload="none" loop></video>
        </div>
        <span class="work-card__mobile-label">SHAHID X MASTERCARD — GONE</span>
      </div>
      <div class="work-card-wrap" data-href="/work/shahid-devils-promise">
        <div class="work-card work-card--12" data-label="SHAHID — THE DEVIL'S PROMISE" data-color="rgb(35,15,55)">
          <img class="work-card__img" src="/images/work/shahid-devils-promise.webp" alt="Shahid — The Devil's Promise campaign by Reference" loading="lazy" decoding="async" />
        </div>
        <span class="work-card__mobile-label">SHAHID — THE DEVIL'S PROMISE</span>
      </div>
    </div>
    </WorkScene>
  </div>

  <div class="work-cta">
    <p class="work-cta__headline">Like what you see?</p>
    <a class="work-cta__btn" href="/contact" id="work-cta-btn">
      <span>WORK WITH US</span>
      <svg width="24" height="14" viewBox="0 0 24 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M23.354 7.354a.5.5 0 0 0 0-.708L18.5 1.79a.5.5 0 1 0-.707.707L22.293 7l-4.5 4.5a.5.5 0 0 0 .707.707l4.854-4.853zM0 7.5h23v-1H0v1z" fill="currentColor"/>
      </svg>
    </a>
  </div>
</Layout>

<style>
  .work-intro {
    position: relative;
    z-index: 5;
    padding: clamp(80px, 10vw, 140px) 6% 0;
  }

  .work-intro__label {
    font-size: clamp(48px, 7vw, 110px);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: #f2c4ce;
    margin: 0 0 clamp(12px, 1.2vw, 20px);
    margin-left: -6px;
  }

  .work-intro__text {
    font-size: clamp(15px, 1.3vw, 20px);
    font-weight: 400;
    line-height: 1.65;
    color: rgba(232, 228, 222, 0.7);
    max-width: 60ch;
    margin: 0;
  }

  .work-cta {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(24px, 3vw, 40px);
    padding: clamp(60px, 7vw, 120px) clamp(24px, 7vw, 120px) clamp(60px, 8vw, 100px);
    margin-top: 0;
  }

  .work-cta__headline {
    font-size: clamp(16px, 4.8vw, 76px);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: #e8e4de;
    margin: 0;
    text-align: center;
  }

  /* Matches .home-cta__btn / .featured-work-cta — same look and hover flip,
     full width via align-self:stretch inside the flex-column parent. */
  .work-cta__btn {
    display: flex;
    align-self: stretch;
    align-items: center;
    justify-content: center;
    gap: clamp(18px, 2vw, 32px);
    padding: clamp(20px, 3vw, 40px) clamp(24px, 6vw, 80px);
    border: 2px solid #0a0a0a;
    border-radius: 6px;
    background: #0a0a0a;
    color: #986edf;
    font-family: "ObviouslyWide", system-ui, sans-serif;
    font-size: clamp(10px, 1.4vw, 20px);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.35s ease, color 0.35s ease, border-color 0.35s ease;
  }

  .work-cta__btn svg {
    width: clamp(14px, 1.7vw, 24px);
    height: auto;
    flex-shrink: 0;
  }

  .work-cta__btn:hover {
    background: #986edf;
    color: #0a0a0a;
    border-color: #986edf;
  }

  @media (max-width: 768px) {
    .work-cta {
      margin-top: 40px;
    }
  }

  @media (max-width: 640px) {
    .work-intro {
      background: #1a4a6e;
    }
    .work-cta {
      background: #1a4a6e;
      margin-top: -1px;
      padding-top: clamp(40px, 8vw, 60px);
    }
  }

</style>

<script>
  // Card / bg / cursor-label interactions live in <WorkScene>.
  // Only the local page CTA hookup remains here.
  document.addEventListener('astro:page-load', () => {
    const ctaBtn = document.getElementById('work-cta-btn') as HTMLAnchorElement | null;
    if (ctaBtn) {
      ctaBtn.addEventListener('click', (e) => {
        e.preventDefault();
        import('astro:transitions/client').then(({ navigate }) => navigate('/contact'));
      });
    }
  });
</script>
