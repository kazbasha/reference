---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Work — Reference | Brand Campaigns & Creative Projects" description="Selected work from Reference creative studio. Entertainment-led brand campaigns, social content, and integrated creative for Shahid, AXE, KFC, Rexona, and more.">
  <section class="work-intro">
    <p class="work-intro__label">Selected Work</p>
    <p class="work-intro__text">Made with partners who back bold ideas. And fight for them until they exist.</p>
  </section>
  <div class="work-scene">
    <!-- Sticky background — stays in viewport while cards scroll -->
    <div class="work-bg">
      <div class="work-blob work-blob--1"></div>
      <div class="work-blob work-blob--2"></div>
      <div class="work-blob work-blob--3"></div>
      <div class="work-blob work-blob--4"></div>
      <svg class="work-grain" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <filter id="wg">
          <feTurbulence id="wg-turb" type="turbulence" baseFrequency="0.70" numOctaves="1" seed="0" stitchTiles="stitch"/>
          <feColorMatrix type="saturate" values="0"/>
        </filter>
        <rect width="100%" height="100%" filter="url(#wg)"/>
      </svg>
    </div>

    <!-- Cards scroll over the sticky bg -->
    <div class="work-cards">
      <div class="work-card-wrap" data-href="/work/axe-evolution">
        <div class="work-card work-card--1" data-label="AXE — EVOLUTION OF HOOKING UP">
          <video class="work-card__video" src="/video/work/axe%20-%20evolution.mp4" autoplay muted playsinline preload="metadata" loop></video>
        </div>
        <span class="work-card__mobile-label">AXE — EVOLUTION OF HOOKING UP</span>
      </div>
      <div class="work-card-wrap">
        <div class="work-card work-card--2" data-label="AL DIRIYAH FC — UNDERDOGS">
          <video class="work-card__video" src="/video/work/al%20dirriyah%20fc%20-%20underdogs.mp4" autoplay muted playsinline preload="metadata" loop></video>
        </div>
        <span class="work-card__mobile-label">AL DIRIYAH FC — UNDERDOGS</span>
      </div>
      <div class="work-card-wrap" data-href="/work/axe-wingman">
        <div class="work-card work-card--3" data-label="AXE — WINGMAN">
          <video class="work-card__video" src="/video/work/axe%20-%20wingman.mp4" autoplay muted playsinline preload="metadata" loop></video>
        </div>
        <span class="work-card__mobile-label">AXE — WINGMAN</span>
      </div>
      <div class="work-card-wrap">
        <div class="work-card work-card--4" data-label="DU — LOVE IT">
          <video class="work-card__video" src="/video/work/du%20-%20love%20it.mp4" autoplay muted playsinline preload="metadata" loop></video>
        </div>
        <span class="work-card__mobile-label">DU — LOVE IT</span>
      </div>
      <div class="work-card-wrap">
        <div class="work-card work-card--5" data-label="KFC — WINNER WINNER CHICKEN DINNER">
          <video class="work-card__video" src="/video/work/kfc%20-%20winner%20winner%20chicken%20dinner.mp4" autoplay muted playsinline preload="metadata" loop></video>
        </div>
        <span class="work-card__mobile-label">KFC — WINNER WINNER CHICKEN DINNER</span>
      </div>
      <div class="work-card-wrap" data-href="/work/shahid-epic-originals">
        <div class="work-card work-card--6" data-label="SHAHID — EPIC ORIGINALS">
          <video class="work-card__video" src="/video/work/shahid%20-%20epic%20originals.mp4" autoplay muted playsinline preload="metadata" loop></video>
        </div>
        <span class="work-card__mobile-label">SHAHID — EPIC ORIGINALS</span>
      </div>
      <div class="work-card-wrap">
        <div class="work-card work-card--7" data-label="ABTAL X LA LIGA — MADE FOR CHAMPIONS">
          <video class="work-card__video" src="/video/work/abtal%20x%20la%20liga%20-%20made%20for%20champions.mp4" autoplay muted playsinline preload="metadata" loop></video>
        </div>
        <span class="work-card__mobile-label">ABTAL X LA LIGA — MADE FOR CHAMPIONS</span>
      </div>
      <div class="work-card-wrap">
        <div class="work-card work-card--8" data-label="CST — THE HAND">
          <video class="work-card__video" src="/video/work/cst%20-%20the%20hand.mp4" autoplay muted playsinline preload="metadata" loop></video>
        </div>
        <span class="work-card__mobile-label">CST — THE HAND</span>
      </div>
      <div class="work-card-wrap">
        <div class="work-card work-card--9" data-label="REXONA — ALPHABET OF CHEERING">
          <video class="work-card__video" src="/video/work/rexona%20-%20alphabet%20of%20cheering.mp4" autoplay muted playsinline preload="metadata" loop></video>
        </div>
        <span class="work-card__mobile-label">REXONA — ALPHABET OF CHEERING</span>
      </div>
      <div class="work-card-wrap" data-href="/work/shahid-no-escape">
        <div class="work-card work-card--10" data-label="SHAHID — NO ESCAPE">
          <video class="work-card__video" src="/video/work/shahid%20-%20watch%20alone.mp4" autoplay muted playsinline preload="metadata" loop></video>
        </div>
        <span class="work-card__mobile-label">SHAHID — NO ESCAPE</span>
      </div>
      <div class="work-card-wrap" data-href="/work/shahid-x-mastercard">
        <div class="work-card work-card--11" data-label="SHAHID X MASTERCARD — GONE">
          <video class="work-card__video" src="/video/work/shahid%20x%20mastercard%20-%20gone.mp4" autoplay muted playsinline preload="metadata" loop></video>
        </div>
        <span class="work-card__mobile-label">SHAHID X MASTERCARD — GONE</span>
      </div>
      <div class="work-card-wrap" data-href="/work/shahid-devils-promise">
        <div class="work-card work-card--12" data-label="SHAHID — THE DEVIL'S PROMISE" data-color="rgb(35,15,55)">
          <img class="work-card__img" src="/images/work/shahid-devils-promise.webp" alt="Shahid — The Devil's Promise campaign by Reference" loading="lazy" />
        </div>
        <span class="work-card__mobile-label">SHAHID — THE DEVIL'S PROMISE</span>
      </div>
    </div>
    <div class="work-cursor-label" aria-hidden="true"></div>
  </div>

  <div class="work-cta">
    <p class="work-cta__headline">Like what you see?</p>
    <a class="work-cta__btn" href="/contact" id="work-cta-btn">WORK WITH US</a>
  </div>
</Layout>

<style>
  .work-intro {
    position: relative;
    z-index: 5;
    padding: clamp(80px, 10vw, 140px) 6% 0;
  }

  .work-intro__label {
    font-size: clamp(48px, 7vw, 110px);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: #f2c4ce;
    margin: 0 0 clamp(12px, 1.2vw, 20px);
    margin-left: -6px;
  }

  .work-intro__text {
    font-size: clamp(15px, 1.3vw, 20px);
    font-weight: 400;
    line-height: 1.65;
    color: rgba(232, 228, 222, 0.7);
    max-width: 60ch;
    margin: 0;
  }

  .work-cta {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(24px, 3vw, 40px);
    padding: clamp(60px, 7vw, 120px) clamp(24px, 7vw, 120px) clamp(60px, 8vw, 100px);
    margin-top: 0;
  }

  .work-cta__headline {
    font-size: clamp(16px, 4.8vw, 76px);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: #e8e4de;
    margin: 0;
    text-align: center;
  }

  .work-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-family: "ObviouslyWide", system-ui, sans-serif;
    font-size: clamp(9px, 0.7vw, 11px);
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #986edf;
    text-decoration: none;
    border: 1px solid rgba(152, 110, 223, 0.35);
    border-radius: 4px;
    background: #000;
    padding: 14px 28px;
    transition:
      background 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.25s ease,
      padding 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .work-cta__btn:hover {
    background: #0d0318;
    border-color: rgba(152, 110, 223, 0.7);
    padding-left: 42px;
    padding-right: 42px;
  }

  @media (max-width: 768px) {
    .work-cta {
      margin-top: 40px;
    }
  }

  @media (max-width: 640px) {
    .work-intro {
      background: #1a4a6e;
    }
    .work-cta {
      background: #1a4a6e;
      margin-top: -1px;
      padding-top: clamp(40px, 8vw, 60px);
    }
  }

</style>

<script>
  let _workAC: AbortController | null = null;

  function initWork() {
    if (!document.querySelector('.work-card')) return; // not on work page
    _workAC?.abort();
    _workAC = new AbortController();
    const { signal } = _workAC;

    // Grain animation loop — stops on navigation
    const grainTurb = document.getElementById('wg-turb') as SVGFETurbulenceElement | null;
    let grainSeed = 0;
    function loop() {
      if (signal.aborted) return;
      if (grainTurb) {
        grainSeed = (grainSeed + 1) % 9999;
        grainTurb.setAttribute('seed', String(grainSeed));
      }
      requestAnimationFrame(loop);
    }
    requestAnimationFrame(loop);

    // Work video cards
    const workBg      = document.querySelector<HTMLElement>('.work-bg');
    const workCardEls = document.querySelectorAll<HTMLElement>('.work-card');
    const cursorLabel = document.querySelector<HTMLElement>('.work-cursor-label');
    const workDefaultBg = '#1a4a6e';

    const colorProbe = document.createElement('canvas');
    colorProbe.width = 16; colorProbe.height = 16;
    const colorCtx = colorProbe.getContext('2d', { willReadFrequently: true });

    function sampleColor(video: HTMLVideoElement): string {
      if (!colorCtx) return workDefaultBg;
      try {
        colorCtx.drawImage(video, 0, 0, 16, 16);
        const d = colorCtx.getImageData(0, 0, 16, 16).data;
        let r = 0, g = 0, b = 0;
        const n = d.length / 4;
        for (let i = 0; i < d.length; i += 4) { r += d[i]; g += d[i+1]; b += d[i+2]; }
        return `rgb(${Math.round(r/n)},${Math.round(g/n)},${Math.round(b/n)})`;
      } catch { return workDefaultBg; }
    }

    const isTouch = !window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    // On mobile: play only the video entering the viewport, pause others
    let mobileObserver: IntersectionObserver | null = null;
    if (isTouch) {
      mobileObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const vid = (entry.target as HTMLElement).querySelector<HTMLVideoElement>('.work-card__video');
          if (!vid) return;
          if (entry.isIntersecting) { vid.play().catch(() => {}); }
          else { vid.pause(); }
        });
      }, { threshold: 0.4 });
    }

    workCardEls.forEach((card) => {
      const video = card.querySelector<HTMLVideoElement>('.work-card__video');
      const wrap  = card.closest<HTMLElement>('.work-card-wrap');
      const href  = wrap?.dataset.href;

      if (isTouch) {
        if (video) { video.preload = 'none'; mobileObserver?.observe(card); }
        if (href) {
          card.addEventListener('click', () => {
            import('astro:transitions/client').then(({ navigate }) => navigate(href));
          }, { signal });
        }
        return;
      }

      if (video) {
        video.addEventListener('loadeddata', () => {
          card.dataset.color = sampleColor(video);
        }, { once: true, signal });
      }

      card.addEventListener('mouseenter', () => {
        if (video) { video.muted = false; video.currentTime = 0; video.play(); }
        if (workBg) workBg.style.backgroundColor = card.dataset.color || workDefaultBg;
        if (cursorLabel) { cursorLabel.textContent = card.dataset.label || ''; cursorLabel.classList.add('is-visible'); }
      }, { signal });

      card.addEventListener('mousemove', (e) => {
        if (cursorLabel) { cursorLabel.style.left = `${e.clientX}px`; cursorLabel.style.top = `${e.clientY}px`; }
      }, { signal });

      card.addEventListener('mouseleave', () => {
        if (video) { video.muted = true; video.pause(); video.currentTime = 0; }
        if (workBg) workBg.style.backgroundColor = workDefaultBg;
        if (cursorLabel) cursorLabel.classList.remove('is-visible');
      }, { signal });

      if (href) {
        card.addEventListener('click', () => {
          import('astro:transitions/client').then(({ navigate }) => navigate(href));
        }, { signal });
        if (wrap) wrap.style.cursor = 'none';
      }
    });

    signal.addEventListener('abort', () => mobileObserver?.disconnect());
  }

  document.addEventListener('astro:page-load', () => {
    initWork();
    const ctaBtn = document.getElementById('work-cta-btn') as HTMLAnchorElement | null;
    if (ctaBtn) {
      ctaBtn.addEventListener('click', (e) => {
        e.preventDefault();
        import('astro:transitions/client').then(({ navigate }) => navigate('/contact'));
      });
    }
  });
</script>
